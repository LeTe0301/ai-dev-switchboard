{"ts": "2026-08-17T12:48:26Z", "agent": "claude", "seq": 36, "kind": "tool_result", "text": "diff --git a/backend/app/main.py b/backend/app/main.py\nindex 43bb78c..d4453aa 100644\n--- a/backend/app/main.py\n+++ b/backend/app/main.py\n@@ -2,7 +2,7 @@\n from fastapi import FastAPI, HTTPException\n from fastapi.middleware.cors import CORSMiddleware\n \n-from .models import ClearResult, PriorityIn, Task, TaskIn\n+from .models import ClearResult, DueDateIn, PriorityIn, Task, TaskIn\n from .store import store\n \n app = FastAPI(title=\"test-project\")\n@@ -26,7 +26,7 @@ def list_tasks() -> list[Task]:\n \n @app.post(\"/api/tasks\", response_model=Task, status_code=201)\n def create_task(payload: TaskIn) -> Task:\n-    return store.add(payload.title, payload.priority)\n+    return store.add(payload.title, payload.priority, payload.due_date)\n \n \n @app.post(\"/api/tasks/{task_id}/done\", response_model=Task)\n@@ -45,6 +45,14 @@ def update_priority(task_id: int, payload: PriorityIn) -> Task:\n     return task\n \n \n+@app.patch(\"/api/tasks/{task_id}/due-date\", response_model=Task)\n+def update_due_date(task_id: int, payload: DueDateIn) -> Task:\n+    task = store.set_due_date(task_id, payload.due_date)\n+    if task is None:\n+        raise HTTPException(status_code=404, detail=\"no such task\")\n+    return task\n+\n+\n @app.patch(\"/api/tasks/{task_id}\", response_model=Task)\n def update_task(task_id: int, payload: TaskIn) -> Task:\n     task = store.update_title(task_id, payload.title)\ndiff --git a/backend/app/models.py b/backend/app/models.py\nindex 88c9d1f..a512636 100644\n--- a/backend/app/models.py\n+++ b/backend/app/models.py\n@@ -1,4 +1,5 @@\n \"\"\"Wire shapes. Routes return these, never bare dicts.\"\"\"\n+from datetime import date\n from typing import Literal\n \n from pydantic import BaseModel, Field\n@@ -9,17 +10,23 @@ Priority = Literal[\"low\", \"normal\", \"high\"]\n class TaskIn(BaseModel):\n     title: str = Field(min_length=1, max_length=200)\n     priority: Priority = \"normal\"\n+    due_date: date | None = None\n \n \n class PriorityIn(BaseModel):\n     priority: Priority\n \n \n+class DueDateIn(BaseModel):\n+    due_date: date | None\n+\n+\n class Task(BaseModel):\n     id: int\n     title: str\n     done: bool = False\n     priority: Priority = \"normal\"\n+    due_date: date | None = None\n \n \n class ClearResult(BaseModel):\ndiff --git a/backend/app/store.py b/backend/app/store.py\nindex d11fc5e..c44e9da 100644\n--- a/backend/app/store.py\n+++ b/backend/app/store.py\n@@ -9,6 +9,7 @@ mutation -- the simplest thing that survives a restart, not a WAL.\n import json\n import logging\n import os\n+from datetime import date\n from pathlib import Path\n from typing import Optional\n \n@@ -43,7 +44,7 @@ class TaskStore:\n \n     def _save(self) -> None:\n         self._data_file.parent.mkdir(parents=True, exist_ok=True)\n-        payload = json.dumps([task.model_dump() for task in self.list()])\n+        payload = json.dumps([task.model_dump(mode=\"json\") for task in self.list()])\n         tmp_file = self._data_file.with_suffix(f\"{self._data_file.suffix}.tmp\")\n         tmp_file.write_text(payload)\n         os.replace(tmp_file, self._data_file)\n@@ -51,8 +52,8 @@ class TaskStore:\n     def list(self) -> list[Task]:\n         return [self._tasks[k] for k in sorted(self._tasks)]\n \n-    def add(self, title: str, priority: Priority = \"normal\") -> Task:\n-        task = Task(id=self._next_id, title=title, priority=priority)\n+    def add(self, title: str, priority: Priority = \"normal\", due_date: Optional[date] = None) -> Task:\n+        task = Task(id=self._next_id, title=title, priority=priority, due_date=due_date)\n         self._tasks[task.id] = task\n         self._next_id += 1\n         self._save()\n@@ -77,6 +78,14 @@ class TaskStore:\n         self._save()\n         return task\n \n+    def set_due_date(self, task_id: int, due_date: Optional[date]) -> Optional[Task]:\n+        task = self._tasks.get(task_id)\n+        if task is None:\n+            return None\n+        task.due_date = due_date\n+        self._save()\n+        return task\n+\n     def update_title(self, task_id: int, title: str) -> Optional[Task]:\n         task = self._tasks.get(task_id)\n         if task is None:", "meta": {"native_type": "user", "tool_use_id": "toolu_01P6UJ5SxxaBPsv9mkMPu3nx", "session_id": "7e8d71f9-876f-4f66-9eef-834cc1faa181"}}
