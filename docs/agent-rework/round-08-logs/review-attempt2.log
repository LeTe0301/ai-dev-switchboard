{"ts": "2026-08-17T12:48:29Z", "agent": "claude", "seq": 41, "kind": "tool_result", "text": "\"\"\"In-memory task store, backed by a JSON snapshot on disk.\n\nDeliberately not a database: this project exists to exercise a development\npipeline, and a real datastore would add setup cost to every cycle without\nadding anything to test. Adding one is a decision, not an implementation\ndetail. Disk persistence here is just a full-snapshot write on every\nmutation -- the simplest thing that survives a restart, not a WAL.\n\"\"\"\nimport json\nimport logging\nimport os\nfrom datetime import date\nfrom pathlib import Path\nfrom typing import Optional\n\nfrom .models import Priority, Task\n\nlogger = logging.getLogger(__name__)\n\nDEFAULT_DATA_FILE = Path(__file__).resolve().parent.parent / \"data\" / \"tasks.json\"\n\n\nclass TaskStore:\n    def __init__(self):\n        self._data_file = Path(os.environ.get(\"TASKS_DATA_FILE\", DEFAULT_DATA_FILE))\n        self._tasks: dict[int, Task] = {}\n        self._next_id = 1\n        self._load()\n\n    def _load(self) -> None:\n        try:\n            raw = json.loads(self._data_file.read_text())\n            tasks = [Task(**item) for item in raw]\n        except FileNotFoundError:\n            return\n        except Exception:\n            logger.warning(\n                \"Could not parse %s; starting with an empty task list.\",\n                self._data_file,\n            )\n            return\n        self._tasks = {task.id: task for task in tasks}\n        self._next_id = max(self._tasks, default=0) + 1\n\n    def _save(self) -> None:", "meta": {"native_type": "user", "tool_use_id": "toolu_01HEjc1uqTWWFcRaQn3dhpd1", "session_id": "7e8d71f9-876f-4f66-9eef-834cc1faa181"}}
