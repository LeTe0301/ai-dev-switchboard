{"ts": "2026-08-17T12:39:59Z", "agent": "claude", "seq": 38, "kind": "tool_result", "text": "1\tdef test_list_is_empty_initially(client):\n2\t    r = client.get(\"/api/tasks\")\n3\t    assert r.status_code == 200\n4\t    assert r.json() == []\n5\t\n6\t\n7\tdef test_create_returns_the_task(client):\n8\t    r = client.post(\"/api/tasks\", json={\"title\": \"write the thing\"})\n9\t    assert r.status_code == 201\n10\t    body = r.json()\n11\t    assert body[\"title\"] == \"write the thing\"\n12\t    assert body[\"done\"] is False\n13\t\n14\t\n15\tdef test_created_tasks_are_listed_in_id_order(client):\n16\t    for title in (\"one\", \"two\", \"three\"):\n17\t        client.post(\"/api/tasks\", json={\"title\": title})\n18\t    assert [t[\"title\"] for t in client.get(\"/api/tasks\").json()] == [\"one\", \"two\", \"three\"]\n19\t\n20\t\n21\tdef test_empty_title_is_rejected(client):\n22\t    assert client.post(\"/api/tasks\", json={\"title\": \"\"}).status_code == 422\n23\t\n24\t\n25\tdef test_completing_a_task_sets_done(client):\n26\t    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\"}).json()[\"id\"]\n27\t    assert client.post(f\"/api/tasks/{task_id}/done\").json()[\"done\"] is True\n28\t\n29\t\n30\tdef test_completing_a_missing_task_is_404(client):\n31\t    assert client.post(\"/api/tasks/999/done\").status_code == 404\n32\t\n33\t\n34\tdef test_delete_removes_it(client):\n35\t    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\"}).json()[\"id\"]\n36\t    assert client.delete(f\"/api/tasks/{task_id}\").status_code == 204\n37\t    assert client.get(\"/api/tasks\").json() == []\n38\t\n39\t\n40\tdef test_deleting_a_missing_task_is_404(client):\n41\t    assert client.delete(\"/api/tasks/999\").status_code == 404\n42\t\n43\t\n44\tdef test_updating_title_changes_it(client):\n45\t    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\"}).json()[\"id\"]\n46\t    r = client.patch(f\"/api/tasks/{task_id}\", json={\"title\": \"y\"})\n47\t    assert r.status_code == 200\n48\t    assert r.json()[\"title\"] == \"y\"\n49\t\n50\t\n51\tdef test_updating_title_does_not_change_done_or_id(client):\n52\t    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\"}).json()[\"id\"]\n53\t    client.post(f\"/api/tasks/{task_id}/done\")\n54\t    body = client.patch(f\"/api/tasks/{task_id}\", json={\"title\": \"y\"}).json()\n55\t    assert body[\"id\"] == task_id\n56\t    assert body[\"done\"] is True\n57\t\n58\t\n59\tdef test_updating_a_missing_task_is_404(client):\n60\t    assert client.patch(\"/api/tasks/999\", json={\"title\": \"y\"}).status_code == 404\n61\t\n62\t\n63\tdef test_updating_with_empty_title_is_rejected(client):\n64\t    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\"}).json()[\"id\"]\n65\t    r = client.patch(f\"/api/tasks/{task_id}\", json={\"title\": \"\"})\n66\t    assert r.status_code == 422\n67\t    assert client.get(\"/api/tasks\").json()[0][\"title\"] == \"x\"\n68\t\n69\t\n70\tdef test_updating_title_at_max_length_succeeds(client):\n71\t    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\"}).json()[\"id\"]\n72\t    title = \"a\" * 200\n73\t    r = client.patch(f\"/api/tasks/{task_id}\", json={\"title\": title})\n74\t    assert r.status_code == 200\n75\t    assert r.json()[\"title\"] == title\n76\t\n77\t\n78\tdef test_updating_title_beyond_max_length_is_rejected(client):\n79\t    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\"}).json()[\"id\"]\n80\t    r = client.patch(f\"/api/tasks/{task_id}\", json={\"title\": \"a\" * 201})\n81\t    assert r.status_code == 422\n82\t    assert client.get(\"/api/tasks\").json()[0][\"title\"] == \"x\"\n83\t\n84\t\n85\tdef test_create_defaults_to_normal_priority(client):\n86\t    r = client.post(\"/api/tasks\", json={\"title\": \"x\"})\n87\t    assert r.json()[\"priority\"] == \"normal\"\n88\t\n89\t\n90\tdef test_create_with_explicit_priority(client):\n91\t    r = client.post(\"/api/tasks\", json={\"title\": \"x\", \"priority\": \"high\"})\n92\t    assert r.status_code == 201\n93\t    assert r.json()[\"priority\"] == \"high\"\n94\t\n95\t\n96\tdef test_create_with_invalid_priority_is_rejected(client):\n97\t    r = client.post(\"/api/tasks\", json={\"title\": \"x\", \"priority\": \"urgent\"})\n98\t    assert r.status_code == 422\n99\t    assert client.get(\"/api/tasks\").json() == []\n100\t\n101\t\n102\tdef test_updating_priority_changes_it(client):\n103\t    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\"}).json()[\"id\"]\n104\t    r = client.patch(f\"/api/tasks/{task_id}/priority\", json={\"priority\": \"high\"})\n105\t    assert r.status_code == 200\n106\t    assert r.json()[\"priority\"] == \"high\"\n107\t\n108\t\n109\tdef test_updating_priority_does_not_change_title_id_or_done(client):\n110\t    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\"}).json()[\"id\"]\n111\t    client.post(f\"/api/tasks/{task_id}/done\")\n112\t    body = client.patch(f\"/api/tasks/{task_id}/priority\", json={\"priority\": \"low\"}).json()\n113\t    assert body[\"id\"] == task_id\n114\t    assert body[\"title\"] == \"x\"\n115\t    assert body[\"done\"] is True\n116\t\n117\t\n118\tdef test_updating_priority_of_a_missing_task_is_404(client):\n119\t    assert client.patch(\"/api/tasks/999/priority\", json={\"priority\": \"high\"}).status_code == 404\n120\t\n121\t\n122\tdef test_updating_priority_with_invalid_value_is_rejected(client):\n123\t    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\"}).json()[\"id\"]\n124\t    r = client.patch(f\"/api/tasks/{task_id}/priority\", json={\"priority\": \"urgent\"})\n125\t    assert r.status_code == 422\n126\t    assert client.get(\"/api/tasks\").json()[0][\"priority\"] == \"normal\"\n127\t\n128\t\n129\tdef test_updating_title_leaves_priority_untouched(client):\n130\t    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\", \"priority\": \"high\"}).json()[\"id\"]\n131\t    body = client.patch(f\"/api/tasks/{task_id}\", json={\"title\": \"y\"}).json()\n132\t    assert body[\"priority\"] == \"high\"\n133\t\n134\t\n135\tdef test_clear_completed_on_empty_store_returns_zero(client):\n136\t    r = client.delete(\"/api/tasks/completed\")\n137\t    assert r.status_code == 200\n138\t    assert r.json()[\"count\"] == 0\n139\t\n140\t\n141\tdef test_clear_completed_with_no_completed_tasks_removes_nothing(client):\n142\t    client.post(\"/api/tasks\", json={\"title\": \"x\"})\n143\t    r = client.delete(\"/api/tasks/completed\")\n144\t    assert r.json()[\"count\"] == 0\n145\t    assert len(client.get(\"/api/tasks\").json()) == 1\n146\t\n147\t\n148\tdef test_clear_completed_removes_only_done_tasks(client):\n149\t    open_id = client.post(\"/api/tasks\", json={\"title\": \"open\"}).json()[\"id\"]\n150\t    done_id = client.post(\"/api/tasks\", json={\"title\": \"done\"}).json()[\"id\"]\n151\t    client.post(f\"/api/tasks/{done_id}/done\")\n152\t\n153\t    r = client.delete(\"/api/tasks/completed\")\n154\t    assert r.status_code == 200\n155\t    assert r.json()[\"count\"] == 1\n156\t\n157\t    remaining = client.get(\"/api/tasks\").json()\n158\t    assert [t[\"id\"] for t in remaining] == [open_id]\n159\t    assert remaining[0][\"done\"] is False\n160\t\n161\t\n162\tdef test_clear_completed_leaves_no_done_tasks_in_list(client):\n163\t    for title in (\"a\", \"b\", \"c\"):\n164\t        task_id = client.post(\"/api/tasks\", json={\"title\": title}).json()[\"id\"]\n165\t        client.post(f\"/api/tasks/{task_id}/done\")\n166\t    client.post(\"/api/tasks\", json={\"title\": \"open\"})\n167\t\n168\t    client.delete(\"/api/tasks/completed\")\n169\t    assert all(not t[\"done\"] for t in client.get(\"/api/tasks\").json())\n170\t", "meta": {"native_type": "user", "tool_use_id": "toolu_01JTC5fefDfUsyBSVGurXMiQ", "session_id": "68bbec07-96f9-46a1-a6cf-f23842d6dfe3"}}
