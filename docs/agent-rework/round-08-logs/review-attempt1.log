ersistence.py\n@@ -1,4 +1,5 @@\n import json\n+from datetime import date\n \n from app.store import TaskStore\n \n@@ -8,7 +9,7 @@ def test_state_survives_a_simulated_restart(tmp_path, monkeypatch):\n     monkeypatch.setenv(\"TASKS_DATA_FILE\", str(data_file))\n \n     first = TaskStore()\n-    first.add(\"write the thing\", priority=\"high\")\n+    first.add(\"write the thing\", priority=\"high\", due_date=date(2026, 8, 20))\n     first.set_done(1, True)\n \n     second = TaskStore()\n@@ -18,6 +19,20 @@ def test_state_survives_a_simulated_restart(tmp_path, monkeypatch):\n     assert tasks[0].title == \"write the thing\"\n     assert tasks[0].done is True\n     assert tasks[0].priority == \"high\"\n+    assert tasks[0].due_date == date(2026, 8, 20)\n+\n+\n+def test_due_date_absent_survives_a_simulated_restart(tmp_path, monkeypatch):\n+    data_file = tmp_path / \"tasks.json\"\n+    monkeypatch.setenv(\"TASKS_DATA_FILE\", str(data_file))\n+\n+    first = TaskStore()\n+    first.add(\"no due date\")\n+\n+    second = TaskStore()\n+    tasks = second.list()\n+    assert len(tasks) == 1\n+    assert tasks[0].due_date is None\n \n \n def test_missing_file_starts_empty(tmp_path, monkeypatch):\ndiff --git a/backend/tests/test_tasks.py b/backend/tests/test_tasks.py\nindex 5cb4cc2..e386ae9 100644\n--- a/backend/tests/test_tasks.py\n+++ b/backend/tests/test_tasks.py\n@@ -159,6 +159,76 @@ def test_clear_completed_removes_only_done_tasks(client):\n     assert remaining[0][\"done\"] is False\n \n \n+def test_create_defaults_to_no_due_date(client):\n+    r = client.post(\"/api/tasks\", json={\"title\": \"x\"})\n+    assert r.json()[\"due_date\"] is None\n+\n+\n+def test_create_with_explicit_due_date(client):\n+    r = client.post(\"/api/tasks\", json={\"title\": \"x\", \"due_date\": \"2026-08-20\"})\n+    assert r.status_code == 201\n+    assert r.json()[\"due_date\"] == \"2026-08-20\"\n+\n+\n+def test_create_with_invalid_due_date_is_rejected(client):\n+    r = client.post(\"/api/tasks\", json={\"title\": \"x\", \"due_date\": \"not-a-date\"})\n+    assert r.status_code == 422\n+    assert client.get(\"/api/tasks\").json() == []\n+\n+\n+def test_updating_due_date_changes_it(client):\n+    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\"}).json()[\"id\"]\n+    r = client.patch(f\"/api/tasks/{task_id}/due-date\", json={\"due_date\": \"2026-08-20\"})\n+    assert r.status_code == 200\n+    assert r.json()[\"due_date\"] == \"2026-08-20\"\n+\n+\n+def test_clearing_an_existing_due_date(client):\n+    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\", \"due_date\": \"2026-08-20\"}).json()[\"id\"]\n+    r = client.patch(f\"/api/tasks/{task_id}/due-date\", json={\"due_date\": None})\n+    assert r.status_code == 200\n+    assert r.json()[\"due_date\"] is None\n+\n+\n+def test_updating_due_date_does_not_change_title_id_or_done(client):\n+    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\"}).json()[\"id\"]\n+    client.post(f\"/api/tasks/{task_id}/done\")\n+    body = client.patch(f\"/api/tasks/{task_id}/due-date\", json={\"due_date\": \"2026-08-20\"}).json()\n+    assert body[\"id\"] == task_id\n+    assert body[\"title\"] == \"x\"\n+    assert body[\"done\"] is True\n+\n+\n+def test_updating_due_date_of_a_missing_task_is_404(client):\n+    r = client.patch(\"/api/tasks/999/due-date\", json={\"due_date\": \"2026-08-20\"})\n+    assert r.status_code == 404\n+\n+\n+def test_updating_due_date_with_invalid_value_is_rejected(client):\n+    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\", \"due_date\": \"2026-08-20\"}).json()[\"id\"]\n+    r = client.patch(f\"/api/tasks/{task_id}/due-date\", json={\"due_date\": \"not-a-date\"})\n+    assert r.status_code == 422\n+    assert client.get(\"/api/tasks\").json()[0][\"due_date\"] == \"2026-08-20\"\n+\n+\n+def test_updating_title_leaves_due_date_untouched(client):\n+    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\", \"due_date\": \"2026-08-20\"}).json(