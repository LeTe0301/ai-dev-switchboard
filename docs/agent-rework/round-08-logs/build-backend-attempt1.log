{"ts": "2026-08-17T12:44:03Z", "agent": "claude", "seq": 22, "kind": "tool_result", "text": "1\t\"\"\"Wire shapes. Routes return these, never bare dicts.\"\"\"\n2\tfrom typing import Literal\n3\t\n4\tfrom pydantic import BaseModel, Field\n5\t\n6\tPriority = Literal[\"low\", \"normal\", \"high\"]\n7\t\n8\t\n9\tclass TaskIn(BaseModel):\n10\t    title: str = Field(min_length=1, max_length=200)\n11\t    priority: Priority = \"normal\"\n12\t\n13\t\n14\tclass PriorityIn(BaseModel):\n15\t    priority: Priority\n16\t\n17\t\n18\tclass Task(BaseModel):\n19\t    id: int\n20\t    title: str\n21\t    done: bool = False\n22\t    priority: Priority = \"normal\"\n23\t\n24\t\n25\tclass ClearResult(BaseModel):\n26\t    count: int\n27\t", "meta": {"native_type": "user", "tool_use_id": "toolu_018TvakKpyYAKdUiQHwfUhTS", "session_id": "042a6643-a2fe-4545-9f8c-0399575d03bd"}}
