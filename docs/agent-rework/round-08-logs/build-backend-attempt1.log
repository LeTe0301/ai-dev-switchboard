{"ts": "2026-08-17T12:44:04Z", "agent": "claude", "seq": 26, "kind": "tool_result", "text": "1\t\"\"\"In-memory task store, backed by a JSON snapshot on disk.\n2\t\n3\tDeliberately not a database: this project exists to exercise a development\n4\tpipeline, and a real datastore would add setup cost to every cycle without\n5\tadding anything to test. Adding one is a decision, not an implementation\n6\tdetail. Disk persistence here is just a full-snapshot write on every\n7\tmutation -- the simplest thing that survives a restart, not a WAL.\n8\t\"\"\"\n9\timport json\n10\timport logging\n11\timport os\n12\tfrom pathlib import Path\n13\tfrom typing import Optional\n14\t\n15\tfrom .models import Priority, Task\n16\t\n17\tlogger = logging.getLogger(__name__)\n18\t\n19\tDEFAULT_DATA_FILE = Path(__file__).resolve().parent.parent / \"data\" / \"tasks.json\"\n20\t\n21\t\n22\tclass TaskStore:\n23\t    def __init__(self):\n24\t        self._data_file = Path(os.environ.get(\"TASKS_DATA_FILE\", DEFAULT_DATA_FILE))\n25\t        self._tasks: dict[int, Task] = {}\n26\t        self._next_id = 1\n27\t        self._load()\n28\t\n29\t    def _load(self) -> None:\n30\t        try:\n31\t            raw = json.loads(self._data_file.read_text())\n32\t            tasks = [Task(**item) for item in raw]\n33\t        except FileNotFoundError:\n34\t            return\n35\t        except Exception:\n36\t            logger.warning(\n37\t                \"Could not parse %s; starting with an empty task list.\",\n38\t                self._data_file,\n39\t            )\n40\t            return\n41\t        self._tasks = {task.id: task for task in tasks}\n42\t        self._next_id = max(self._tasks, default=0) + 1\n43\t\n44\t    def _save(self) -> None:\n45\t        self._data_file.parent.mkdir(parents=True, exist_ok=True)\n46\t        payload = json.dumps([task.model_dump() for task in self.list()])\n47\t        tmp_file = self._data_file.with_suffix(f\"{self._data_file.suffix}.tmp\")\n48\t        tmp_file.write_text(payload)\n49\t        os.replace(tmp_file, self._data_file)\n50\t\n51\t    def list(self) -> list[Task]:\n52\t        return [self._tasks[k] for k in sorted(self._tasks)]\n53\t\n54\t    def add(self, title: str, priority: Priority = \"normal\") -> Task:\n55\t        task = Task(id=self._next_id, title=title, priority=priority)\n56\t        self._tasks[task.id] = task\n57\t        self._next_id += 1\n58\t        self._save()\n59\t        return task\n60\t\n61\t    def get(self, task_id: int) -> Optional[Task]:\n62\t        return self._tasks.get(task_id)\n63\t\n64\t    def set_done(self, task_id: int, done: bool) -> Optional[Task]:\n65\t        task = self._tasks.get(task_id)\n66\t        if task is None:\n67\t            return None\n68\t        task.done = done\n69\t        self._save()\n70\t        return task\n71\t\n72\t    def set_priority(self, task_id: int, priority: Priority) -> Optional[Task]:\n73\t        task = self._tasks.get(task_id)\n74\t        if task is None:\n75\t            return None\n76\t        task.priority = priority\n77\t        self._save()\n78\t        return task\n79\t\n80\t    def update_title(self, task_id: int, title: str) -> Optional[Task]:\n81\t        task = self._tasks.get(task_id)\n82\t        if task is None:\n83\t            return None\n84\t        task.title = title\n85\t        self._save()\n86\t        return task\n87\t\n88\t    def delete(self, task_id: int) -> bool:\n89\t        found = self._tasks.pop(task_id, None) is not None\n90\t        if found:\n91\t            self._save()\n92\t        return found\n93\t\n94\t    def clear_completed(self) -> int:\n95\t        done_ids = [task_id for task_id, task in self._tasks.items() if task.done]\n96\t        for task_id in done_ids:\n97\t            del self._tasks[task_id]\n98\t        if done_ids:\n99\t            self._save()\n100\t        return len(done_ids)\n101\t\n102\t    def reset(self) -> None:\n103\t        self._tasks.clear()\n104\t        self._next_id = 1\n105\t        self._save()\n106\t\n107\t\n108\tstore = TaskStore()\n109\t", "meta": {"native_type": "user", "tool_use_id": "toolu_019oUMmro5VPjhJ6dNq5crnL", "session_id": "042a6643-a2fe-4545-9f8c-0399575d03bd"}}
