{"ts": "2026-08-17T12:44:36Z", "agent": "claude", "seq": 55, "kind": "tool_use", "text": "Edit", "meta": {"native_type": "assistant", "block_type": "tool_use", "tool_use_id": "toolu_01M2VkvEqnugXBCrxFAGdTbt", "input": {"replace_all": false, "file_path": "/home/dev/projects/test-project/backend/tests/test_tasks.py", "old_string": "def test_clear_completed_leaves_no_done_tasks_in_list(client):", "new_string": "def test_create_defaults_to_no_due_date(client):\n    r = client.post(\"/api/tasks\", json={\"title\": \"x\"})\n    assert r.json()[\"due_date\"] is None\n\n\ndef test_create_with_explicit_due_date(client):\n    r = client.post(\"/api/tasks\", json={\"title\": \"x\", \"due_date\": \"2026-08-20\"})\n    assert r.status_code == 201\n    assert r.json()[\"due_date\"] == \"2026-08-20\"\n\n\ndef test_create_with_invalid_due_date_is_rejected(client):\n    r = client.post(\"/api/tasks\", json={\"title\": \"x\", \"due_date\": \"not-a-date\"})\n    assert r.status_code == 422\n    assert client.get(\"/api/tasks\").json() == []\n\n\ndef test_updating_due_date_changes_it(client):\n    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\"}).json()[\"id\"]\n    r = client.patch(f\"/api/tasks/{task_id}/due-date\", json={\"due_date\": \"2026-08-20\"})\n    assert r.status_code == 200\n    assert r.json()[\"due_date\"] == \"2026-08-20\"\n\n\ndef test_clearing_an_existing_due_date(client):\n    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\", \"due_date\": \"2026-08-20\"}).json()[\"id\"]\n    r = client.patch(f\"/api/tasks/{task_id}/due-date\", json={\"due_date\": None})\n    assert r.status_code == 200\n    assert r.json()[\"due_date\"] is None\n\n\ndef test_updating_due_date_does_not_change_title_id_or_done(client):\n    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\"}).json()[\"id\"]\n    client.post(f\"/api/tasks/{task_id}/done\")\n    body = client.patch(f\"/api/tasks/{task_id}/due-date\", json={\"due_date\": \"2026-08-20\"}).json()\n    assert body[\"id\"] == task_id\n    assert body[\"title\"] == \"x\"\n    assert body[\"done\"] is True\n\n\ndef test_updating_due_date_of_a_missing_task_is_404(client):\n    r = client.patch(\"/api/tasks/999/due-date\", json={\"due_date\": \"2026-08-20\"})\n    assert r.status_code == 404\n\n\ndef test_updating_due_date_with_invalid_value_is_rejected(client):\n    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\", \"due_date\": \"2026-08-20\"}).json()[\"id\"]\n    r = client.patch(f\"/api/tasks/{task_id}/due-date\", json={\"due_date\": \"not-a-date\"})\n    assert r.status_code == 422\n    assert client.get(\"/api/tasks\").json()[0][\"due_date\"] == \"2026-08-20\"\n\n\ndef test_updating_title_leaves_due_date_untouched(client):\n    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\", \"due_date\": \"2026-08-20\"}).json()[\"id\"]\n    body = client.patch(f\"/api/tasks/{task_id}\", json={\"title\": \"y\"}).json()\n    assert body[\"due_date\"] == \"2026-08-20\"\n\n\ndef test_updating_priority_leaves_due_date_untouched(client):\n    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\", \"due_date\": \"2026-08-20\"}).json()[\"id\"]\n    body = client.patch(f\"/api/tasks/{task_id}/priority\", json={\"priority\": \"high\"}).json()\n    assert body[\"due_date\"] == \"2026-08-20\"\n\n\ndef test_updating_due_date_leaves_priority_untouched(client):\n    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\", \"priority\": \"high\"}).json()[\"id\"]\n    body = client.patch(f\"/api/tasks/{task_id}/due-date\", json={\"due_date\": \"2026-08-20\"}).json()\n    assert body[\"priority\"] == \"high\"\n\n\ndef test_clear_completed_leaves_no_done_tasks_in_list(client):"}, "session_id": "042a6643-a2fe-4545-9f8c-0399575d03bd"}}
