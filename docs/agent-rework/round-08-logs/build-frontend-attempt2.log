{"ts": "2026-08-17T12:47:20Z", "agent": "claude", "seq": 12, "kind": "tool_result", "text": "1\t\"\"\"In-memory task store, backed by a JSON snapshot on disk.\n2\t\n3\tDeliberately not a database: this project exists to exercise a development\n4\tpipeline, and a real datastore would add setup cost to every cycle without\n5\tadding anything to test. Adding one is a decision, not an implementation\n6\tdetail. Disk persistence here is just a full-snapshot write on every\n7\tmutation -- the simplest thing that survives a restart, not a WAL.\n8\t\"\"\"\n9\timport json\n10\timport logging\n11\timport os\n12\tfrom datetime import date\n13\tfrom pathlib import Path\n14\tfrom typing import Optional\n15\t\n16\tfrom .models import Priority, Task\n17\t\n18\tlogger = logging.getLogger(__name__)\n19\t\n20\tDEFAULT_DATA_FILE = Path(__file__).resolve().parent.parent / \"data\" / \"tasks.json\"\n21\t\n22\t\n23\tclass TaskStore:\n24\t    def __init__(self):\n25\t        self._data_file = Path(os.environ.get(\"TASKS_DATA_FILE\", DEFAULT_DATA_FILE))\n26\t        self._tasks: dict[int, Task] = {}\n27\t        self._next_id = 1\n28\t        self._load()\n29\t\n30\t    def _load(self) -> None:\n31\t        try:\n32\t            raw = json.loads(self._data_file.read_text())\n33\t            tasks = [Task(**item) for item in raw]\n34\t        except FileNotFoundError:\n35\t            return\n36\t        except Exception:\n37\t            logger.warning(\n38\t                \"Could not parse %s; starting with an empty task list.\",\n39\t                self._data_file,\n40\t            )\n41\t            return\n42\t        self._tasks = {task.id: task for task in tasks}\n43\t        self._next_id = max(self._tasks, default=0) + 1\n44\t\n45\t    def _save(self) -> None:\n46\t        self._data_file.parent.mkdir(parents=True, exist_ok=True)\n47\t        payload = json.dumps([task.model_dump() for task in self.list()])\n48\t        tmp_file = self._data_file.with_suffix(f\"{self._data_file.suffix}.tmp\")\n49\t        tmp_file.write_text(payload)\n50\t        os.replace(tmp_file, self._data_file)\n51\t\n52\t    def list(self) -> list[Task]:\n53\t        return [self._tasks[k] for k in sorted(self._tasks)]\n54\t\n55\t    def add(self, title: str, priority: Priority = \"normal\", due_date: Optional[date] = None) -> Task:\n56\t        task = Task(id=self._next_id, title=title, priority=priority, due_date=due_date)\n57\t        self._tasks[task.id] = task\n58\t        self._next_id += 1\n59\t        self._save()\n60\t        return task\n61\t\n62\t    def get(self, task_id: int) -> Optional[Task]:\n63\t        return self._tasks.get(task_id)\n64\t\n65\t    def set_done(self, task_id: int, done: bool) -> Optional[Task]:\n66\t        task = self._tasks.get(task_id)\n67\t        if task is None:\n68\t            return None\n69\t        task.done = done\n70\t        self._save()\n71\t        return task\n72\t\n73\t    def set_priority(self, task_id: int, priority: Priority) -> Optional[Task]:\n74\t        task = self._tasks.get(task_id)\n75\t        if task is None:\n76\t            return None\n77\t        task.priority = priority\n78\t        self._save()\n79\t        return task\n80\t\n81\t    def set_due_date(self, task_id: int, due_date: Optional[date]) -> Optional[Task]:\n82\t        task = self._tasks.get(task_id)\n83\t        if task is None:\n84\t            return None\n85\t        task.due_date = due_date\n86\t        self._save()\n87\t        return task\n88\t\n89\t    def update_title(self, task_id: int, title: str) -> Optional[Task]:\n90\t        task = self._tasks.get(task_id)\n91\t        if task is None:\n92\t            return None\n93\t        task.title = title\n94\t        self._save()\n95\t        return task\n96\t\n97\t    def delete(self, task_id: int) -> bool:\n98\t        found = self._tasks.pop(task_id, None) is not None\n99\t        if found:\n100\t            self._save()\n101\t        return found\n102\t\n103\t    def clear_completed(self) -> int:\n104\t        done_ids = [task_id for task_id, task in self._tasks.items() if task.done]\n105\t        for task_id in done_ids:\n106\t            del self._tasks[task_id]\n107\t        if done_ids:\n108\t            self._save()\n109\t        return len(done_ids)\n110\t\n111\t    def reset(self) -> None:\n112\t        self._tasks.clear()\n113\t        self._next_id = 1\n114\t        self._save()\n115\t\n116\t\n117\tstore = TaskStore()\n118\t", "meta": {"native_type": "user", "tool_use_id": "toolu_01NjcfGXbsko5j5Lsm7zZgWZ", "session_id": "fa7bb6d7-15ee-47f6-8a0d-73c2ccc7edd8"}}
