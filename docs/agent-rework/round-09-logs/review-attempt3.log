{"ts": "2026-08-17T13:15:01Z", "agent": "claude", "seq": 138, "kind": "tool_result", "text": "1\timport { useEffect, useState } from 'react'\n2\timport AddTask from './components/AddTask'\n3\timport ClearCompleted from './components/ClearCompleted'\n4\timport SearchTasks from './components/SearchTasks'\n5\timport TaskCounts from './components/TaskCounts'\n6\timport TaskFilter from './components/TaskFilter'\n7\timport TaskList from './components/TaskList'\n8\timport UndoToast from './components/UndoToast'\n9\timport * as api from './api'\n10\timport './App.css'\n11\t\n12\tconst UNDO_WINDOW_MS = 5000\n13\t\n14\texport default function App() {\n15\t  const [tasks, setTasks] = useState([])\n16\t  const [error, setError] = useState(null)\n17\t  const [loading, setLoading] = useState(true)\n18\t  const [filter, setFilter] = useState('all')\n19\t  const [search, setSearch] = useState('')\n20\t  // Single source of truth: id -> pending delete's timer handle. Map\n21\t  // insertion order gives the toast its oldest-first stacking order; the\n22\t  // `.filter(Boolean)` below guards a task that vanished from `tasks` some\n23\t  // other way (e.g. Clear completed racing the undo window).\n24\t  const [pendingDeletes, setPendingDeletes] = useState(new Map())\n25\t\n26\t  async function refresh() {\n27\t    try {\n28\t      setTasks(await api.listTasks())\n29\t      setError(null)\n30\t    } catch (e) {\n31\t      setError(e.message)\n32\t    } finally {\n33\t      setLoading(false)\n34\t    }\n35\t  }\n36\t\n37\t  useEffect(() => { refresh() }, [])\n38\t\n39\t  const activeTasks = tasks.filter((t) => !pendingDeletes.has(t.id))\n40\t", "meta": {"native_type": "user", "tool_use_id": "toolu_01W7AtpsW1tiyAtxgjgnFp5b", "session_id": "efe54001-69c6-45a9-9728-9e9432a09ec4"}}
