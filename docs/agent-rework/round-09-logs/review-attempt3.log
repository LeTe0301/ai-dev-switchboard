s.filter((t) => !t.done).length\n \n   async function run(fn) {\n     try {\n@@ -57,6 +67,45 @@ export default function App() {\n     }\n   }\n \n+  // Delete is deferred rather than immediate: the row hides now, but the\n+  // DELETE request only fires once the undo window lapses with no undo.\n+  // The task is never mutated in `tasks` during the window, so undoing it\n+  // just un-hides the row -- \"exactly as it was\" needs no reconstruction.\n+  function deferDelete(id) {\n+    const timer = setTimeout(async () => {\n+      try {\n+        await api.deleteTask(id)\n+        await refresh()\n+      } catch (e) {\n+        // \"no such task\" is the 404 detail main.py sends when the task was\n+        // already removed some other way (e.g. Clear completed) during the\n+        // window -- that case is expected and silent, per the spec. Any\n+        // other failure still surfaces through the usual error banner.\n+        if (e.message !== 'no such task') setError(e.message)\n+      } finally {\n+        // Only release the pending-delete slot once the attempt has settled,\n+        // so the task can't flash back into the list while the request (or\n+        // the refresh() it triggers) is still in flight.\n+        setPendingDeletes((prev) => {\n+          const next = new Map(prev)\n+          next.delete(id)\n+          return next\n+        })\n+      }\n+    }, UNDO_WINDOW_MS)\n+    setPendingDeletes((prev) => new Map(prev).set(id, timer))\n+  }\n+\n+  function cancelPendingDelete(id) {\n+    const timer = pendingDeletes.get(id)\n+    if (timer !== undefined) clearTimeout(timer)\n+    setPendingDeletes((prev) => {\n+      const next = new Map(prev)\n+      next.delete(id)\n+      return next\n+    })\n+  }\n+\n   return (\n     <main className=\"app\">\n       <h1>Tasks</h1>\n@@ -79,12 +128,19 @@ export default function App() {\n           search={search}\n           hasFilterResults={stateFiltered.length > 0}\n           onComplete={(id) => run(() => api.completeTask(id))}\n-          onDelete={(id) => run(() => api.deleteTask(id))}\n+          onDelete={deferDelete}\n           onUpdate={(id, title) => run(() => api.updateTask(id, title))}\n           onPriorityChange={(id, priority) => run(() => api.setPriority(id, priority))}\n           onDueDateChange={(id, dueDate) => run(() => api.setDueDate(id, dueDate))}\n         />\n       )}\n+      <UndoToast\n+        pending={[...pendingDeletes.keys()]\n+          .map((id) => tasks.find((t) => t.id === id))\n+          .filter(Boolean)}\n+        onUndo={cancelPendingDelete}\n+        windowMs={UNDO_WINDOW_MS}\n+      />\n     </main>\n   )\n }", "meta": {"native_type": "user", "tool_use_id": "toolu_01XDnkpDZGtHdjJAnUDM59ci", "session_id": "efe54001-69c6-45a9-9728-9e9432a09ec4"}}
