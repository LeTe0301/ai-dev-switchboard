{"ts": "2026-08-17T13:15:32Z", "agent": "claude", "seq": 163, "kind": "tool_result", "text": "128\t          search={search}\n129\t          hasFilterResults={stateFiltered.length > 0}\n130\t          onComplete={(id) => run(() => api.completeTask(id))}\n131\t          onDelete={deferDelete}\n132\t          onUpdate={(id, title) => run(() => api.updateTask(id, title))}\n133\t          onPriorityChange={(id, priority) => run(() => api.setPriority(id, priority))}\n134\t          onDueDateChange={(id, dueDate) => run(() => api.setDueDate(id, dueDate))}\n135\t        />\n136\t      )}\n137\t      <UndoToast\n138\t        pending={[...pendingDeletes.keys()]\n139\t          .map((id) => tasks.find((t) => t.id === id))\n140\t          .filter(Boolean)}\n141\t        onUndo={cancelPendingDelete}\n142\t        windowMs={UNDO_WINDOW_MS}\n143\t      />\n144\t    </main>\n145\t  )\n146\t}\n147\t", "meta": {"native_type": "user", "tool_use_id": "toolu_01TFaWbYXHShA8dCL7Dj8Gx4", "session_id": "efe54001-69c6-45a9-9728-9e9432a09ec4"}}
