{"ts": "2026-08-17T12:54:41Z", "agent": "claude", "seq": 25, "kind": "tool_result", "text": "1\t\"\"\"Wire shapes. Routes return these, never bare dicts.\"\"\"\n2\tfrom datetime import date\n3\tfrom typing import Literal\n4\t\n5\tfrom pydantic import BaseModel, Field\n6\t\n7\tPriority = Literal[\"low\", \"normal\", \"high\"]\n8\t\n9\t\n10\tclass TaskIn(BaseModel):\n11\t    title: str = Field(min_length=1, max_length=200)\n12\t    priority: Priority = \"normal\"\n13\t    due_date: date | None = None\n14\t\n15\t\n16\tclass PriorityIn(BaseModel):\n17\t    priority: Priority\n18\t\n19\t\n20\tclass DueDateIn(BaseModel):\n21\t    due_date: date | None\n22\t\n23\t\n24\tclass Task(BaseModel):\n25\t    id: int\n26\t    title: str\n27\t    done: bool = False\n28\t    priority: Priority = \"normal\"\n29\t    due_date: date | None = None\n30\t\n31\t\n32\tclass ClearResult(BaseModel):\n33\t    count: int\n34\t", "meta": {"native_type": "user", "tool_use_id": "toolu_019xynZFVUZxmPcyj16ZF6cR", "session_id": "5664dabf-122c-4fdb-aaf7-26ca2b27fb0a"}}
