{"ts": "2026-08-17T13:00:35Z", "agent": "claude", "seq": 55, "kind": "tool_result", "text": "\"\"\"Route wiring only -- behaviour lives in store.py.\"\"\"\nfrom fastapi import FastAPI, HTTPException\nfrom fastapi.middleware.cors import CORSMiddleware\n\nfrom .models import ClearResult, DueDateIn, PriorityIn, Task, TaskIn\nfrom .store import store\n\napp = FastAPI(title=\"test-project\")\n\n# A regex, not a fixed list: the dev server is reached as both localhost and\n# 127.0.0.1, and the e2e harness binds it to a free port rather than 5173, so\n# a hardcoded origin silently blocks every write from the browser while GETs\n# keep working -- which reads as \"adding a task does nothing\".\napp.add_middleware(\n    CORSMiddleware,\n    allow_origin_regex=r\"http://(localhost|127\\.0\\.0\\.1):\\d+\",\n    allow_methods=[\"*\"],\n    allow_headers=[\"*\"],\n)\n\n\n@app.get(\"/api/tasks\", response_model=list[Task])\ndef list_tasks() -> list[Task]:\n    return store.list()\n\n\n@app.post(\"/api/tasks\", response_model=Task, status_code=201)\ndef create_task(payload: TaskIn) -> Task:\n    return store.add(payload.title, payload.priority, payload.due_date)\n\n\n@app.post(\"/api/tasks/{task_id}/done\", response_model=Task)\ndef complete_task(task_id: int) -> Task:\n    task = store.set_done(task_id, True)\n    if task is None:\n        raise HTTPException(status_code=404, detail=\"no such task\")\n    return task\n\n\n@app.patch(\"/api/tasks/{task_id}/priority\", response_model=Task)\ndef update_priority(task_id: int, payload: PriorityIn) -> Task:\n    task = store.set_priority(task_id, payload.priority)\n    if task is None:\n        raise HTTPException(status_code=404, detail=\"no such task\")\n    return task\n\n\n@app.patch(\"/api/tasks/{task_id}/due-date\", response_model=Task)\ndef update_due_date(task_id: int, payload: DueDateIn) -> Task:\n    task = store.set_due_date(task_id, payload.due_date)\n    if task is None:\n        raise HTTPException(status_code=404, detail=\"no such task\")\n    return task\n\n\n@app.patch(\"/api/tasks/{task_id}\", response_model=Task)\ndef update_task(task_id: int, payload: TaskIn) -> Task:\n    task = store.update_title(task_id, payload.title)\n    if task is None:\n        raise HTTPException(status_code=404, detail=\"no such task\")\n    return task\n\n\n@app.delete(\"/api/tasks/completed\", response_model=ClearResult)\ndef clear_completed() -> ClearResult:\n    return ClearResult(count=store.clear_completed())\n\n\n@app.delete(\"/api/tasks/{task_id}\", status_code=204)\ndef delete_task(task_id: int) -> None:\n    if not store.delete(task_id):\n        raise HTTPException(status_code=404, detail=\"no such task\")", "meta": {"native_type": "user", "tool_use_id": "toolu_01Xbc2bJVxrVYLcSbDEUBZoB", "session_id": "cba4f96e-4ebd-4386-a0d1-a0618664837e"}}
