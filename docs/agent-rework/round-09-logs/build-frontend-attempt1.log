{"ts": "2026-08-17T13:00:09Z", "agent": "claude", "seq": 22, "kind": "tool_result", "text": "1\timport { useState } from 'react'\n2\t\n3\tconst EMPTY_COPY = {\n4\t  all: 'Nothing to do yet.',\n5\t  open: 'Nothing open right now.',\n6\t  done: 'Nothing done yet.',\n7\t}\n8\t\n9\tconst PRIORITIES = [\n10\t  { value: 'low', label: 'Low' },\n11\t  { value: 'normal', label: 'Normal' },\n12\t  { value: 'high', label: 'High' },\n13\t]\n14\t\n15\tconst todayISO = () => new Date().toLocaleDateString('en-CA') // YYYY-MM-DD, local time\n16\tconst isOverdue = (task) => !task.done && task.due_date != null && task.due_date < todayISO()\n17\t\n18\texport default function TaskList({ tasks, filter, search, hasFilterResults, onComplete, onDelete, onUpdate, onPriorityChange, onDueDateChange }) {\n19\t  if (tasks.length === 0) {\n20\t    const trimmedSearch = search?.trim()\n21\t    const message = hasFilterResults && trimmedSearch\n22\t      ? `No tasks match \"${trimmedSearch}\".`\n23\t      : EMPTY_COPY[filter]\n24\t    return <p className=\"empty\" aria-live=\"polite\">{message}</p>\n25\t  }\n26\t  return (\n27\t    <ul className=\"task-list\">\n28\t      {tasks.map((task) => (\n29\t        <TaskRow\n30\t          key={task.id}\n31\t          task={task}\n32\t          onComplete={onComplete}\n33\t          onDelete={onDelete}\n34\t          onUpdate={onUpdate}\n35\t          onPriorityChange={onPriorityChange}\n36\t          onDueDateChange={onDueDateChange}\n37\t        />\n38\t      ))}\n39\t    </ul>\n40\t  )\n41\t}\n42\t\n43\tfunction TaskRow({ task, onComplete, onDelete, onUpdate, onPriorityChange, onDueDateChange }) {\n44\t  const [isEditing, setIsEditing] = useState(false)\n45\t  const [draft, setDraft] = useState(task.title)\n46\t  const [showError, setShowError] = useState(false)\n47\t\n48\t  function startEdit() {\n49\t    setDraft(task.title)\n50\t    setShowError(false)\n51\t    setIsEditing(true)\n52\t  }\n53\t\n54\t  function cancel() {\n55\t    setDraft(task.title)\n56\t    setShowError(false)\n57\t    setIsEditing(false)\n58\t  }\n59\t\n60\t  async function submit(e) {\n61\t    e.preventDefault()\n62\t    const trimmed = draft.trim()\n63\t    if (!trimmed) {\n64\t      setShowError(true)\n65\t      return\n66\t    }\n67\t    const ok = await onUpdate(task.id, trimmed)\n68\t    if (ok) setIsEditing(false)\n69\t  }\n70\t\n71\t  if (isEditing) {\n72\t    return (\n73\t      <li className={task.done ? 'task done' : 'task'}>\n74\t        <form\n75\t          className=\"task-edit\"\n76\t          onSubmit={submit}\n77\t          onKeyDown={(e) => {\n78\t            if (e.key === 'Escape') cancel()\n79\t            // A disabled Save button blocks the browser's native implicit\n80\t            // submit-on-Enter, so an empty draft would never reach submit()\n81\t            // to show the error. Handling Enter here bypasses that.\n82\t            if (e.key === 'Enter') { e.preventDefault(); submit(e) }\n83\t          }}\n84\t        >\n85\t          <input\n86\t            className=\"task-title-input\"\n87\t            value={draft}\n88\t            onChange={(e) => { setDraft(e.target.value); setShowError(false) }}\n89\t            aria-label={`Title for ${task.title}`}\n90\t            autoFocus\n91\t            onFocus={(e) => e.target.select()}\n92\t          />\n93\t          <button type=\"submit\" disabled={!draft.trim()}>Save</button>\n94\t          <button type=\"button\" onClick={cancel}>Cancel</button>\n95\t        </form>\n96\t        {showError && <p className=\"field-error\" role=\"alert\">Title can't be empty</p>}\n97\t      </li>\n98\t    )\n99\t  }\n100\t\n101\t  return (\n102\t    <li className={task.done ? 'task done' : 'task'}>\n103\t      <span className=\"task-title\">{task.title}</span>\n104\t      <select\n105\t        className={`priority-select priority-${task.priority}`}\n106\t        value={task.priority}\n107\t        onChange={(e) => onPriorityChange(task.id, e.target.value)}\n108\t        aria-label={`Priority for ${task.title}`}\n109\t      >\n110\t        {PRIORITIES.map((p) => <option key={p.value} value={p.value}>{p.label}</option>)}\n111\t      </select>\n112\t      <input\n113\t        type=\"date\"\n114\t        className=\"due-date-input\"\n115\t        value={task.due_date || ''}\n116\t        onChange={(e) => onDueDateChange(task.id, e.target.value || null)}\n117\t        aria-label={`Due date for ${task.title}`}\n118\t      />\n119\t      {task.due_date && (\n120\t        <button\n121\t          type=\"button\"\n122\t          className=\"due-date-clear\"\n123\t          onClick={() => onDueDateChange(task.id, null)}\n124\t          aria-label={`Clear due date for ${task.title}`}\n125\t        >\n126\t          \u00d7\n127\t        </button>\n128\t      )}\n129\t      {isOverdue(task) && (\n130\t        <span className=\"overdue-badge\" role=\"status\">\n131\t          <span aria-hidden=\"true\">\u26a0</span> Overdue\n132\t        </span>\n133\t      )}\n134\t      <button onClick={startEdit} aria-label={`Edit ${task.title}`}>Edit</button>\n135\t      {!task.done && (\n136\t        <button onClick={() => onComplete(task.id)} aria-label={`Complete ${task.title}`}>\n137\t          Done\n138\t        </button>\n139\t      )}\n140\t      <button onClick={() => onDelete(task.id)} aria-label={`Delete ${task.title}`}>\n141\t        Delete\n142\t      </button>\n143\t    </li>\n144\t  )\n145\t}\n146\t", "meta": {"native_type": "user", "tool_use_id": "toolu_01JQoiN8Sveg9z9FLWPApMW7", "session_id": "cba4f96e-4ebd-4386-a0d1-a0618664837e"}}
