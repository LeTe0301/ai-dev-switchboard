{"ts": "2026-08-17T13:05:47Z", "agent": "claude", "seq": 19, "kind": "tool_result", "text": "1\texport default function UndoToast({ pending, onUndo, windowMs }) {\n2\t  if (pending.length === 0) return null\n3\t  return (\n4\t    <div className=\"undo-toast-list\" role=\"status\">\n5\t      {pending.map((task) => (\n6\t        <div className=\"undo-toast\" key={task.id}>\n7\t          <div className=\"undo-toast-row\">\n8\t            <span className=\"undo-toast-title\" title={task.title}>\n9\t              \"{task.title}\" deleted\n10\t            </span>\n11\t            <button\n12\t              type=\"button\"\n13\t              onClick={() => onUndo(task.id)}\n14\t              aria-label={`Undo delete of ${task.title}`}\n15\t            >\n16\t              Undo\n17\t            </button>\n18\t          </div>\n19\t          <div className=\"undo-toast-track\" aria-hidden=\"true\">\n20\t            <div\n21\t              className=\"undo-toast-fill\"\n22\t              style={{ animationDuration: `${windowMs}ms` }}\n23\t            />\n24\t          </div>\n25\t        </div>\n26\t      ))}\n27\t    </div>\n28\t  )\n29\t}\n30\t", "meta": {"native_type": "user", "tool_use_id": "toolu_01KM4GuUfH7FsAYUzMjzR53E", "session_id": "54aa24cf-1f06-4523-975a-4e66b25f56e3"}}
