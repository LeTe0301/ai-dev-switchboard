done).length\n+  const openCount = activeTasks.filter((t) => !t.done).length\n \n   async function run(fn) {\n     try {\n@@ -57,6 +68,40 @@ export default function App() {\n     }\n   }\n \n+  // Delete is deferred rather than immediate: the row hides now, but the\n+  // DELETE request only fires once the undo window lapses with no undo.\n+  // The task is never mutated in `tasks` during the window, so undoing it\n+  // just un-hides the row -- \"exactly as it was\" needs no reconstruction.\n+  function deferDelete(id) {\n+    const timer = setTimeout(async () => {\n+      setPendingDeletes((prev) => {\n+        const next = new Map(prev)\n+        next.delete(id)\n+        return next\n+      })\n+      try {\n+        await api.deleteTask(id)\n+        await refresh()\n+      } catch (e) {\n+        // \"no such task\" is the 404 detail main.py sends when the task was\n+        // already removed some other way (e.g. Clear completed) during the\n+        // window -- that case is expected and silent, per the spec. Any\n+        // other failure still surfaces through the usual error banner.\n+        if (e.message !== 'no such task') setError(e.message)\n+      }\n+    }, UNDO_WINDOW_MS)\n+    setPendingDeletes((prev) => new Map(prev).set(id, timer))\n+  }\n+\n+  function cancelPendingDelete(id) {\n+    setPendingDeletes((prev) => {\n+      clearTimeout(prev.get(id))\n+      const next = new Map(prev)\n+      next.delete(id)\n+      return next\n+    })\n+  }\n+\n   return (\n     <main className=\"app\">\n       <h1>Tasks</h1>\n@@ -79,12 +124,17 @@ export default function App() {\n           search={search}\n           hasFilterResults={stateFiltered.length > 0}\n           onComplete={(id) => run(() => api.completeTask(id))}\n-          onDelete={(id) => run(() => api.deleteTask(id))}\n+          onDelete={deferDelete}\n           onUpdate={(id, title) => run(() => api.updateTask(id, title))}\n           onPriorityChange={(id, priority) => run(() => api.setPriority(id, priority))}\n           onDueDateChange={(id, dueDate) => run(() => api.setDueDate(id, dueDate))}\n         />\n       )}\n+      <UndoToast\n+        pending={tasks.filter((t) => pendingDeletes.has(t.id))}\n+        onUndo={cancelPendingDelete}\n+        windowMs={UNDO_WINDOW_MS}\n+      />\n     </main>\n   )\n }", "meta": {"native_type": "user", "tool_use_id": "toolu_01WVPthwtVJbzHCioBevAyG1", "session_id": "54aa24cf-1f06-4523-975a-4e66b25f56e3"}}
