\t  )\n51\t\n52\t  const sortedTasks = [...visibleTasks].sort(\n53\t    (a, b) => (a.priority === 'high' ? 0 : 1) - (b.priority === 'high' ? 0 : 1)\n54\t  )\n55\t\n56\t  const completedCount = activeTasks.filter((t) => t.done).length\n57\t  const openCount = activeTasks.filter((t) => !t.done).length\n58\t\n59\t  async function run(fn) {\n60\t    try {\n61\t      await fn()\n62\t      await refresh()\n63\t      return true\n64\t    } catch (e) {\n65\t      setError(e.message)\n66\t      return false\n67\t    }\n68\t  }\n69\t\n70\t  // Delete is deferred rather than immediate: the row hides now, but the\n71\t  // DELETE request only fires once the undo window lapses with no undo.\n72\t  // The task is never mutated in `tasks` during the window, so undoing it\n73\t  // just un-hides the row -- \"exactly as it was\" needs no reconstruction.\n74\t  function deferDelete(id) {\n75\t    const timer = setTimeout(async () => {\n76\t      try {\n77\t        await api.deleteTask(id)\n78\t        await refresh()\n79\t      } catch (e) {\n80\t        // \"no such task\" is the 404 detail main.py sends when the task was\n81\t        // already removed some other way (e.g. Clear completed) during the\n82\t        // window -- that case is expected and silent, per the spec. Any\n83\t        // other failure still surfaces through the usual error banner.\n84\t        if (e.message !== 'no such task') setError(e.message)\n85\t      } finally {\n86\t        // Only release the pending-delete slot once the attempt has settled,\n87\t        // so the task can't flash back into the list while the request (or\n88\t        // the refresh() it triggers) is still in flight.\n89\t        setPendingDeletes((prev) => {\n90\t          const next = new Map(prev)\n91\t          next.delete(id)\n92\t          return next\n93\t        })\n94\t      }\n95\t    }, UNDO_WINDOW_MS)\n96\t    setPendingDeletes((prev) => new Map(prev).set(id, timer))\n97\t  }\n98\t\n99\t  function cancelPendingDelete(id) {\n100\t    const timer = pendingDeletes.get(id)\n101\t    if (timer !== undefined) clearTimeout(timer)\n102\t    setPendingDeletes((prev) => {\n103\t      const next = new Map(prev)\n104\t      next.delete(id)\n105\t      return next\n106\t    })\n107\t  }\n108\t\n109\t  return (\n110\t    <main className=\"app\">\n111\t      <h1>Tasks</h1>\n112\t      {!loading && <TaskCounts open={openCount} done={completedCount} />}\n113\t      <AddTask onAdd={(title, priority, dueDate) => run(() => api.createTask(title, priority, dueDate))} />\n114\t      {error && <p className=\"error\" role=\"alert\">{error}</p>}\n115\t      <div className=\"list-toolbar\">\n116\t        <div className=\"toolbar-filters\">\n117\t          <SearchTasks value={search} onChange={setSearch} />\n118\t          <TaskFilter value={filter} onChange={setFilter} />\n119\t        </div>\n120\t        <ClearCompleted count={completedCount} onClear={() => run(() => api.clearCompleted())} />\n121\t      </div>\n122\t      {loading ? (\n123\t        <p className=\"loading\">Loading\u2026</p>\n124\t      ) : (\n125\t        <TaskList\n126\t          tasks={sortedTasks}\n127\t          filter={filter}\n128\t          search={search}\n129\t          hasFilterResults={stateFiltered.length > 0}\n130\t          onComplete={(id) => run(() => api.completeTask(id))}\n131\t          onDelete={deferDelete}\n132\t          onUpdate={(id, title) => run(() => api.updateTask(id, title))}\n133\t          onPriorityChange={(id, priority) => run(() => api.setPriority(id, priority))}\n134\t          onDueDateChange={(id, dueDate) => run(() => api.setDueDate(id, dueDate))}\n135\t        />\n136\t      )}\n137\t      <UndoToast\n138\t        pending={[...pendingDeletes.keys()]\n139\t          .map((id) => tasks.find((t) => t.id === id))\n140\t          .filter(Boolean)}\n141\t        onUndo={cancelPendingDelete}\n142\t        windowMs={UNDO_WINDOW_MS}\n143\t      />\n144\t    </main>\n145\t  )\n146\t}\n147\t", "meta": {"native_type": "user", "tool_use_id": "toolu_01DsfseT82KEHp77AMTr4uTT", "session_id": "97758105-17ca-4a7e-a40a-ad529b7e9589"}}
