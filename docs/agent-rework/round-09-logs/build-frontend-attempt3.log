{"ts": "2026-08-17T13:12:26Z", "agent": "claude", "seq": 13, "kind": "tool_result", "text": "1\timport { useEffect, useState } from 'react'\n2\timport AddTask from './components/AddTask'\n3\timport ClearCompleted from './components/ClearCompleted'\n4\timport SearchTasks from './components/SearchTasks'\n5\timport TaskCounts from './components/TaskCounts'\n6\timport TaskFilter from './components/TaskFilter'\n7\timport TaskList from './components/TaskList'\n8\timport UndoToast from './components/UndoToast'\n9\timport * as api from './api'\n10\timport './App.css'\n11\t\n12\tconst UNDO_WINDOW_MS = 5000\n13\t\n14\texport default function App() {\n15\t  const [tasks, setTasks] = useState([])\n16\t  const [error, setError] = useState(null)\n17\t  const [loading, setLoading] = useState(true)\n18\t  const [filter, setFilter] = useState('all')\n19\t  const [search, setSearch] = useState('')\n20\t  // Single source of truth: id -> pending delete's timer handle. Deriving\n21\t  // the toast's task list from `tasks` (below) rather than looking ids up\n22\t  // means a task that vanished from `tasks` some other way (e.g. Clear\n23\t  // completed racing the undo window) is naturally excluded instead of\n24\t  // producing a lookup miss.\n25\t  const [pendingDeletes, setPendingDeletes] = useState(new Map())\n26\t\n27\t  async function refresh() {\n28\t    try {\n29\t      setTasks(await api.listTasks())\n30\t      setError(null)\n31\t    } catch (e) {\n32\t      setError(e.message)\n33\t    } finally {\n34\t      setLoading(false)\n35\t    }\n36\t  }\n37\t\n38\t  useEffect(() => { refresh() }, [])\n39\t\n40\t  const activeTasks = tasks.filter((t) => !pendingDeletes.has(t.id))\n41\t\n42\t  const stateFiltered = activeTasks.filter((t) => {\n43\t    if (filter === 'open') return !t.done\n44\t    if (filter === 'done') return t.done\n45\t    return true\n46\t  })\n47\t\n48\t  const searchTerm = search.trim().toLowerCase()\n49\t  const visibleTasks = stateFiltered.filter((t) =>\n50\t    t.title.toLowerCase().includes(searchTerm)\n51\t  )\n52\t\n53\t  const sortedTasks = [...visibleTasks].sort(\n54\t    (a, b) => (a.priority === 'high' ? 0 : 1) - (b.priority === 'high' ? 0 : 1)\n55\t  )\n56\t\n57\t  const completedCount = activeTasks.filter((t) => t.done).length\n58\t  const openCount = activeTasks.filter((t) => !t.done).length\n59\t\n60\t  async function run(fn) {\n61\t    try {\n62\t      await fn()\n63\t      await refresh()\n64\t      return true\n65\t    } catch (e) {\n66\t      setError(e.message)\n67\t      return false\n68\t    }\n69\t  }\n70\t\n71\t  // Delete is deferred rather than immediate: the row hides now, but the\n72\t  // DELETE request only fires once the undo window lapses with no undo.\n73\t  // The task is never mutated in `tasks` during the window, so undoing it\n74\t  // just un-hides the row -- \"exactly as it was\" needs no reconstruction.\n75\t  function deferDelete(id) {\n76\t    const timer = setTimeout(async () => {\n77\t      setPendingDeletes((prev) => {\n78\t        const next = new Map(prev)\n79\t        next.delete(id)\n80\t        return next\n81\t      })\n82\t      try {\n83\t        await api.deleteTask(id)\n84\t        await refresh()\n85\t      } catch (e) {\n86\t        // \"no such task\" is the 404 detail main.py sends when the task was\n87\t        // already removed some other way (e.g. Clear completed) during the\n88\t        // window -- that case is expected and silent, per the spec. Any\n89\t        // other failure still surfaces through the usual error banner.\n90\t        if (e.message !== 'no such task') setError(e.message)\n91\t      }\n92\t    }, UNDO_WINDOW_MS)\n93\t    setPendingDeletes((prev) => new Map(prev).set(id, timer))\n94\t  }\n95\t\n96\t  function cancelPendingDelete(id) {\n97\t    setPendingDeletes((prev) => {\n98\t      clearTimeout(prev.get(id))\n99\t      const next = new Map(prev)\n100\t      next.delete(id)\n101\t      return next\n102\t    })\n103\t  }\n104\t\n105\t  return (\n106\t    <main className=\"app\">\n107\t      <h1>Tasks</h1>\n108\t      {!loading && <TaskCounts open={openCount} done={completedCount} />}\n109\t      <AddTask onAdd={(title, priority, dueDate) => run(() => api.createTask(title, priority, dueDate))} />\n110\t      {error && <p className=\"error\" role=\"alert\">{error}</p>}\n111\t      <div className=\"list-toolbar\">\n112\t        <div className=\"toolbar-filters\">\n113\t          <SearchTasks value={search} onChange={setSearch} />\n114\t          <TaskFilter value={filter} onChange={setFilter} />\n115\t        </div>\n116\t        <ClearCompleted count={completedCount} onClear={() => run(() => api.clearCompleted())} />\n117\t      </div>\n118\t      {loading ? (\n119\t        <p className=\"loading\">Loading\u2026</p>\n120\t      ) : (\n121\t        <TaskList\n122\t          tasks={sortedTasks}\n123\t          filter={filter}\n124\t          search={search}\n125\t          hasFilterResults={stateFiltered.length > 0}\n126\t          onComplete={(id) => run(() => api.completeTask(id))}\n127\t          onDelete={deferDelete}\n128\t          onUpdate={(id, title) => run(() => api.updateTask(id, title))}\n129\t          onPriorityChange={(id, priority) => run(() => api.setPriority(id, priority))}\n130\t          onDueDateChange={(id, dueDate) => run(() => api.setDueDate(id, dueDate))}\n131\t        />\n132\t      )}\n133\t      <UndoToast\n134\t        pending={tasks.filter((t) => pendingDeletes.has(t.id))}\n135\t        onUndo={cancelPendingDelete}\n136\t        windowMs={UNDO_WINDOW_MS}\n137\t      />\n138\t    </main>\n139\t  )\n140\t}\n141\t", "meta": {"native_type": "user", "tool_use_id": "toolu_01D15MqAT8H6kwbVeVuxrQUs", "session_id": "97758105-17ca-4a7e-a40a-ad529b7e9589"}}
