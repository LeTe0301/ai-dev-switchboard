radius: 0;\n68\t  background: #fff;\n69\t  padding: 0.45rem 0.9rem;\n70\t  font: inherit;\n71\t  color: #16191c;\n72\t  cursor: pointer;\n73\t}\n74\t.filter-option + .filter-option { border-left: 1px solid #ccd2d6; }\n75\t.filter-option.active { background: #16191c; color: #fff; }\n76\t\n77\t.empty, .loading { color: #6b7780; }\n78\t.task-counts { margin: 0 0 1.2rem; font-size: 0.95rem; color: #5a646c; }\n79\t.error { color: #a3271d; background: #fbe9e7; padding: 0.6rem 0.8rem; border-radius: 5px; }\n80\t\n81\t.task-edit { display: flex; gap: 0.5rem; flex: 1; align-items: center; }\n82\t.task-title-input {\n83\t  flex: 1;\n84\t  padding: 0.55rem 0.7rem;\n85\t  border: 1px solid #ccd2d6;\n86\t  border-radius: 5px;\n87\t  font: inherit;\n88\t}\n89\t.field-error {\n90\t  color: #a3271d;\n91\t  font-size: 0.85rem;\n92\t  margin: 0.3rem 0 0;\n93\t  flex-basis: 100%;\n94\t}\n95\t\n96\t.priority-select {\n97\t  padding: 0.4rem 0.6rem;\n98\t  border: 1px solid #ccd2d6;\n99\t  border-radius: 5px;\n100\t  background: #fff;\n101\t  color: #16191c;\n102\t  font: inherit;\n103\t  font-size: 0.85rem;\n104\t  cursor: pointer;\n105\t}\n106\t\n107\t.priority-select.priority-high {\n108\t  background: #a8480a;\n109\t  border-color: #a8480a;\n110\t  color: #fff;\n111\t}\n112\t\n113\t.priority-select.priority-low {\n114\t  background: #e8eaec;\n115\t  color: #4a545c;\n116\t}\n117\t\n118\t.due-date-input {\n119\t  padding: 0.4rem 0.6rem;\n120\t  border: 1px solid #ccd2d6;\n121\t  border-radius: 5px;\n122\t  background: #fff;\n123\t  color: #16191c;\n124\t  font: inherit;\n125\t  font-size: 0.85rem;\n126\t}\n127\t\n128\t.due-date-clear {\n129\t  padding: 0.4rem 0.6rem;\n130\t  border: 1px solid #ccd2d6;\n131\t  border-radius: 5px;\n132\t  background: #fff;\n133\t  color: #5a646c;\n134\t  font-size: 0.85rem;\n135\t  line-height: 1;\n136\t  cursor: pointer;\n137\t}\n138\t.due-date-clear:hover { background: #f0f2f3; }\n139\t\n140\t.overdue-badge {\n141\t  display: inline-flex;\n142\t  align