{"ts": "2026-08-17T13:03:45Z", "agent": "claude", "seq": 46, "kind": "tool_result", "text": "// Every network call goes through here: components never call fetch directly,\n// so the base URL and error handling stay in one place.\nconst BASE = import.meta.env.VITE_API_BASE || 'http://localhost:8000'\n\nasync function request(path, options = {}) {\n  const res = await fetch(BASE + path, {\n    headers: { 'Content-Type': 'application/json' },\n    ...options,\n  })\n  if (!res.ok) {\n    const detail = await res.json().catch(() => null)\n    throw new Error(detail?.detail || `request failed (${res.status})`)\n  }\n  return res.status === 204 ? null : res.json()\n}\n\nexport const listTasks = () => request('/api/tasks')\nexport const createTask = (title, priority, dueDate) =>\n  request('/api/tasks', { method: 'POST', body: JSON.stringify({ title, priority, due_date: dueDate }) })\nexport const completeTask = (id) => request(`/api/tasks/${id}/done`, { method: 'POST' })\nexport const updateTask = (id, title) =>\n  request(`/api/tasks/${id}`, { method: 'PATCH', body: JSON.stringify({ title }) })\nexport const setPriority = (id, priority) =>\n  request(`/api/tasks/${id}/priority`, { method: 'PATCH', body: JSON.stringify({ priority }) })\nexport const setDueDate = (id, dueDate) =>\n  request(`/api/tasks/${id}/due-date`, { method: 'PATCH', body: JSON.stringify({ due_date: dueDate }) })\nexport const deleteTask = (id) => request(`/api/tasks/${id}`, { method: 'DELETE' })\nexport const clearCompleted = () => request('/api/tasks/completed', { method: 'DELETE' })", "meta": {"native_type": "user", "tool_use_id": "toolu_01AooPUWNvuy6wvAbiZzSjov", "session_id": "56a4d996-1bdf-4be3-85b0-80157f9d2990"}}
{"ts": "2026-08-17T13:03:45Z", "agent": "claude", "seq": 47, "kind": "tool_result", "text": "\"\"\"Route wiring only -- behaviour lives in store.py.\"\"\"\nfrom fastapi import FastAPI, HTTPException\nfrom fastapi.middleware.cors import CORSMiddleware\n\nfrom .models import ClearResult, DueDateIn, PriorityIn, Task, TaskIn\nfrom .store import store\n\napp = FastAPI(title=\"test-project\")\n\n# A regex, not a fixed list: the dev server is reached as both localhost and\n# 127.0.0.1, and the e2e harness binds it to a free port rather than 5173, so\n# a hardcoded origin silently blocks every write from the browser while GETs\n# keep working -- which reads as \"adding a task does nothing\".\napp.add_middleware(\n    CORSMiddleware,\n    allow_origin_regex=r\"http://(localhost|127\\.0\\.0\\.1):\\d+\",\n    allow_methods=[\"*\"],\n    allow_headers=[\"*\"],\n)\n\n\n@app.get(\"/api/tasks\", response_model=list[Task])\ndef list_tasks() -> list[Task]:\n    return store.list()\n\n\n@app.post(\"/api/tasks\", response_model=Task, status_code=201)\ndef create_task(payload: TaskIn) -> Task:\n    return store.add(payload.title, payload.priority, payload.due_date)\n\n\n@app.post(\"/api/tasks/{task_id}/done\", response_model=Task)\ndef complete_task(task_id: int) -> Task:\n    task = store.set_done(task_id, True)\n    if task is None:\n        raise HTTPException(status_code=404, detail=\"no such task\")\n    return task\n\n\n@app.patch(\"/api/tasks/{task_id}/priority\", response_model=Task)\ndef update_priority(task_id: int, payload: PriorityIn) -> Task:\n    task = store.set_priority(task_id, payload.priority)\n    if task is None:\n        raise HTTPException(status_code=404, detail=\"no such task\")\n    return task\n\n\n@app.patch(\"/api/tasks/{task_id}/due-date\", response_model=Task)\ndef update_due_date(task_id: int, payload: DueDateIn) -> Task:\n    task = store.set_due_date(task_id, payload.due_date)\n    if task is None:\n        raise HTTPException(status_code=404, detail=\"no such task\")\n    return task\n\n\n@app.patch(\"/api/tasks/{task_id}\", response_model=Task)\ndef update_task(task_id: int, payload: TaskIn) -> Task:\n    task = store.update_title(task_id, payload.title)\n    if task is None:\n        raise HTTPException(status_code=404, detail=\"no such task\")\n    return task\n\n\n@app.delete(\"/api/tasks/completed\", response_model=ClearResult)\ndef clear_completed() -> ClearResult:\n    return ClearResult(count=store.clear_completed())\n\n\n@app.delete(\"/api/tasks/{task_id}\", status_code=204)\ndef delete_task(task_id: int) -> None:\n    if not store.delete(task_id):\n        raise HTTPException(status_code=404, detail=\"no such task\")", "meta": {"native_type": "user", "tool_use_id": "toolu_01YUnpq3Knc5tRc1LhumjP4t", "session_id": "56a4d996-1bdf-4be3-85b0-80157f9d2990"}}
