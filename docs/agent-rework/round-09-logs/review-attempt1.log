{"ts": "2026-08-17T13:05:13Z", "agent": "claude", "seq": 129, "kind": "tool_result", "text": "export default function UndoToast({ pending, onUndo, windowMs }) {\n  if (pending.length === 0) return null\n  return (\n    <div className=\"undo-toast-list\" role=\"status\">\n      {pending.map((task) => (\n        <div className=\"undo-toast\" key={task.id}>\n          <div className=\"undo-toast-row\">\n            <span className=\"undo-toast-title\" title={task.title}>\n              \"{task.title}\" deleted\n            </span>\n            <button\n              type=\"button\"\n              onClick={() => onUndo(task.id)}\n              aria-label={`Undo delete of ${task.title}`}\n            >\n              Undo\n            </button>\n          </div>\n          <div className=\"undo-toast-track\" aria-hidden=\"true\">\n            <div\n              className=\"undo-toast-fill\"\n              style={{ animationDuration: `${windowMs}ms` }}\n            />\n          </div>\n        </div>\n      ))}\n    </div>\n  )\n}", "meta": {"native_type": "user", "tool_use_id": "toolu_017YZsTBwCsZHJmdpSjFMHux", "session_id": "56a4d996-1bdf-4be3-85b0-80157f9d2990"}}
