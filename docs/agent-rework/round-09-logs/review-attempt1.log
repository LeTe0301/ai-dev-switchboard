{"ts": "2026-08-17T13:03:40Z", "agent": "claude", "seq": 35, "kind": "tool_result", "text": "import { useState } from 'react'\n\nconst EMPTY_COPY = {\n  all: 'Nothing to do yet.',\n  open: 'Nothing open right now.',\n  done: 'Nothing done yet.',\n}\n\nconst PRIORITIES = [\n  { value: 'low', label: 'Low' },\n  { value: 'normal', label: 'Normal' },\n  { value: 'high', label: 'High' },\n]\n\nconst todayISO = () => new Date().toLocaleDateString('en-CA') // YYYY-MM-DD, local time\nconst isOverdue = (task) => !task.done && task.due_date != null && task.due_date < todayISO()\n\nexport default function TaskList({ tasks, filter, search, hasFilterResults, onComplete, onDelete, onUpdate, onPriorityChange, onDueDateChange }) {\n  if (tasks.length === 0) {\n    const trimmedSearch = search?.trim()\n    const message = hasFilterResults && trimmedSearch\n      ? `No tasks match \"${trimmedSearch}\".`\n      : EMPTY_COPY[filter]\n    return <p className=\"empty\" aria-live=\"polite\">{message}</p>\n  }\n  return (\n    <ul className=\"task-list\">\n      {tasks.map((task) => (\n        <TaskRow\n          key={task.id}\n          task={task}\n          onComplete={onComplete}\n          onDelete={onDelete}\n          onUpdate={onUpdate}\n          onPriorityChange={onPriorityChange}\n          onDueDateChange={onDueDateChange}\n        />\n      ))}\n    </ul>\n  )\n}\n\nfunction TaskRow({ task, onComplete, onDelete, onUpdate, onPriorityChange, onDueDateChange }) {\n  const [isEditing, setIsEditing] = useState(false)\n  const [draft, setDraft] = useState(task.title)\n  const [showError, setShowError] = useState(false)\n\n  function startEdit() {\n    setDraft(task.title)\n    setShowError(false)\n    setIsEditing(true)\n  }\n\n  function cancel() {\n    setDraft(task.title)\n    setShowError(false)\n    setIsEditing(false)\n  }\n\n  async function submit(e) {\n    e.preventDefault()\n    const trimmed = draft.trim()\n    if (!trimmed) {\n      setShowError(true)\n      return\n    }\n    const ok = await onUpdate(task.id, trimmed)\n    if (ok) setIsEditing(false)\n  }\n\n  if (isEditing) {\n    return (\n      <li className={task.done ? 'task done' : 'task'}>\n        <form\n          className=\"task-edit\"\n          onSubmit={submit}\n          onKeyDown={(e) => {\n            if (e.key === 'Escape') cancel()\n            // A disabled Save button blocks the browser's native implicit\n            // submit-on-Enter, so an empty draft would never reach submit()\n            // to show the error. Handling Enter here bypasses that.\n            if (e.key === 'Enter') { e.preventDefault(); submit(e) }\n          }}\n        >\n          <input\n            className=\"task-title-input\"\n            value={draft}\n            onChange={(e) => { setDraft(e.target.value); setShowError(false) }}\n            aria-label={`Title for ${task.title}`}\n            autoFocus\n            onFocus={(e) => e.target.select()}\n          />\n          <button type=\"submit\" disabled={!draft.trim()}>Save</button>\n          <button type=\"button\" onClick={cancel}>Cancel</button>\n        </form>\n        {showError && <p className=\"field-error\" role=\"alert\">Title can't be empty</p>}\n      </li>\n    )\n  }\n\n  return (\n    <li className={task.done ? 'task done' : 'task'}>\n      <span className=\"task-title\">{task.title}</span>\n      <select\n        className={`priority-select priority-${task.priority}`}\n        value={task.priority}\n        onChange={(e) => onPriorityChange(task.id, e.target.value)}\n        aria-label={`Priority for ${task.title}`}\n      >\n        {PRIORITIES.map((p) => <option key={p.value} value={p.value}>{p.label}</option>)}\n      </select>\n      <input\n        type=\"date\"\n        className=\"due-date-input\"\n        value={task.due_date || ''}\n        onChange={(e) => onDueDateChange(task.id, e.target.value || null)}\n        aria-label={`Due date for ${task.title}`}\n      />\n      {task.due_date && (\n        <button\n          type=\"button\"\n          className=\"due-date-clear\"\n          onClick={() => onDueDateChange(task.id, null)}\n          aria-label={`Clear due date for ${task.title}`}\n        >\n          \u00d7\n        </button>\n      )}\n      {isOverdue(task) && (\n        <span className=\"overdue-badge\" role=\"status\">\n          <span aria-hidden=\"true\">\u26a0</span> Overdue\n        </span>\n      )}\n      <button onClick={startEdit} aria-label={`Edit ${task.title}`}>Edit</button>\n      {!task.done && (\n        <button onClick={() => onComplete(task.id)} aria-label={`Complete ${task.title}`}>\n          Done\n        </button>\n      )}\n      <button onClick={() => onDelete(task.id)} aria-label={`Delete ${task.title}`}>\n        Delete\n      </button>\n    </li>\n  )\n}", "meta": {"native_type": "user", "tool_use_id": "toolu_012oCbUGuaRxqE3YXAmAXfnd", "session_id": "56a4d996-1bdf-4be3-85b0-80157f9d2990"}}
