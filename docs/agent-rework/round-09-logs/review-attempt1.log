{"ts": "2026-08-17T13:03:59Z", "agent": "claude", "seq": 65, "kind": "tool_result", "text": "import { useEffect, useRef, useState } from 'react'\nimport AddTask from './components/AddTask'\nimport ClearCompleted from './components/ClearCompleted'\nimport SearchTasks from './components/SearchTasks'\nimport TaskCounts from './components/TaskCounts'\nimport TaskFilter from './components/TaskFilter'\nimport TaskList from './components/TaskList'\nimport UndoToast from './components/UndoToast'\nimport * as api from './api'\nimport './App.css'\n\nconst UNDO_WINDOW_MS = 5000\n\nexport default function App() {\n  const [tasks, setTasks] = useState([])\n  const [error, setError] = useState(null)\n  const [loading, setLoading] = useState(true)\n  const [filter, setFilter] = useState('all')\n  const [search, setSearch] = useState('')\n  const [pendingDeleteIds, setPendingDeleteIds] = useState([])\n  const pendingDeleteTimers = useRef(new Map())\n\n  async function refresh() {\n    try {\n      setTasks(await api.listTasks())\n      setError(null)\n    } catch (e) {\n      setError(e.message)\n    } finally {\n      setLoading(false)\n    }\n  }\n\n  useEffect(() => { refresh() }, [])\n\n  const activeTasks = tasks.filter((t) => !pendingDeleteIds.includes(t.id))\n\n  const stateFiltered = activeTasks.filter((t) => {\n    if (filter === 'open') return !t.done\n    if (filter === 'done') return t.done\n    return true\n  })\n\n  const searchTerm = search.trim().toLowerCase()\n  const visibleTasks = stateFiltered.filter((t) =>\n    t.title.toLowerCase().includes(searchTerm)\n  )\n\n  const sortedTasks = [...visibleTasks].sort(\n    (a, b) => (a.priority === 'high' ? 0 : 1) - (b.priority === 'high' ? 0 : 1)\n  )\n\n  const completedCount = activeTasks.filter((t) => t.done).length\n  const openCount = activeTasks.filter((t) => !t.done).length\n\n  async function run(fn) {\n    try {\n      await fn()\n      await refresh()\n      return true\n    } catch (e) {\n      setError(e.message)\n      return false\n    }\n  }\n\n  // Delete is deferred rather than immediate: the row hides now, but the\n  // DELETE request only fires once the undo window lapses with no undo.\n  // The task is never mutated in `tasks` during the window, so undoing it\n  // just un-hides the row -- \"exactly as it was\" needs no reconstruction.\n  function deferDelete(id) {\n    setPendingDeleteIds((ids) => [...ids, id])\n    const timer = setTimeout(async () => {\n      pendingDeleteTimers.current.delete(id)\n      setPendingDeleteIds((ids) => ids.filter((pendingId) => pendingId !== id))\n      try {\n        await api.deleteTask(id)\n        await refresh()\n      } catch (e) {\n        // \"no such task\" is the 404 detail main.py sends when the task was\n        // already removed some other way (e.g. Clear completed) during the\n        // window -- that case is expected and silent, per the spec. Any\n        // other failure still surfaces through the usual error banner.\n        if (e.message !== 'no such task') setError(e.message)\n      }\n    }, UNDO_WINDOW_MS)\n    pendingDeleteTimers.current.set(id, timer)\n  }\n\n  function cancelPendingDelete(id) {\n    clearTimeout(pendingDeleteTimers.current.get(id))\n    pendingDeleteTimers.current.delete(id)\n    setPendingDeleteIds((ids) => ids.filter((pendingId) => pendingId !== id))\n  }\n\n  return (\n    <main className=\"app\">\n      <h1>Tasks</h1>\n      {!loading && <TaskCounts open={openCount} done={completedCount} />}\n      <AddTask onAdd={(title, priority, dueDate) => run(() => api.createTask(title, priority, dueDate))} />\n      {error && <p className=\"error\" role=\"alert\">{error}</p>}\n      <div className=\"list-toolbar\">\n        <div className=\"toolbar-filters\">\n          <SearchTasks value={search} onChange={setSearch} />\n          <TaskFilter value={filter} onChange={setFilter} />\n        </div>\n        <ClearCompleted count={completedCount} onClear={() => run(() => api.clearCompleted())} />\n      </div>\n      {loading ? (\n        <p className=\"loading\">Loading\u2026</p>\n      ) : (\n        <TaskList\n          tasks={sortedTasks}\n          filter={filter}\n          search={search}\n          hasFilterResults={stateFiltered.length > 0}\n          onComplete={(id) => run(() => api.completeTask(id))}\n          onDelete={deferDelete}\n          onUpdate={(id, title) => run(() => api.updateTask(id, title))}\n          onPriorityChange={(id, priority) => run(() => api.setPriority(id, priority))}\n          onDueDateChange={(id, dueDate) => run(() => api.setDueDate(id, dueDate))}\n        />\n      )}\n      <UndoToast\n        pending={pendingDeleteIds.map((id) => tasks.find((t) => t.id === id))}\n        onUndo={cancelPendingDelete}\n        windowMs={UNDO_WINDOW_MS}\n      />\n    </main>\n  )\n}", "meta": {"native_type": "user", "tool_use_id": "toolu_017XLmxBUVMuZMpKnCS6JjqW", "session_id": "56a4d996-1bdf-4be3-85b0-80157f9d2990"}}
