{"ts": "2026-08-17T13:08:45Z", "agent": "claude", "seq": 26, "kind": "tool_result", "text": "     1\texport default function UndoToast({ pending, onUndo, windowMs }) {\n     2\t  if (pending.length === 0) return null\n     3\t  return (\n     4\t    <div className=\"undo-toast-list\" role=\"status\">\n     5\t      {pending.map((task) => (\n     6\t        <div className=\"undo-toast\" key={task.id}>\n     7\t          <div className=\"undo-toast-row\">\n     8\t            <span className=\"undo-toast-title\" title={task.title}>\n     9\t              \"{task.title}\" deleted\n    10\t            </span>\n    11\t            <button\n    12\t              type=\"button\"\n    13\t              onClick={() => onUndo(task.id)}\n    14\t              aria-label={`Undo delete of ${task.title}`}\n    15\t            >\n    16\t              Undo\n    17\t            </button>\n    18\t          </div>\n    19\t          <div className=\"undo-toast-track\" aria-hidden=\"true\">\n    20\t            <div\n    21\t              className=\"undo-toast-fill\"\n    22\t              style={{ animationDuration: `${windowMs}ms` }}\n    23\t            />\n    24\t          </div>\n    25\t        </div>\n    26\t      ))}\n    27\t    </div>\n    28\t  )\n    29\t}", "meta": {"native_type": "user", "tool_use_id": "toolu_01QqGGU9R2J3Cx95fLiVWptY", "session_id": "654814c6-720b-4415-b6c7-fe9892cf255f"}}
