{"ts": "2026-08-17T10:38:12Z", "agent": "claude", "seq": 38, "kind": "tool_result", "text": "1\t\"\"\"End-to-end: a real browser against the real app.\n2\t\n3\tEvery assertion uses `expect()`, never `is_visible()`. `is_visible()` answers\n4\tabout *this instant* and does not wait, so against a UI that updates after a\n5\tnetwork round-trip it reports False before the update lands. `expect()`\n6\tretries until it passes or times out, which is what makes these tests\n7\tdeterministic rather than a race.\n8\t\"\"\"\n9\tfrom playwright.sync_api import expect\n10\t\n11\t\n12\tdef add_task(page, title):\n13\t    page.get_by_label(\"Task title\").fill(title)\n14\t    page.get_by_role(\"button\", name=\"Add\").click()\n15\t\n16\t\n17\tdef select_filter(page, name):\n18\t    page.get_by_role(\"button\", name=name).click()\n19\t\n20\t\n21\tdef complete_task(page, title):\n22\t    page.get_by_role(\"button\", name=f\"Complete {title}\").click()\n23\t\n24\t\n25\tdef test_empty_state_is_shown_first(page):\n26\t    expect(page.get_by_text(\"Nothing to do yet.\")).to_be_visible()\n27\t\n28\t\n29\tdef test_adding_a_task_shows_it_in_the_list(page):\n30\t    add_task(page, \"buy milk\")\n31\t    expect(page.get_by_text(\"buy milk\")).to_be_visible()\n32\t\n33\t\n34\tdef test_the_input_clears_after_adding(page):\n35\t    add_task(page, \"buy milk\")\n36\t    expect(page.get_by_label(\"Task title\")).to_have_value(\"\")\n37\t\n38\t\n39\tdef test_completing_a_task_strikes_it_through(page):\n40\t    add_task(page, \"buy milk\")\n41\t    page.get_by_role(\"button\", name=\"Complete buy milk\").click()\n42\t    expect(page.locator(\"li.task.done\")).to_have_count(1)\n43\t\n44\t\n45\tdef test_completing_a_task_hides_its_done_button(page):\n46\t    add_task(page, \"buy milk\")\n47\t    page.get_by_role(\"button\", name=\"Complete buy milk\").click()\n48\t    expect(page.get_by_role(\"button\", name=\"Complete buy milk\")).to_have_count(0)\n49\t\n50\t\n51\tdef test_deleting_a_task_removes_it(page):\n52\t    add_task(page, \"buy milk\")\n53\t    page.get_by_role(\"button\", name=\"Delete buy milk\").click()\n54\t    expect(page.get_by_text(\"Nothing to do yet.\")).to_be_visible()\n55\t\n56\t\n57\tdef test_add_is_disabled_until_something_is_typed(page):\n58\t    expect(page.get_by_role(\"button\", name=\"Add\")).to_be_disabled()\n59\t    page.get_by_label(\"Task title\").fill(\"x\")\n60\t    expect(page.get_by_role(\"button\", name=\"Add\")).to_be_enabled()\n61\t\n62\t\n63\tdef test_two_tasks_both_appear(page):\n64\t    add_task(page, \"first task\")\n65\t    add_task(page, \"second task\")\n66\t    expect(page.locator(\"li.task\")).to_have_count(2)\n67\t\n68\t\n69\tdef test_default_filter_is_all_and_marked_active(page):\n70\t    expect(page.get_by_role(\"button\", name=\"All\")).to_have_attribute(\"aria-pressed\", \"true\")\n71\t\n72\t\n73\tdef test_selecting_a_filter_marks_it_active_and_others_inactive(page):\n74\t    select_filter(page, \"Open\")\n75\t    expect(page.get_by_role(\"button\", name=\"Open\")).to_have_attribute(\"aria-pressed\", \"true\")\n76\t    expect(page.get_by_role(\"button\", name=\"All\")).to_have_attribute(\"aria-pressed\", \"false\")\n77\t    expect(page.get_by_role(\"button\", name=\"Done\")).to_have_attribute(\"aria-pressed\", \"false\")\n78\t\n79\t\n80\tdef test_open_filter_hides_done_tasks(page):\n81\t    add_task(page, \"buy milk\")\n82\t    add_task(page, \"walk dog\")\n83\t    complete_task(page, \"buy milk\")\n84\t    select_filter(page, \"Open\")\n85\t    expect(page.get_by_text(\"buy milk\")).to_have_count(0)\n86\t    expect(page.get_by_text(\"walk dog\")).to_be_visible()\n87\t\n88\t\n89\tdef test_done_filter_shows_only_done_tasks(page):\n90\t    add_task(page, \"buy milk\")\n91\t    add_task(page, \"walk dog\")\n92\t    complete_task(page, \"buy milk\")\n93\t    select_filter(page, \"Done\")\n94\t    expect(page.get_by_text(\"buy milk\")).to_be_visible()\n95\t    expect(page.get_by_text(\"walk dog\")).to_have_count(0)\n96\t\n97\t\n98\tdef test_all_filter_shows_every_task_again(page):\n99\t    add_task(page, \"buy milk\")\n100\t    add_task(page, \"walk dog\")\n101\t    complete_task(page, \"buy milk\")\n102\t    select_filter(page, \"Done\")\n103\t    select_filter(page, \"All\")\n104\t    expect(page.get_by_text(\"buy milk\")).to_be_visible()\n105\t    expect(page.get_by_text(\"walk dog\")).to_be_visible()\n106\t\n107\t\n108\tdef test_adding_a_task_while_open_filter_is_active_shows_it(page):\n109\t    select_filter(page, \"Open\")\n110\t    add_task(page, \"buy milk\")\n111\t    expect(page.get_by_text(\"buy milk\")).to_be_visible()\n112\t\n113\t\n114\tdef test_adding_a_task_while_done_filter_is_active_hides_it_until_completed(page):\n115\t    select_filter(page, \"Done\")\n116\t    add_task(page, \"buy milk\")\n117\t    expect(page.get_by_text(\"buy milk\")).to_have_count(0)\n118\t\n119\t\n120\tdef test_completing_a_task_removes_it_from_open_view_live(page):\n121\t    add_task(page, \"buy milk\")\n122\t    select_filter(page, \"Open\")\n123\t    complete_task(page, \"buy milk\")\n124\t    expect(page.get_by_text(\"buy milk\")).to_have_count(0)\n125\t\n126\t\n127\tdef test_completing_a_task_makes_it_appear_under_done_live(page):\n128\t    add_task(page, \"buy milk\")\n129\t    complete_task(page, \"buy milk\")\n130\t    select_filter(page, \"Done\")\n131\t    expect(page.get_by_text(\"buy milk\")).to_be_visible()\n132\t\n133\t\n134\tdef test_filter_choice_persists_across_add_and_delete(page):\n135\t    add_task(page, \"buy milk\")\n136\t    select_filter(page, \"Open\")\n137\t    add_task(page, \"walk dog\")\n138\t    expect(page.get_by_role(\"button\", name=\"Open\")).to_have_attribute(\"aria-pressed\", \"true\")\n139\t    page.get_by_role(\"button\", name=\"Delete buy milk\").click()\n140\t    expect(page.get_by_role(\"button\", name=\"Open\")).to_have_attribute(\"aria-pressed\", \"true\")\n141\t\n142\t\n143\tdef test_open_filter_empty_state_when_all_tasks_done(page):\n144\t    add_task(page, \"buy milk\")\n145\t    complete_task(page, \"buy milk\")\n146\t    select_filter(page, \"Open\")\n147\t    expect(page.get_by_text(\"Nothing open right now.\")).to_be_visible()\n148\t\n149\t\n150\tdef test_done_filter_empty_state_when_no_task_done(page):\n151\t    add_task(page, \"buy milk\")\n152\t    select_filter(page, \"Done\")\n153\t    expect(page.get_by_text(\"Nothing done yet.\")).to_be_visible()\n154\t", "meta": {"native_type": "user", "tool_use_id": "toolu_01GPWvVuywp3DK2dj4x3X7RS", "session_id": "d8c8bbb8-ecc5-4fe0-b4d6-641913fa3b5c"}}
