{"ts": "2026-08-17T10:12:55Z", "agent": "claude", "seq": 113, "kind": "tool_result", "text": "1\timport { useState } from 'react'\n2\t\n3\tconst EMPTY_COPY = {\n4\t  all: 'Nothing to do yet.',\n5\t  open: 'Nothing open right now.',\n6\t  done: 'Nothing done yet.',\n7\t}\n8\t\n9\texport default function TaskList({ tasks, filter, onComplete, onEdit, onDelete }) {\n10\t  const [editingId, setEditingId] = useState(null)\n11\t  const [draft, setDraft] = useState('')\n12\t  const [validationError, setValidationError] = useState(null)\n13\t\n14\t  if (tasks.length === 0) {\n15\t    return <p className=\"empty\">{EMPTY_COPY[filter]}</p>\n16\t  }\n17\t\n18\t  function startEdit(task) {\n19\t    setEditingId(task.id)\n20\t    setDraft(task.title)\n21\t    setValidationError(null)\n22\t  }\n23\t\n24\t  function cancelEdit() {\n25\t    setEditingId(null)\n26\t    setValidationError(null)\n27\t  }\n28\t\n29\t  function submitEdit(e, task) {\n30\t    e.preventDefault()\n31\t    const trimmed = draft.trim()\n32\t    if (!trimmed) {\n33\t      setValidationError(\"Title can't be empty.\")\n34\t      return\n35\t    }\n36\t    setEditingId(null)\n37\t    setValidationError(null)\n38\t    onEdit(task.id, trimmed)\n39\t  }\n40\t\n41\t  return (\n42\t    <ul className=\"task-list\">\n43\t      {tasks.map((task) =>\n44\t        task.id === editingId ? (\n45\t          <li key={task.id} className={task.done ? 'task done' : 'task'}>\n46\t            <form className=\"task-edit-form\" onSubmit={(e) => submitEdit(e, task)}>\n47\t              <input\n48\t                value={draft}\n49\t                onChange={(e) => setDraft(e.target.value)}\n50\t                onKeyDown={(e) => e.key === 'Escape' && cancelEdit()}\n51\t                aria-label=\"Task title\"\n52\t                aria-invalid={validationError ? 'true' : undefined}\n53\t                aria-describedby={validationError ? `edit-error-${task.id}` : undefined}\n54\t                className={validationError ? 'task-edit-input invalid' : 'task-edit-input'}\n55\t                autoFocus\n56\t              />\n57\t              <button type=\"submit\" aria-label={`Save new title for ${task.title}`}>\n58\t                Save\n59\t              </button>\n60\t              <button type=\"button\" onClick={cancelEdit} aria-label={`Cancel editing ${task.title}`}>\n61\t                Cancel\n62\t              </button>\n63\t              {validationError && (\n64\t                <p className=\"task-edit-error\" role=\"alert\" id={`edit-error-${task.id}`}>\n65\t                  {validationError}\n66\t                </p>\n67\t              )}\n68\t            </form>\n69\t          </li>\n70\t        ) : (\n71\t          <li key={task.id} className={task.done ? 'task done' : 'task'}>\n72\t            <span className=\"task-title\">{task.title}</span>\n73\t            {!task.done && (\n74\t              <button onClick={() => onComplete(task.id)} aria-label={`Complete ${task.title}`}>\n75\t                Done\n76\t              </button>\n77\t            )}\n78\t            <button onClick={() => startEdit(task)} aria-label={`Edit ${task.title}`}>\n79\t              Edit\n80\t            </button>\n81\t            <button onClick={() => onDelete(task.id)} aria-label={`Delete ${task.title}`}>\n82\t              Delete\n83\t            </button>\n84\t          </li>\n85\t        )\n86\t      )}\n87\t    </ul>\n88\t  )\n89\t}\n90\t", "meta": {"native_type": "user", "tool_use_id": "toolu_01L8rbzvAE2uD3cmit6NYKx8", "session_id": "00ab4611-cab3-47b0-95fa-5f9771d57bc3"}}
