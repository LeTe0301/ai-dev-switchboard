{"ts": "2026-08-17T10:22:46Z", "agent": "claude", "seq": 30, "kind": "tool_result", "text": "1\t\"\"\"End-to-end: a real browser against the real app.\n2\t\n3\tEvery assertion uses `expect()`, never `is_visible()`. `is_visible()` answers\n4\tabout *this instant* and does not wait, so against a UI that updates after a\n5\tnetwork round-trip it reports False before the update lands. `expect()`\n6\tretries until it passes or times out, which is what makes these tests\n7\tdeterministic rather than a race.\n8\t\"\"\"\n9\tfrom playwright.sync_api import expect\n10\t\n11\t\n12\tdef add_task(page, title):\n13\t    page.get_by_label(\"Task title\").fill(title)\n14\t    page.get_by_role(\"button\", name=\"Add\").click()\n15\t\n16\t\n17\tdef select_filter(page, name):\n18\t    page.get_by_role(\"button\", name=name).click()\n19\t\n20\t\n21\tdef complete_task(page, title):\n22\t    page.get_by_role(\"button\", name=f\"Complete {title}\").click()\n23\t\n24\t\n25\tdef test_empty_state_is_shown_first(page):\n26\t    expect(page.get_by_text(\"Nothing to do yet.\")).to_be_visible()\n27\t\n28\t\n29\tdef test_adding_a_task_shows_it_in_the_list(page):\n30\t    add_task(page, \"buy milk\")\n31\t    expect(page.get_by_text(\"buy milk\")).to_be_visible()\n32\t\n33\t\n34\tdef test_the_input_clears_after_adding(page):\n35\t    add_task(page, \"buy milk\")\n36\t    expect(page.get_by_label(\"Task title\")).to_have_value(\"\")\n37\t\n38\t\n39\tdef test_completing_a_task_strikes_it_through(page):\n40\t    add_task(page, \"buy milk\")\n41\t    page.get_by_role(\"button\", name=\"Complete buy milk\").click()\n42\t    expect(page.locator(\"li.task.done\")).to_have_count(1)\n43\t\n44\t\n45\tdef test_completing_a_task_hides_its_done_button(page):\n46\t    add_task(page, \"buy milk\")\n47\t    page.get_by_role(\"button\", name=\"Complete buy milk\").click()\n48\t    expect(page.get_by_role(\"button\", name=\"Complete buy milk\")).to_have_count(0)\n49\t\n50\t\n51\tdef test_deleting_a_task_removes_it(page):\n52\t    add_task(page, \"buy milk\")\n53\t    page.get_by_role(\"button\", name=\"Delete buy milk\").click()\n54\t    expect(page.get_by_text(\"Nothing to do yet.\")).to_be_visible()\n55\t\n56\t\n57\tdef test_add_is_disabled_until_something_is_typed(page):\n58\t    expect(page.get_by_role(\"button\", name=\"Add\")).to_be_disabled()\n59\t    page.get_by_label(\"Task title\").fill(\"x\")\n60\t    expect(page.get_by_role(\"button\", name=\"Add\")).to_be_enabled()\n61\t\n62\t\n63\tdef test_two_tasks_both_appear(page):\n64\t    add_task(page, \"first task\")\n65\t    add_task(page, \"second task\")\n66\t    expect(page.locator(\"li.task\")).to_have_count(2)\n67\t\n68\t\n69\tdef test_default_filter_is_all_and_marked_active(page):\n70\t    expect(page.get_by_role(\"button\", name=\"All\")).to_have_attribute(\"aria-pressed\", \"true\")\n71\t\n72\t\n73\tdef test_selecting_a_filter_marks_it_active_and_others_inactive(page):\n74\t    select_filter(page, \"Open\")\n75\t    expect(page.get_by_role(\"button\", name=\"Open\")).to_have_attribute(\"aria-pressed\", \"true\")\n76\t    expect(page.get_by_role(\"button\", name=\"All\")).to_have_attribute(\"aria-pressed\", \"false\")\n77\t    expect(page.get_by_role(\"button\", name=\"Done\")).to_have_attribute(\"aria-pressed\", \"false\")\n78\t\n79\t\n80\tdef test_open_filter_hides_done_tasks(page):\n81\t    add_task(page, \"buy milk\")\n82\t    add_task(page, \"walk dog\")\n83\t    complete_task(page, \"buy milk\")\n84\t    select_filter(page, \"Open\")\n85\t    expect(page.get_by_text(\"buy milk\")).to_have_count(0)\n86\t    expect(page.get_by_text(\"walk dog\")).to_be_visible()\n87\t\n88\t\n89\tdef test_done_filter_shows_only_done_tasks(page):\n90\t    add_task(page, \"buy milk\")\n91\t    add_task(page, \"walk dog\")\n92\t    complete_task(page, \"buy milk\")\n93\t    select_filter(page, \"Done\")\n94\t    expect(page.get_by_text(\"buy milk\")).to_be_visible()\n95\t    expect(page.get_by_text(\"walk dog\")).to_have_count(0)\n96\t\n97\t\n98\tdef test_all_filter_shows_every_task_again(page):\n99\t    add_task(page, \"buy milk\")\n100\t    add_task(page, \"walk dog\")\n101\t    complete_task(page, \"buy milk\")\n102\t    select_filter(page, \"Done\")\n103\t    select_filter(page, \"All\")\n104\t    expect(page.get_by_text(\"buy milk\")).to_be_visible()\n105\t    expect(page.get_by_text(\"walk dog\")).to_be_visible()\n106\t\n107\t\n108\tdef test_adding_a_task_while_open_filter_is_active_shows_it(page):\n109\t    select_filter(page, \"Open\")\n110\t    add_task(page, \"buy milk\")\n111\t    expect(page.get_by_text(\"buy milk\")).to_be_visible()\n112\t\n113\t\n114\tdef test_adding_a_task_while_done_filter_is_active_hides_it_until_completed(page):\n115\t    select_filter(page, \"Done\")\n116\t    add_task(page, \"buy milk\")\n117\t    expect(page.get_by_text(\"buy milk\")).to_have_count(0)\n118\t\n119\t\n120\tdef test_completing_a_task_removes_it_from_open_view_live(page):\n121\t    add_task(page, \"buy milk\")\n122\t    select_filter(page, \"Open\")\n123\t    complete_task(page, \"buy milk\")\n124\t    expect(page.get_by_text(\"buy milk\")).to_have_count(0)\n125\t\n126\t\n127\tdef test_completing_a_task_makes_it_appear_under_done_live(page):\n128\t    add_task(page, \"buy milk\")\n129\t    complete_task(page, \"buy milk\")\n130\t    select_filter(page, \"Done\")\n131\t    expect(page.get_by_text(\"buy milk\")).to_be_visible()\n132\t\n133\t\n134\tdef test_filter_choice_persists_across_add_and_delete(page):\n135\t    add_task(page, \"buy milk\")\n136\t    select_filter(page, \"Open\")\n137\t    add_task(page, \"walk dog\")\n138\t    expect(page.get_by_role(\"button\", name=\"Open\")).to_have_attribute(\"aria-pressed\", \"true\")\n139\t    page.get_by_role(\"button\", name=\"Delete buy milk\").click()\n140\t    expect(page.get_by_role(\"button\", name=\"Open\")).to_have_attribute(\"aria-pressed\", \"true\")\n141\t\n142\t\n143\tdef test_open_filter_empty_state_when_all_tasks_done(page):\n144\t    add_task(page, \"buy milk\")\n145\t    complete_task(page, \"buy milk\")\n146\t    select_filter(page, \"Open\")\n147\t    expect(page.get_by_text(\"Nothing open right now.\")).to_be_visible()\n148\t\n149\t\n150\tdef test_done_filter_empty_state_when_no_task_done(page):\n151\t    add_task(page, \"buy milk\")\n152\t    select_filter(page, \"Done\")\n153\t    expect(page.get_by_text(\"Nothing done yet.\")).to_be_visible()\n154\t\n155\t\n156\tdef start_edit(page, title):\n157\t    page.get_by_role(\"button\", name=f\"Edit {title}\").click()\n158\t\n159\t\n160\tdef edit_input(page):\n161\t    \"\"\"Scoped to the task list, not the always-present AddTask input.\n162\t\n163\t    Both inputs share aria-label=\"Task title\" (see\n164\t    test_edit_input_shares_the_add_tasks_accessible_name below), so an\n165\t    unscoped get_by_label(\"Task title\") is ambiguous the moment any row is\n166\t    in edit mode. This helper works around that in the test suite; the\n167\t    underlying duplicate label is a real defect, not a test artifact.\n168\t    \"\"\"\n169\t    return page.locator(\"ul.task-list\").get_by_label(\"Task title\")\n170\t\n171\t\n172\tdef test_editing_shows_an_input_prefilled_with_the_current_title(page):\n173\t    add_task(page, \"buy milk\")\n174\t    start_edit(page, \"buy milk\")\n175\t    expect(edit_input(page)).to_have_value(\"buy milk\")\n176\t\n177\t\n178\tdef test_edit_input_shares_the_add_tasks_accessible_name(page):\n179\t    \"\"\"Documents a real defect (not desired behaviour): while a row is in\n180\t    edit mode, the page has two text inputs both accessibly named \"Task\n181\t    title\" -- the always-present AddTask input and this row's edit input.\n182\t    Screen-reader and other accessible-name-based tooling cannot\n183\t    distinguish them. See docs/design.md:200-203, which only reasoned\n184\t    about collisions between multiple task rows and missed the\n185\t    always-rendered AddTask input entirely.\"\"\"\n186\t    add_task(page, \"buy milk\")\n187\t    start_edit(page, \"buy milk\")\n188\t    expect(page.get_by_label(\"Task title\")).to_have_count(2)\n189\t\n190\t\n191\tdef test_saving_a_new_title_updates_the_list(page):\n192\t    add_task(page, \"buy milk\")\n193\t    start_edit(page, \"buy milk\")\n194\t    edit_input(page).fill(\"buy oat milk\")\n195\t    page.get_by_role(\"button\", name=\"Save new title for buy milk\").click()\n196\t    expect(page.get_by_text(\"buy oat milk\")).to_be_visible()\n197\t    expect(page.get_by_text(\"buy milk\", exact=True)).to_have_count(0)\n198\t\n199\t\n200\tdef test_saved_title_survives_a_reload(page):\n201\t    add_task(page, \"buy milk\")\n202\t    start_edit(page, \"buy milk\")\n203\t    edit_input(page).fill(\"buy oat milk\")\n204\t    page.get_by_role(\"button\", name=\"Save new title for buy milk\").click()\n205\t    expect(page.get_by_text(\"buy oat milk\")).to_be_visible()\n206\t    page.reload()\n207\t    expect(page.get_by_text(\"buy oat milk\")).to_be_visible()\n208\t\n209\t\n210\tdef test_cancel_button_reverts_without_saving(page):\n211\t    add_task(page, \"buy milk\")\n212\t    start_edit(page, \"buy milk\")\n213\t    edit_input(page).fill(\"something else entirely\")\n214\t    page.get_by_role(\"button\", name=\"Cancel editing buy milk\").click()\n215\t    expect(page.get_by_text(\"buy milk\")).to_be_visible()\n216\t    expect(page.get_by_text(\"something else entirely\")).to_have_count(0)\n217\t\n218\t\n219\tdef test_escape_reverts_without_saving(page):\n220\t    add_task(page, \"buy milk\")\n221\t    start_edit(page, \"buy milk\")\n222\t    edit_input(page).fill(\"something else entirely\")\n223\t    edit_input(page).press(\"Escape\")\n224\t    expect(page.get_by_text(\"buy milk\")).to_be_visible()\n225\t    expect(page.get_by_text(\"something else entirely\")).to_have_count(0)\n226\t\n227\t\n228\tdef test_empty_title_is_rejected_and_task_keeps_its_title(page):\n229\t    add_task(page, \"buy milk\")\n230\t    start_edit(page, \"buy milk\")\n231\t    edit_input(page).fill(\"\")\n232\t    page.get_by_role(\"button\", name=\"Save new title for buy milk\").click()\n233\t    expect(page.get_by_role(\"alert\").filter(has_text=\"empty\")).to_be_visible()\n234\t    # still in edit mode, title unchanged once cancelled\n235\t    edit_input(page).press(\"Escape\")\n236\t    expect(page.get_by_text(\"buy milk\")).to_be_visible()\n237\t\n238\t\n239\tdef test_whitespace_only_title_is_rejected(page):\n240\t    add_task(page, \"buy milk\")\n241\t    start_edit(page, \"buy milk\")\n242\t    edit_input(page).fill(\"   \")\n243\t    page.get_by_role(\"button\", name=\"Save new title for buy milk\").click()\n244\t    expect(page.get_by_role(\"alert\").filter(has_text=\"empty\")).to_be_visible()\n245\t\n246\t\n247\tdef test_editing_a_done_task_is_allowed(page):\n248\t    add_task(page, \"buy milk\")\n249\t    complete_task(page, \"buy milk\")\n250\t    start_edit(page, \"buy milk\")\n251\t    edit_input(page).fill(\"buy oat milk\")\n252\t    page.get_by_role(\"button\", name=\"Save new title for buy milk\").click()\n253\t    expect(page.get_by_text(\"buy oat milk\")).to_be_visible()\n254\t\n255\t\n256\tdef test_starting_a_second_edit_closes_the_first_without_saving(page):\n257\t    add_task(page, \"buy milk\")\n258\t    add_task(page, \"walk dog\")\n259\t    start_edit(page, \"buy milk\")\n260\t    edit_input(page).fill(\"this draft is discarded\")\n261\t    start_edit(page, \"walk dog\")\n262\t    expect(page.get_by_text(\"buy milk\")).to_be_visible()\n263\t    expect(page.get_by_text(\"this draft is discarded\")).to_have_count(0)\n264\t\n265\t\n266\tdef test_oversized_title_surfaces_an_unreadable_error(page):\n267\t    \"\"\"Characterizes existing behaviour, not desired behaviour: AC5 says\n268\t    an oversized title must be \"surfaced to the user\", and the save is\n269\t    correctly rejected, but api.js's request() does `new Error(detail.detail)`\n270\t    where detail.detail is FastAPI's list of validation-error objects, so\n271\t    the banner renders \"[object Object]\" instead of a readable message.\n272\t    Pre-existing in request() (shared with AddTask's create path), not\n273\t    introduced by this diff -- see docs/design.md:64-71.\"\"\"\n274\t    add_task(page, \"buy milk\")\n275\t    start_edit(page, \"buy milk\")\n276\t    edit_input(page).fill(\"y\" * 201)\n277\t    page.get_by_role(\"button\", name=\"Save new title for buy milk\").click()\n278\t    expect(page.locator(\"p.error\")).to_be_visible()\n279\t    expect(page.locator(\"p.error\")).to_have_text(\"[object Object]\")\n280\t    expect(page.get_by_text(\"buy milk\")).to_be_visible()\n281\t", "meta": {"native_type": "user", "tool_use_id": "toolu_018nKnjrtt5A3dSc7Cf63ZSU", "session_id": "58fceeb3-b436-44c4-aa8c-c256d25c46e2"}}
