{"ts": "2026-08-17T10:29:16Z", "agent": "claude", "seq": 115, "kind": "tool_result", "text": "diff --git a/backend/tests/test_tasks.py b/backend/tests/test_tasks.py\nindex 4cf1b25..d2a47d0 100644\n--- a/backend/tests/test_tasks.py\n+++ b/backend/tests/test_tasks.py\n@@ -39,3 +39,22 @@ def test_delete_removes_it(client):\n \n def test_deleting_a_missing_task_is_404(client):\n     assert client.delete(\"/api/tasks/999\").status_code == 404\n+\n+\n+def test_updating_a_task_changes_its_title(client):\n+    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\"}).json()[\"id\"]\n+    r = client.patch(f\"/api/tasks/{task_id}\", json={\"title\": \"y\"})\n+    assert r.status_code == 200\n+    assert r.json()[\"title\"] == \"y\"\n+    assert client.get(\"/api/tasks\").json()[0][\"title\"] == \"y\"\n+\n+\n+def test_updating_a_missing_task_is_404(client):\n+    assert client.patch(\"/api/tasks/999\", json={\"title\": \"y\"}).status_code == 404\n+\n+\n+def test_updating_with_an_empty_title_is_rejected(client):\n+    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\"}).json()[\"id\"]\n+    r = client.patch(f\"/api/tasks/{task_id}\", json={\"title\": \"\"})\n+    assert r.status_code == 422\n+    assert client.get(\"/api/tasks\").json()[0][\"title\"] == \"x\"", "meta": {"native_type": "user", "tool_use_id": "toolu_013QJMNXrCimNEkmgqk8kQBt", "session_id": "0eebde98-5c8c-4448-8749-7a27e4e34a84"}}
