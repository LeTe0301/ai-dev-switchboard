{"ts": "2026-08-17T10:29:02Z", "agent": "claude", "seq": 98, "kind": "tool_result", "text": "diff --git a/frontend/src/components/TaskList.jsx b/frontend/src/components/TaskList.jsx\nindex 45df8ac..14e8509 100644\n--- a/frontend/src/components/TaskList.jsx\n+++ b/frontend/src/components/TaskList.jsx\n@@ -1,28 +1,89 @@\n+import { useState } from 'react'\n+\n const EMPTY_COPY = {\n   all: 'Nothing to do yet.',\n   open: 'Nothing open right now.',\n   done: 'Nothing done yet.',\n }\n \n-export default function TaskList({ tasks, filter, onComplete, onDelete }) {\n+export default function TaskList({ tasks, filter, onComplete, onEdit, onDelete }) {\n+  const [editingId, setEditingId] = useState(null)\n+  const [draft, setDraft] = useState('')\n+  const [validationError, setValidationError] = useState(null)\n+\n   if (tasks.length === 0) {\n     return <p className=\"empty\">{EMPTY_COPY[filter]}</p>\n   }\n+\n+  function startEdit(task) {\n+    setEditingId(task.id)\n+    setDraft(task.title)\n+    setValidationError(null)\n+  }\n+\n+  function cancelEdit() {\n+    setEditingId(null)\n+    setValidationError(null)\n+  }\n+\n+  function submitEdit(e, task) {\n+    e.preventDefault()\n+    const trimmed = draft.trim()\n+    if (!trimmed) {\n+      setValidationError(\"Title can't be empty.\")\n+      return\n+    }\n+    setEditingId(null)\n+    setValidationError(null)\n+    onEdit(task.id, trimmed)\n+  }\n+\n   return (\n     <ul className=\"task-list\">\n-      {tasks.map((task) => (\n-        <li key={task.id} className={task.done ? 'task done' : 'task'}>\n-          <span className=\"task-title\">{task.title}</span>\n-          {!task.done && (\n-            <button onClick={() => onComplete(task.id)} aria-label={`Complete ${task.title}`}>\n-              Done\n+      {tasks.map((task) =>\n+        task.id === editingId ? (\n+          <li key={task.id} className={task.done ? 'task done' : 'task'}>\n+            <form className=\"task-edit-form\" onSubmit={(e) => submitEdit(e, task)}>\n+              <input\n+                value={draft}\n+                onChange={(e) => setDraft(e.target.value)}\n+                onKeyDown={(e) => e.key === 'Escape' && cancelEdit()}\n+                aria-label={`Edit title for ${task.title}`}\n+                aria-invalid={validationError ? 'true' : undefined}\n+                aria-describedby={validationError ? `edit-error-${task.id}` : undefined}\n+                className={validationError ? 'task-edit-input invalid' : 'task-edit-input'}\n+                autoFocus\n+              />\n+              <button type=\"submit\" aria-label={`Save new title for ${task.title}`}>\n+                Save\n+              </button>\n+              <button type=\"button\" onClick={cancelEdit} aria-label={`Cancel editing ${task.title}`}>\n+                Cancel\n+              </button>\n+              {validationError && (\n+                <p className=\"task-edit-error\" role=\"alert\" id={`edit-error-${task.id}`}>\n+                  {validationError}\n+                </p>\n+              )}\n+            </form>\n+          </li>\n+        ) : (\n+          <li key={task.id} className={task.done ? 'task done' : 'task'}>\n+            <span className=\"task-title\">{task.title}</span>\n+            {!task.done && (\n+              <button onClick={() => onComplete(task.id)} aria-label={`Complete ${task.title}`}>\n+                Done\n+              </button>\n+            )}\n+            <button onClick={() => startEdit(task)} aria-label={`Edit ${task.title}`}>\n+              Edit\n+            </button>\n+            <button onClick={() => onDelete(task.id)} aria-label={`Delete ${task.title}`}>\n+              Delete\n             </button>\n-          )}\n-          <button onClick={() => onDelete(task.id)} aria-label={`Delete ${task.title}`}>\n-            Delete\n-          </button>\n-        </li>\n-      ))}\n+          </li>\n+        )\n+      )}\n     </ul>\n   )\n }", "meta": {"native_type": "user", "tool_use_id": "toolu_017u6xWeAUqpQEAXdqhp5yfG", "session_id": "0eebde98-5c8c-4448-8749-7a27e4e34a84"}}
