{"ts": "2026-08-17T10:29:58Z", "agent": "claude", "seq": 150, "kind": "tool_result", "text": "// Every network call goes through here: components never call fetch directly,\n// so the base URL and error handling stay in one place.\nconst BASE = import.meta.env.VITE_API_BASE || 'http://localhost:8000'\n\nasync function request(path, options = {}) {\n  const res = await fetch(BASE + path, {\n    headers: { 'Content-Type': 'application/json' },\n    ...options,\n  })\n  if (!res.ok) {\n    const detail = await res.json().catch(() => null)\n    throw new Error(detail?.detail || `request failed (${res.status})`)\n  }\n  return res.status === 204 ? null : res.json()\n}\n\nexport const listTasks = () => request('/api/tasks')\nexport const createTask = (title) =>\n  request('/api/tasks', { method: 'POST', body: JSON.stringify({ title }) })\nexport const completeTask = (id) => request(`/api/tasks/${id}/done`, { method: 'POST' })\n---\n164:    test_edit_input_has_a_distinct_accessible_name below), so this also\n176:def test_edit_input_has_a_distinct_accessible_name(page):\n262:def test_oversized_title_surfaces_an_unreadable_error(page):", "meta": {"native_type": "user", "tool_use_id": "toolu_017ashnxLAgcPyqQNs5D6PFp", "session_id": "0eebde98-5c8c-4448-8749-7a27e4e34a84"}}
