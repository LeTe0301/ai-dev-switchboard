{"ts": "2026-08-17T10:07:43Z", "agent": "claude", "seq": 30, "kind": "tool_result", "text": "1\tconst OPTIONS = [\n2\t  { value: 'all', label: 'All' },\n3\t  { value: 'open', label: 'Open' },\n4\t  { value: 'done', label: 'Done' },\n5\t]\n6\t\n7\texport default function TaskFilter({ value, onChange }) {\n8\t  return (\n9\t    <div className=\"task-filter\" role=\"group\" aria-label=\"Filter tasks\">\n10\t      {OPTIONS.map((opt) => (\n11\t        <button\n12\t          key={opt.value}\n13\t          type=\"button\"\n14\t          className={opt.value === value ? 'filter-option active' : 'filter-option'}\n15\t          aria-pressed={opt.value === value}\n16\t          onClick={() => onChange(opt.value)}\n17\t        >\n18\t          {opt.label}\n19\t        </button>\n20\t      ))}\n21\t    </div>\n22\t  )\n23\t}\n24\t", "meta": {"native_type": "user", "tool_use_id": "toolu_01CGDAwAmn6y8VGMyesYcXvc", "session_id": "8ad64417-0536-4ee5-b4e0-1d1bb9f67e6a"}}
