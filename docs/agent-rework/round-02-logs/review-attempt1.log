{"ts": "2026-08-17T10:15:21Z", "agent": "claude", "seq": 160, "kind": "tool_result", "text": "\"\"\"In-memory task store.\n\nDeliberately not a database: this project exists to exercise a development\npipeline, and a real datastore would add setup cost to every cycle without\nadding anything to test. Adding one is a decision, not an implementation\ndetail.\n\"\"\"\nfrom typing import Optional\n\nfrom .models import Task\n\n\nclass TaskStore:\n    def __init__(self):\n        self._tasks: dict[int, Task] = {}\n        self._next_id = 1\n\n    def list(self) -> list[Task]:\n        return [self._tasks[k] for k in sorted(self._tasks)]\n\n    def add(self, title: str) -> Task:\n        task = Task(id=self._next_id, title=title)\n        self._tasks[task.id] = task\n        self._next_id += 1\n        return task\n\n    def get(self, task_id: int) -> Optional[Task]:\n        return self._tasks.get(task_id)\n\n    def set_done(self, task_id: int, done: bool) -> Optional[Task]:\n        task = self._tasks.get(task_id)\n        if task is None:\n            return None\n        task.done = done\n        return task\n\n    def set_title(self, task_id: int, title: str) -> Optional[Task]:\n        task = self._tasks.get(task_id)\n        if task is None:\n            return None\n        task.title = title\n        return task\n\n    def delete(self, task_id: int) -> bool:\n        return self._tasks.pop(task_id, None) is not None", "meta": {"native_type": "user", "tool_use_id": "toolu_01XNJhsg7SUmnaG2W2cBunZe", "session_id": "e55e5722-705b-4388-9b58-e93f4aa20d7c"}}
