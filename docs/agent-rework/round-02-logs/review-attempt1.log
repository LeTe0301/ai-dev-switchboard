{"ts": "2026-08-17T10:14:08Z", "agent": "claude", "seq": 66, "kind": "tool_result", "text": "import { useState } from 'react'\n\nexport default function AddTask({ onAdd }) {\n  const [title, setTitle] = useState('')\n\n  function submit(e) {\n    e.preventDefault()\n    const trimmed = title.trim()\n    if (!trimmed) return\n    onAdd(trimmed)\n    setTitle('')\n  }\n\n  return (\n    <form className=\"add-task\" onSubmit={submit}>\n      <input\n        value={title}\n        onChange={(e) => setTitle(e.target.value)}\n        placeholder=\"What needs doing?\"\n        aria-label=\"Task title\"\n      />\n      <button type=\"submit\" disabled={!title.trim()}>Add</button>\n    </form>\n  )\n}\n---api.js---\n// Every network call goes through here: components never call fetch directly,\n// so the base URL and error handling stay in one place.\nconst BASE = import.meta.env.VITE_API_BASE || 'http://localhost:8000'\n\nasync function request(path, options = {}) {\n  const res = await fetch(BASE + path, {\n    headers: { 'Content-Type': 'application/json' },\n    ...options,\n  })\n  if (!res.ok) {\n    const detail = await res.json().catch(() => null)\n    throw new Error(detail?.detail || `request failed (${res.status})`)\n  }\n  return res.status === 204 ? null : res.json()\n}\n\nexport const listTasks = () => request('/api/tasks')\nexport const createTask = (title) =>\n  request('/api/tasks', { method: 'POST', body: JSON.stringify({ title }) })\nexport const completeTask = (id) => request(`/api/tasks/${id}/done`, { method: 'POST' })\nexport const updateTask = (id, title) =>\n  request(`/api/tasks/${id}`, { method: 'PATCH', body: JSON.stringify({ title }) })\nexport const deleteTask = (id) => request(`/api/tasks/${id}`, { method: 'DELETE' })", "meta": {"native_type": "user", "tool_use_id": "toolu_01RHgZnvShZfgMNJLcCnNFUz", "session_id": "e55e5722-705b-4388-9b58-e93f4aa20d7c"}}
