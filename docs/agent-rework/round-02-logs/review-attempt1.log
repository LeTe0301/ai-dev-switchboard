{"ts": "2026-08-17T10:13:50Z", "agent": "claude", "seq": 43, "kind": "tool_result", "text": "diff --git a/backend/app/main.py b/backend/app/main.py\nindex 808b5ca..58f3746 100644\n--- a/backend/app/main.py\n+++ b/backend/app/main.py\n@@ -37,6 +37,14 @@ def complete_task(task_id: int) -> Task:\n     return task\n \n \n+@app.patch(\"/api/tasks/{task_id}\", response_model=Task)\n+def update_task(task_id: int, payload: TaskIn) -> Task:\n+    task = store.set_title(task_id, payload.title)\n+    if task is None:\n+        raise HTTPException(status_code=404, detail=\"no such task\")\n+    return task\n+\n+\n @app.delete(\"/api/tasks/{task_id}\", status_code=204)\n def delete_task(task_id: int) -> None:\n     if not store.delete(task_id):\ndiff --git a/backend/app/store.py b/backend/app/store.py\nindex df0479c..355cdc7 100644\n--- a/backend/app/store.py\n+++ b/backend/app/store.py\n@@ -34,6 +34,13 @@ class TaskStore:\n         task.done = done\n         return task\n \n+    def set_title(self, task_id: int, title: str) -> Optional[Task]:\n+        task = self._tasks.get(task_id)\n+        if task is None:\n+            return None\n+        task.title = title\n+        return task\n+\n     def delete(self, task_id: int) -> bool:\n         return self._tasks.pop(task_id, None) is not None\n \ndiff --git a/backend/tests/test_tasks.py b/backend/tests/test_tasks.py\nindex 4cf1b25..d2a47d0 100644\n--- a/backend/tests/test_tasks.py\n+++ b/backend/tests/test_tasks.py\n@@ -39,3 +39,22 @@ def test_delete_removes_it(client):\n \n def test_deleting_a_missing_task_is_404(client):\n     assert client.delete(\"/api/tasks/999\").status_code == 404\n+\n+\n+def test_updating_a_task_changes_its_title(client):\n+    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\"}).json()[\"id\"]\n+    r = client.patch(f\"/api/tasks/{task_id}\", json={\"title\": \"y\"})\n+    assert r.status_code == 200\n+    assert r.json()[\"title\"] == \"y\"\n+    assert client.get(\"/api/tasks\").json()[0][\"title\"] == \"y\"\n+\n+\n+def test_updating_a_missing_task_is_404(client):\n+    assert client.patch(\"/api/tasks/999\", json={\"title\": \"y\"}).status_code == 404\n+\n+\n+def test_updating_with_an_empty_title_is_rejected(client):\n+    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\"}).json()[\"id\"]\n+    r = client.patch(f\"/api/tasks/{task_id}\", json={\"title\": \"\"})\n+    assert r.status_code == 422\n+    assert client.get(\"/api/tasks\").json()[0][\"title\"] == \"x\"\ndiff --git a/frontend/src/App.css b/frontend/src/App.css\nindex 56339d2..ef486a0 100644\n--- a/frontend/src/App.css\n+++ b/frontend/src/App.css\n@@ -30,6 +30,24 @@ button:disabled { opacity: 0.5; cursor: not-allowed; }\n .task-title { flex: 1; }\n .task.done .task-title { text-decoration: line-through; opacity: 0.55; }\n \n+.task-edit-form { display: contents; }\n+.task-edit-input {\n+  flex: 1;\n+  min-width: 0;\n+  padding: 0.55rem 0.7rem;\n+  border: 1px solid #ccd2d6;\n+  border-radius: 5px;\n+  font: inherit;\n+}\n+.task-edit-input.invalid { border-color: #a3271d; }\n+.task-edit-error {\n+  flex-basis: 100%;\n+  order: 1;\n+  color: #a3271d;\n+  font-size: 0.85rem;\n+  margin: 0.3rem 0 0;\n+}\n+\n .task-filter {\n   display: inline-flex;\n   border: 1px solid #ccd2d6;\ndiff --git a/frontend/src/App.jsx b/frontend/src/App.jsx\nindex be56a75..16fd171 100644\n--- a/frontend/src/App.jsx\n+++ b/frontend/src/App.jsx\n@@ -52,6 +52,7 @@ export default function App() {\n           tasks={visibleTasks}\n           filter={filter}\n           onComplete={(id) => run(() => api.completeTask(id))}\n+          onEdit={(id, title) => run(() => api.updateTask(id, title))}\n           onDelete={(id) => run(() => api.deleteTask(id))}\n         />\n       )}\ndiff --git a/frontend/src/api.js b/frontend/src/api.js\nindex 82fb123..83e4b26 100644\n--- a/frontend/src/api.js\n+++ b/frontend/src/api.js\n@@ -18,4 +18,6 @@ export const listTasks = () => request('/api/tasks')\n export const createTask = (title) =>\n   request('/api/tasks', { method: 'POST', body: JSON.stringify({ title }) })\n export const completeTask = (id) => request(`/api/tasks/${id}/done`, { method: 'POST' })\n+export const updateTask = (id, title) =>\n+  request(`/api/tasks/${id}`, { method: 'PATCH', body: JSON.stringify({ title }) })\n export const deleteTask = (id) => request(`/api/tasks/${id}`, { method: 'DELETE' })\ndiff --git a/frontend/src/components/TaskList.jsx b/frontend/src/components/TaskList.jsx\nindex 45df8ac..08ca676 100644\n--- a/frontend/src/components/TaskList.jsx\n+++ b/frontend/src/components/TaskList.jsx\n@@ -1,28 +1,89 @@\n+import { useState } from 'react'\n+\n const EMPTY_COPY = {\n   all: 'Nothing to do yet.',\n   open: 'Nothing open right now.',\n   done: 'Nothing done yet.',\n }\n \n-export default function TaskList({ tasks, filter, onComplete, onDelete }) {\n+export default function TaskList({ tasks, filter, onComplete, onEdit, onDelete }) {\n+  const [editingId, setEditingId] = useState(null)\n+  const [draft, setDraft] = useState('')\n+  const [validationError, setValidationError] = useState(null)\n+\n   if (tasks.length === 0) {\n     return <p className=\"empty\">{EMPTY_COPY[filter]}</p>\n   }\n+\n+  function startEdit(task) {\n+    setEditingId(task.id)\n+    setDraft(task.title)\n+    setValidationError(null)\n+  }\n+\n+  function cancelEdit() {\n+    setEditingId(null)\n+    setValidationError(null)\n+  }\n+\n+  function submitEdit(e, task) {\n+    e.preventDefault()\n+    const trimmed = draft.trim()\n+    if (!trimmed) {\n+      setValidationError(\"Title can't be empty.\")\n+      return\n+    }\n+    setEditingId(null)\n+    setValidationError(null)\n+    onEdit(task.id, trimmed)\n+  }\n+\n   return (\n     <ul className=\"task-list\">\n-      {tasks.map((task) => (\n-        <li key={task.id} className={task.done ? 'task done' : 'task'}>\n-          <span className=\"task-title\">{task.title}</span>\n-          {!task.done && (\n-            <button onClick={() => onComplete(task.id)} aria-label={`Complete ${task.title}`}>\n-              Done\n+      {tasks.map((task) =>\n+        task.id === editingId ? (\n+          <li key={task.id} className={task.done ? 'task done' : 'task'}>\n+            <form className=\"task-edit-form\" onSubmit={(e) => submitEdit(e, task)}>\n+              <input\n+                value={draft}\n+                onChange={(e) => setDraft(e.target.value)}\n+                onKeyDown={(e) => e.key === 'Escape' && cancelEdit()}\n+                aria-label=\"Task title\"\n+                aria-invalid={validationError ? 'true' : undefined}\n+                aria-describedby={validationError ? `edit-error-${task.id}` : undefined}\n+                className={validationError ? 'task-edit-input invalid' : 'task-edit-input'}\n+                autoFocus\n+              />\n+              <button type=\"submit\" aria-label={`Save new title for ${task.title}`}>\n+                Save\n+              </button>\n+              <button type=\"button\" onClick={cancelEdit} aria-label={`Cancel editing ${task.title}`}>\n+                Cancel\n+              </button>\n+              {validationError && (\n+                <p className=\"task-edit-error\" role=\"alert\" id={`edit-error-${task.id}`}>\n+                  {validationError}\n+                </p>\n+              )}\n+            </form>\n+          </li>\n+        ) : (\n+          <li key={task.id} className={task.done ? 'task done' : 'task'}>\n+            <span className=\"task-title\">{task.title}</span>\n+            {!task.done && (\n+              <button onClick={() => onComplete(task.id)} aria-label={`Complete ${task.title}`}>\n+                Done\n+              </button>\n+            )}\n+            <button onClick={() => startEdit(task)} aria-label={`Edit ${task.title}`}>\n+              Edit\n+            </button>\n+            <button onClick={() => onDelete(task.id)} aria-label={`Delete ${task.title}`}>\n+              Delete\n             </button>\n-          )}\n-          <button onClick={() => onDelete(task.id)} aria-label={`Delete ${task.title}`}>\n-            Delete\n-          </button>\n-        </li>\n-      ))}\n+          </li>\n+        )\n+      )}\n     </ul>\n   )\n }", "meta": {"native_type": "user", "tool_use_id": "toolu_012yRvJQ1hyC4aL4zFqgR5a3", "session_id": "e55e5722-705b-4388-9b58-e93f4aa20d7c"}}
