{"ts": "2026-08-17T10:44:13Z", "agent": "claude", "seq": 143, "kind": "tool_result", "text": "1\t\"\"\"Route wiring only -- behaviour lives in store.py.\"\"\"\n2\tfrom fastapi import FastAPI, HTTPException\n3\tfrom fastapi.middleware.cors import CORSMiddleware\n4\t\n5\tfrom .models import Task, TaskIn\n6\tfrom .store import store\n7\t\n8\tapp = FastAPI(title=\"test-project\")\n9\t\n10\t# A regex, not a fixed list: the dev server is reached as both localhost and\n11\t# 127.0.0.1, and the e2e harness binds it to a free port rather than 5173, so\n12\t# a hardcoded origin silently blocks every write from the browser while GETs\n13\t# keep working -- which reads as \"adding a task does nothing\".\n14\tapp.add_middleware(\n15\t    CORSMiddleware,\n16\t    allow_origin_regex=r\"http://(localhost|127\\.0\\.0\\.1):\\d+\",\n17\t    allow_methods=[\"*\"],\n18\t    allow_headers=[\"*\"],\n19\t)\n20\t\n21\t\n22\t@app.get(\"/api/tasks\", response_model=list[Task])\n23\tdef list_tasks() -> list[Task]:\n24\t    return store.list()\n25\t\n26\t\n27\t@app.post(\"/api/tasks\", response_model=Task, status_code=201)\n28\tdef create_task(payload: TaskIn) -> Task:\n29\t    return store.add(payload.title)\n30\t\n31\t\n32\t@app.post(\"/api/tasks/{task_id}/done\", response_model=Task)\n33\tdef complete_task(task_id: int) -> Task:\n34\t    task = store.set_done(task_id, True)\n35\t    if task is None:\n36\t        raise HTTPException(status_code=404, detail=\"no such task\")\n37\t    return task\n38\t\n39\t\n40\t@app.patch(\"/api/tasks/{task_id}\", response_model=Task)\n41\tdef update_task(task_id: int, payload: TaskIn) -> Task:\n42\t    task = store.update_title(task_id, payload.title)\n43\t    if task is None:\n44\t        raise HTTPException(status_code=404, detail=\"no such task\")\n45\t    return task\n46\t\n47\t\n48\t@app.delete(\"/api/tasks/{task_id}\", status_code=204)\n49\tdef delete_task(task_id: int) -> None:\n50\t    if not store.delete(task_id):\n51\t        raise HTTPException(status_code=404, detail=\"no such task\")\n52\t", "meta": {"native_type": "user", "tool_use_id": "toolu_015QvRRBZRk9mrCTDENtgryv", "session_id": "e57fba9e-0cb2-4bf7-b0c9-98e040eea1a9"}}
