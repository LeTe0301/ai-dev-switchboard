{"ts": "2026-08-17T10:41:50Z", "agent": "claude", "seq": 21, "kind": "tool_result", "text": "2437caee2b057a13637a3358f557b745ef168910\n63a04f7cd041d918365668c7d91c980c21ba122d\n---diff against working tree (uncommitted)---\ndiff --git a/backend/app/main.py b/backend/app/main.py\nindex 808b5ca..deb3498 100644\n--- a/backend/app/main.py\n+++ b/backend/app/main.py\n@@ -37,6 +37,14 @@ def complete_task(task_id: int) -> Task:\n     return task\n \n \n+@app.patch(\"/api/tasks/{task_id}\", response_model=Task)\n+def update_task(task_id: int, payload: TaskIn) -> Task:\n+    task = store.update_title(task_id, payload.title)\n+    if task is None:\n+        raise HTTPException(status_code=404, detail=\"no such task\")\n+    return task\n+\n+\n @app.delete(\"/api/tasks/{task_id}\", status_code=204)\n def delete_task(task_id: int) -> None:\n     if not store.delete(task_id):\ndiff --git a/backend/app/store.py b/backend/app/store.py\nindex df0479c..161b869 100644\n--- a/backend/app/store.py\n+++ b/backend/app/store.py\n@@ -34,6 +34,13 @@ class TaskStore:\n         task.done = done\n         return task\n \n+    def update_title(self, task_id: int, title: str) -> Optional[Task]:\n+        task = self._tasks.get(task_id)\n+        if task is None:\n+            return None\n+        task.title = title\n+        return task\n+\n     def delete(self, task_id: int) -> bool:\n         return self._tasks.pop(task_id, None) is not None\n \ndiff --git a/backend/tests/test_tasks.py b/backend/tests/test_tasks.py\nindex 4cf1b25..da1a352 100644\n--- a/backend/tests/test_tasks.py\n+++ b/backend/tests/test_tasks.py\n@@ -39,3 +39,29 @@ def test_delete_removes_it(client):\n \n def test_deleting_a_missing_task_is_404(client):\n     assert client.delete(\"/api/tasks/999\").status_code == 404\n+\n+\n+def test_updating_title_changes_it(client):\n+    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\"}).json()[\"id\"]\n+    r = client.patch(f\"/api/tasks/{task_id}\", json={\"title\": \"y\"})\n+    assert r.status_code == 200\n+    assert r.json()[\"title\"] == \"y\"\n+\n+\n+def test_updating_title_does_not_change_done_or_id(client):\n+    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\"}).json()[\"id\"]\n+    client.post(f\"/api/tasks/{task_id}/done\")\n+    body = client.patch(f\"/api/tasks/{task_id}\", json={\"title\": \"y\"}).json()\n+    assert body[\"id\"] == task_id\n+    assert body[\"done\"] is True\n+\n+\n+def test_updating_a_missing_task_is_404(client):\n+    assert client.patch(\"/api/tasks/999\", json={\"title\": \"y\"}).status_code == 404\n+\n+\n+def test_updating_with_empty_title_is_rejected(client):\n+    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\"}).json()[\"id\"]\n+    r = client.patch(f\"/api/tasks/{task_id}\", json={\"title\": \"\"})\n+    assert r.status_code == 422\n+    assert client.get(\"/api/tasks\").json()[0][\"title\"] == \"x\"\ndiff --git a/e2e/test_tasks_e2e.py b/e2e/test_tasks_e2e.py\nindex 23ca4a8..ccae100 100644\n--- a/e2e/test_tasks_e2e.py\n+++ b/e2e/test_tasks_e2e.py\n@@ -22,6 +22,10 @@ def complete_task(page, title):\n     page.get_by_role(\"button\", name=f\"Complete {title}\").click()\n \n \n+def start_edit(page, title):\n+    page.get_by_role(\"button\", name=f\"Edit {title}\").click()\n+\n+\n def test_empty_state_is_shown_first(page):\n     expect(page.get_by_text(\"Nothing to do yet.\")).to_be_visible()\n \n@@ -151,3 +155,70 @@ def test_done_filter_empty_state_when_no_task_done(page):\n     add_task(page, \"buy milk\")\n     select_filter(page, \"Done\")\n     expect(page.get_by_text(\"Nothing done yet.\")).to_be_visible()\n+\n+\n+def test_edit_button_opens_input_prefilled_with_current_title(page):\n+    add_task(page, \"buy milk\")\n+    start_edit(page, \"buy milk\")\n+    expect(page.get_by_label(\"Title for buy milk\")).to_have_value(\"buy milk\")\n+\n+\n+def test_saving_an_edited_title_updates_the_list(page):\n+    add_task(page, \"buy milk\")\n+    start_edit(page, \"buy milk\")\n+    page.get_by_label(\"Title for buy milk\").fill(\"buy oat milk\")\n+    page.get_by_role(\"button\", name=\"Save\").click()\n+    expect(page.get_by_text(\"buy oat milk\")).to_be_visible()\n+    expect(page.get_by_text(\"buy milk\", exact=True)).to_have_count(0)\n+\n+\n+def test_saving_an_edit_closes_edit_mode(page):\n+    add_task(page, \"buy milk\")\n+    start_edit(page, \"buy milk\")\n+    page.get_by_label(\"Title for buy milk\").fill(\"buy oat milk\")\n+    page.get_by_role(\"button\", name=\"Save\").click()\n+    expect(page.get_by_role(\"button\", name=\"Edit buy oat milk\")).to_be_visible()\n+    expect(page.get_by_label(\"Title for buy milk\")).to_have_count(0)\n+\n+\n+def test_cancelling_an_edit_reverts_the_title_and_makes_no_backend_call(page):\n+    add_task(page, \"buy milk\")\n+    start_edit(page, \"buy milk\")\n+    page.get_by_label(\"Title for buy milk\").fill(\"buy oat milk\")\n+    page.get_by_role(\"button\", name=\"Cancel\").click()\n+    expect(page.get_by_text(\"buy milk\", exact=True)).to_be_visible()\n+    expect(page.get_by_text(\"buy oat milk\")).to_have_count(0)\n+\n+\n+def test_save_is_disabled_when_title_is_cleared(page):\n+    add_task(page, \"buy milk\")\n+    start_edit(page, \"buy milk\")\n+    page.get_by_label(\"Title for buy milk\").fill(\"\")\n+    expect(page.get_by_role(\"button\", name=\"Save\")).to_be_disabled()\n+\n+\n+def test_submitting_an_empty_title_is_rejected(page):\n+    add_task(page, \"buy milk\")\n+    start_edit(page, \"buy milk\")\n+    page.get_by_label(\"Title for buy milk\").fill(\"\")\n+    page.get_by_label(\"Title for buy milk\").press(\"Enter\")\n+    expect(page.get_by_text(\"Title can't be empty\")).to_be_visible()\n+    expect(page.get_by_role(\"button\", name=\"Edit buy milk\")).to_have_count(0)\n+\n+\n+def test_submitting_a_whitespace_only_title_is_rejected(page):\n+    add_task(page, \"buy milk\")\n+    start_edit(page, \"buy milk\")\n+    page.get_by_label(\"Title for buy milk\").fill(\"   \")\n+    page.get_by_label(\"Title for buy milk\").press(\"Enter\")\n+    expect(page.get_by_text(\"Title can't be empty\")).to_be_visible()\n+\n+\n+def test_editing_does_not_change_done_state(page):\n+    add_task(page, \"buy milk\")\n+    complete_task(page, \"buy milk\")\n+    start_edit(page, \"buy milk\")\n+    page.get_by_label(\"Title for buy milk\").fill(\"buy oat milk\")\n+    page.get_by_role(\"button\", name=\"Save\").click()\n+    expect(page.locator(\"li.task.done\")).to_have_count(1)\n+    expect(page.get_by_text(\"buy oat milk\")).to_be_visible()\ndiff --git a/frontend/src/App.css b/frontend/src/App.css\nindex 56339d2..6d69b79 100644\n--- a/frontend/src/App.css\n+++ b/frontend/src/App.css\n@@ -51,3 +51,18 @@ button:disabled { opacity: 0.5; cursor: not-allowed; }\n \n .empty, .loading { color: #6b7780; }\n .error { color: #a3271d; background: #fbe9e7; padding: 0.6rem 0.8rem; border-radius: 5px; }\n+\n+.task-edit { display: flex; gap: 0.5rem; flex: 1; align-items: center; }\n+.task-title-input {\n+  flex: 1;\n+  padding: 0.55rem 0.7rem;\n+  border: 1px solid #ccd2d6;\n+  border-radius: 5px;\n+  font: inherit;\n+}\n+.field-error {\n+  color: #a3271d;\n+  font-size: 0.85rem;\n+  margin: 0.3rem 0 0;\n+  flex-basis: 100%;\n+}\ndiff --git a/frontend/src/App.jsx b/frontend/src/App.jsx\nindex be56a75..1707311 100644\n--- a/frontend/src/App.jsx\n+++ b/frontend/src/App.jsx\n@@ -34,8 +34,10 @@ export default function App() {\n     try {\n       await fn()\n       await refresh()\n+      return true\n     } catch (e) {\n       setError(e.message)\n+      return false\n     }\n   }\n \n@@ -53,6 +55,7 @@ export default function App() {\n           filter={filter}\n           onComplete={(id) => run(() => api.completeTask(id))}\n           onDelete={(id) => run(() => api.deleteTask(id))}\n+          onUpdate={(id, title) => run(() => api.updateTask(id, title))}\n         />\n       )}\n     </main>\ndiff --git a/frontend/src/api.js b/frontend/src/api.js\nindex 82fb123..83e4b26 100644\n--- a/frontend/src/api.js\n+++ b/frontend/src/api.js\n@@ -18,4 +18,6 @@ export const listTasks = () => request('/api/tasks')\n export const createTask = (title) =>\n   request('/api/tasks', { method: 'POST', body: JSON.stringify({ title }) })\n export const completeTask = (id) => request(`/api/tasks/${id}/done`, { method: 'POST' })\n+export const updateTask = (id, title) =>\n+  request(`/api/tasks/${id}`, { method: 'PATCH', body: JSON.stringify({ title }) })\n export const deleteTask = (id) => request(`/api/tasks/${id}`, { method: 'DELETE' })\ndiff --git a/frontend/src/components/TaskList.jsx b/frontend/src/components/TaskList.jsx\nindex 45df8ac..b101a70 100644\n--- a/frontend/src/components/TaskList.jsx\n+++ b/frontend/src/components/TaskList.jsx\n@@ -1,28 +1,100 @@\n+import { useState } from 'react'\n+\n const EMPTY_COPY = {\n   all: 'Nothing to do yet.',\n   open: 'Nothing open right now.',\n   done: 'Nothing done yet.',\n }\n \n-export default function TaskList({ tasks, filter, onComplete, onDelete }) {\n+export default function TaskList({ tasks, filter, onComplete, onDelete, onUpdate }) {\n   if (tasks.length === 0) {\n     return <p className=\"empty\">{EMPTY_COPY[filter]}</p>\n   }\n   return (\n     <ul className=\"task-list\">\n       {tasks.map((task) => (\n-        <li key={task.id} className={task.done ? 'task done' : 'task'}>\n-          <span className=\"task-title\">{task.title}</span>\n-          {!task.done && (\n-            <button onClick={() => onComplete(task.id)} aria-label={`Complete ${task.title}`}>\n-              Done\n-            </button>\n-          )}\n-          <button onClick={() => onDelete(task.id)} aria-label={`Delete ${task.title}`}>\n-            Delete\n-          </button>\n-        </li>\n+        <TaskRow\n+          key={task.id}\n+          task={task}\n+          onComplete={onComplete}\n+          onDelete={onDelete}\n+          onUpdate={onUpdate}\n+        />\n       ))}\n     </ul>\n   )\n }\n+\n+function TaskRow({ task, onComplete, onDelete, onUpdate }) {\n+  const [isEditing, setIsEditing] = useState(false)\n+  const [draft, setDraft] = useState(task.title)\n+  const [showError, setShowError] = useState(false)\n+\n+  function startEdit() {\n+    setDraft(task.title)\n+    setShowError(false)\n+    setIsEditing(true)\n+  }\n+\n+  function cancel() {\n+    setDraft(task.title)\n+    setShowError(false)\n+    setIsEditing(false)\n+  }\n+\n+  async function submit(e) {\n+    e.preventDefault()\n+    const trimmed = draft.trim()\n+    if (!trimmed) {\n+      setShowError(true)\n+      return\n+    }\n+    const ok = await onUpdate(task.id, trimmed)\n+    if (ok) setIsEditing(false)\n+  }\n+\n+  if (isEditing) {\n+    return (\n+      <li className={task.done ? 'task done' : 'task'}>\n+        <form\n+          className=\"task-edit\"\n+          onSubmit={submit}\n+          onKeyDown={(e) => {\n+            if (e.key === 'Escape') cancel()\n+            // A disabled Save button blocks the browser's native implicit\n+            // submit-on-Enter, so an empty draft would never reach submit()\n+            // to show the error. Handling Enter here bypasses that.\n+            if (e.key === 'Enter') { e.preventDefault(); submit(e) }\n+          }}\n+        >\n+          <input\n+            className=\"task-title-input\"\n+            value={draft}\n+            onChange={(e) => { setDraft(e.target.value); setShowError(false) }}\n+            aria-label={`Title for ${task.title}`}\n+            autoFocus\n+            onFocus={(e) => e.target.select()}\n+          />\n+          <button type=\"submit\" disabled={!draft.trim()}>Save</button>\n+          <button type=\"button\" onClick={cancel}>Cancel</button>\n+        </form>\n+        {showError && <p className=\"field-error\" role=\"alert\">Title can't be empty</p>}\n+      </li>\n+    )\n+  }\n+\n+  return (\n+    <li className={task.done ? 'task done' : 'task'}>\n+      <span className=\"task-title\">{task.title}</span>\n+      <button onClick={startEdit} aria-label={`Edit ${task.title}`}>Edit</button>\n+      {!task.done && (\n+        <button onClick={() => onComplete(task.id)} aria-label={`Complete ${task.title}`}>\n+          Done\n+        </button>\n+      )}\n+      <button onClick={() => onDelete(task.id)} aria-label={`Delete ${task.title}`}>\n+        Delete\n+      </button>\n+    </li>\n+  )\n+}", "meta": {"native_type": "user", "tool_use_id": "toolu_01RJrRZ3YhHVUpmKJqBsd3n2", "session_id": "e57fba9e-0cb2-4bf7-b0c9-98e040eea1a9"}}
