{"ts": "2026-08-17T10:44:55Z", "agent": "claude", "seq": 35, "kind": "tool_result", "text": "1\timport { useState } from 'react'\n2\t\n3\tconst EMPTY_COPY = {\n4\t  all: 'Nothing to do yet.',\n5\t  open: 'Nothing open right now.',\n6\t  done: 'Nothing done yet.',\n7\t}\n8\t\n9\texport default function TaskList({ tasks, filter, onComplete, onDelete, onUpdate }) {\n10\t  if (tasks.length === 0) {\n11\t    return <p className=\"empty\">{EMPTY_COPY[filter]}</p>\n12\t  }\n13\t  return (\n14\t    <ul className=\"task-list\">\n15\t      {tasks.map((task) => (\n16\t        <TaskRow\n17\t          key={task.id}\n18\t          task={task}\n19\t          onComplete={onComplete}\n20\t          onDelete={onDelete}\n21\t          onUpdate={onUpdate}\n22\t        />\n23\t      ))}\n24\t    </ul>\n25\t  )\n26\t}\n27\t\n28\tfunction TaskRow({ task, onComplete, onDelete, onUpdate }) {\n29\t  const [isEditing, setIsEditing] = useState(false)\n30\t  const [draft, setDraft] = useState(task.title)\n31\t  const [showError, setShowError] = useState(false)\n32\t\n33\t  function startEdit() {\n34\t    setDraft(task.title)\n35\t    setShowError(false)\n36\t    setIsEditing(true)\n37\t  }\n38\t\n39\t  function cancel() {\n40\t    setDraft(task.title)\n41\t    setShowError(false)\n42\t    setIsEditing(false)\n43\t  }\n44\t\n45\t  async function submit(e) {\n46\t    e.preventDefault()\n47\t    const trimmed = draft.trim()\n48\t    if (!trimmed) {\n49\t      setShowError(true)\n50\t      return\n51\t    }\n52\t    const ok = await onUpdate(task.id, trimmed)\n53\t    if (ok) setIsEditing(false)\n54\t  }\n55\t\n56\t  if (isEditing) {\n57\t    return (\n58\t      <li className={task.done ? 'task done' : 'task'}>\n59\t        <form\n60\t          className=\"task-edit\"\n61\t          onSubmit={submit}\n62\t          onKeyDown={(e) => {\n63\t            if (e.key === 'Escape') cancel()\n64\t            // A disabled Save button blocks the browser's native implicit\n65\t            // submit-on-Enter, so an empty draft would never reach submit()\n66\t            // to show the error. Handling Enter here bypasses that.\n67\t            if (e.key === 'Enter') { e.preventDefault(); submit(e) }\n68\t          }}\n69\t        >\n70\t          <input\n71\t            className=\"task-title-input\"\n72\t            value={draft}\n73\t            onChange={(e) => { setDraft(e.target.value); setShowError(false) }}\n74\t            aria-label={`Title for ${task.title}`}\n75\t            autoFocus\n76\t            onFocus={(e) => e.target.select()}\n77\t          />\n78\t          <button type=\"submit\" disabled={!draft.trim()}>Save</button>\n79\t          <button type=\"button\" onClick={cancel}>Cancel</button>\n80\t        </form>\n81\t        {showError && <p className=\"field-error\" role=\"alert\">Title can't be empty</p>}\n82\t      </li>\n83\t    )\n84\t  }\n85\t\n86\t  return (\n87\t    <li className={task.done ? 'task done' : 'task'}>\n88\t      <span className=\"task-title\">{task.title}</span>\n89\t      <button onClick={startEdit} aria-label={`Edit ${task.title}`}>Edit</button>\n90\t      {!task.done && (\n91\t        <button onClick={() => onComplete(task.id)} aria-label={`Complete ${task.title}`}>\n92\t          Done\n93\t        </button>\n94\t      )}\n95\t      <button onClick={() => onDelete(task.id)} aria-label={`Delete ${task.title}`}>\n96\t        Delete\n97\t      </button>\n98\t    </li>\n99\t  )\n100\t}\n101\t", "meta": {"native_type": "user", "tool_use_id": "toolu_01G6uKGzHXPSyQvukeAZo9aV", "session_id": "9300d63a-d472-43a8-ba5f-b94b91e24ec9"}}
