{"ts": "2026-08-17T10:16:50Z", "agent": "claude", "seq": 27, "kind": "tool_result", "text": "diff --git a/backend/app/main.py b/backend/app/main.py\nindex 808b5ca..58f3746 100644\n--- a/backend/app/main.py\n+++ b/backend/app/main.py\n@@ -37,6 +37,14 @@ def complete_task(task_id: int) -> Task:\n     return task\n \n \n+@app.patch(\"/api/tasks/{task_id}\", response_model=Task)\n+def update_task(task_id: int, payload: TaskIn) -> Task:\n+    task = store.set_title(task_id, payload.title)\n+    if task is None:\n+        raise HTTPException(status_code=404, detail=\"no such task\")\n+    return task\n+\n+\n @app.delete(\"/api/tasks/{task_id}\", status_code=204)\n def delete_task(task_id: int) -> None:\n     if not store.delete(task_id):\ndiff --git a/backend/app/store.py b/backend/app/store.py\nindex df0479c..355cdc7 100644\n--- a/backend/app/store.py\n+++ b/backend/app/store.py\n@@ -34,6 +34,13 @@ class TaskStore:\n         task.done = done\n         return task\n \n+    def set_title(self, task_id: int, title: str) -> Optional[Task]:\n+        task = self._tasks.get(task_id)\n+        if task is None:\n+            return None\n+        task.title = title\n+        return task\n+\n     def delete(self, task_id: int) -> bool:\n         return self._tasks.pop(task_id, None) is not None\n \ndiff --git a/backend/tests/test_tasks.py b/backend/tests/test_tasks.py\nindex 4cf1b25..d2a47d0 100644\n--- a/backend/tests/test_tasks.py\n+++ b/backend/tests/test_tasks.py\n@@ -39,3 +39,22 @@ def test_delete_removes_it(client):\n \n def test_deleting_a_missing_task_is_404(client):\n     assert client.delete(\"/api/tasks/999\").status_code == 404\n+\n+\n+def test_updating_a_task_changes_its_title(client):\n+    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\"}).json()[\"id\"]\n+    r = client.patch(f\"/api/tasks/{task_id}\", json={\"title\": \"y\"})\n+    assert r.status_code == 200\n+    assert r.json()[\"title\"] == \"y\"\n+    assert client.get(\"/api/tasks\").json()[0][\"title\"] == \"y\"\n+\n+\n+def test_updating_a_missing_task_is_404(client):\n+    assert client.patch(\"/api/tasks/999\", json={\"title\": \"y\"}).status_code == 404\n+\n+\n+def test_updating_with_an_empty_title_is_rejected(client):\n+    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\"}).json()[\"id\"]\n+    r = client.patch(f\"/api/tasks/{task_id}\", json={\"title\": \"\"})\n+    assert r.status_code == 422\n+    assert client.get(\"/api/tasks\").json()[0][\"title\"] == \"x\"", "meta": {"native_type": "user", "tool_use_id": "toolu_01GLwWxws1X4a84znRqHEfQ8", "session_id": "a37ae859-7a64-42e7-931c-2398d2ba4b7e"}}
