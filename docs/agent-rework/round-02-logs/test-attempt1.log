   assert r.status_code == 200\n48\t    assert r.json()[\"title\"] == \"y\"\n49\t    assert client.get(\"/api/tasks\").json()[0][\"title\"] == \"y\"\n50\t\n51\t\n52\tdef test_updating_a_missing_task_is_404(client):\n53\t    assert client.patch(\"/api/tasks/999\", json={\"title\": \"y\"}).status_code == 404\n54\t\n55\t\n56\tdef test_updating_with_an_empty_title_is_rejected(client):\n57\t    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\"}).json()[\"id\"]\n58\t    r = client.patch(f\"/api/tasks/{task_id}\", json={\"title\": \"\"})\n59\t    assert r.status_code == 422\n60\t    assert client.get(\"/api/tasks\").json()[0][\"title\"] == \"x\"\n61\t", "meta": {"native_type": "user", "tool_use_id": "toolu_018NL8adUhUn2hBq2ZYtiqfV", "session_id": "a37ae859-7a64-42e7-931c-2398d2ba4b7e"}}
