age.get_by_label(\"Task title\").fill(\"something else entirely\")\n    page.get_by_label(\"Task title\").press(\"Escape\")\n    expect(page.get_by_text(\"buy milk\")).to_be_visible()\n    expect(page.get_by_text(\"something else entirely\")).to_have_count(0)\n\n\ndef test_empty_title_is_rejected_and_task_keeps_its_title(page):\n    add_task(page, \"buy milk\")\n    start_edit(page, \"buy milk\")\n    page.get_by_label(\"Task title\").fill(\"\")\n    page.get_by_role(\"button\", name=\"Save new title for buy milk\").click()\n    expect(page.get_by_role(\"alert\").filter(has_text=\"empty\")).to_be_visible()\n    # still in edit mode, title unchanged once cancelled\n    page.get_by_label(\"Task title\").press(\"Escape\")\n    expect(page.get_by_text(\"buy milk\")).to_be_visible()\n\n\ndef test_whitespace_only_title_is_rejected(page):\n    add_task(page, \"buy milk\")\n    start_edit(page, \"buy milk\")\n    page.get_by_label(\"Task title\").fill(\"   \")\n    page.get_by_role(\"button\", name=\"Save new title for buy milk\").click()\n    expect(page.get_by_role(\"alert\").filter(has_text=\"empty\")).to_be_visible()\n\n\ndef test_editing_a_done_task_is_allowed(page):\n    add_task(page, \"buy milk\")\n    complete_task(page, \"buy milk\")\n    start_edit(page, \"buy milk\")\n    page.get_by_label(\"Task title\").fill(\"buy oat milk\")\n    page.get_by_role(\"button\", name=\"Save new title for buy milk\").click()\n    expect(page.get_by_text(\"buy oat milk\")).to_be_visible()\n\n\ndef test_starting_a_second_edit_closes_the_first_without_saving(page):\n    add_task(page, \"buy milk\")\n    add_task(page, \"walk dog\")\n    start_edit(page, \"buy milk\")\n    page.get_by_label(\"Task title\").fill(\"this draft is discarded\")\n    start_edit(page, \"walk dog\")\n    expect(page.get_by_text(\"buy milk\")).to_be_visible()\n    expect(page.get_by_text(\"this draft is discarded\")).to_have_count(0)", "new_string": "def start_edit(page, title):\n    page.get_by_role(\"button\", name=f\"Edit {title}\").click()\n\n\ndef edit_input(page):\n    \"\"\"Scoped to the task list, not the always-present AddTask input.\n\n    Both inputs share aria-label=\"Task title\" (see\n    test_edit_input_shares_the_add_tasks_accessible_name below), so an\n    unscoped get_by_label(\"Task title\") is ambiguous the moment any row is\n    in edit mode. This helper works around that in the test suite; the\n    underlying duplicate label is a real defect, not a test artifact.\n    \"\"\"\n    return page.locator(\"ul.task-list\").get_by_label(\"Task title\")\n\n\ndef test_editing_shows_an_input_prefilled_with_the_current_title(page):\n    add_task(page, \"buy milk\")\n    start_edit(page, \"buy milk\")\n    expect(edit_input(page)).to_have_value(\"buy milk\")\n\n\ndef test_edit_input_shares_the_add_tasks_accessible_name(page):\n    \"\"\"Documents a real defect (not desired behaviour): while a row is in\n    edit mode, the page has two text inputs both accessibly named \"Task\n    title\" -- the always-present AddTask input and this row's edit input.\n    Screen-reader and other accessible-name-based tooling cannot\n    distinguish them. See docs/design.md:200-203, which only reasoned\n    about collisions between multiple task rows and missed the\n    always-rendered AddTask input entirely.\"\"\"\n    add_task(page, \"buy milk\")\n    start_edit(page, \"buy milk\")\n    expect(page.get_by_label(\"Task title\")).to_have_count(2)\n\n\ndef test_saving_a_new_title_updates_the_list(page):\n    add_task(page, \"buy milk\")\n    start_edit(page, \"buy milk\")\n    edit_input(page).fill(\"buy oat milk\")\n    page.get_by_role(\"button\", name=\"Save new title for buy milk\").click()\n    expect(page.get_by_text(\"buy oat milk\")).to_be_visible()\n    expect(page.get_by_text(\"buy milk\", exact=True)).to_have_count(0)\n\n\ndef test_saved_title_survives_a_reload(page):\n    add_task(page, \"buy milk\")\n    start_edit(page, \"buy milk\")\n    edit_input(page).fill(\"buy oat milk\")\n    page.get_by_role(\"button\", name=\"Save new title for buy milk\").click()\n    expect(page.get_by_text(\"buy oat milk\")).to_be_visible()\n    page.reload()\n    expect(page.get_by_text(\"buy oat milk\")).to_be_visible()\n\n\ndef test_cancel_button_reverts_without_saving(page):\n    add_task(page, \"buy milk\")\n    start_edit(page, \"buy milk\")\n    edit_input(page).fill(\"something else entirely\")\n    page.get_by_role(\"button\", name=\"Cancel editing buy milk\").click()\n    expect(page.get_by_text(\"buy milk\")).to_be_visible()\n    expect(page.get_by_text(\"something else entirely\")).to_have_count(0)\n\n\ndef test_escape_reverts_without_saving(page):\n    add_task(page, \"buy milk\")\n    start_edit(page, \"buy milk\")\n    edit_input(page).fill(\"something else entirely\")\n    edit_input(page).press(\"Escape\")\n    expect(page.get_by_text(\"buy milk\")).to_be_visible()\n    expect(page.get_by_text(\"something else entirely\")).to_have_count(0)\n\n\ndef test_empty_title_is_rejected_and_task_keeps_its_title(page):\n    add_task(page, \"buy milk\")\n    start_edit(page, \"buy milk\")\n    edit_input(page).fill(\"\")\n    page.get_by_role(\"button\", name=\"Save new title for buy milk\").click()\n    expect(page.get_by_role(\"alert\").filter(has_text=\"empty\")).to_be_visible()\n    # still in edit mode, title unchanged once cancelled\n    edit_input(page).press(\"Escape\")\n    expect(page.get_by_text(\"buy milk\")).to_be_visible()\n\n\ndef test_whitespace_only_title_is_rejected(page):\n    add_task(page, \"buy milk\")\n    start_edit(page, \"buy milk\")\n    edit_input(page).fill(\"   \")\n    page.get_by_role(\"button\", name=\"Save new title for buy milk\").click()\n    expect(page.get_by_role(\"alert\").filter(has_text=\"empty\")).to_be_visible()\n\n\ndef test_editing_a_done_task_is_allowed(page):\n    add_task(page, \"buy milk\")\n    complete_task(page, \"buy milk\")\n    start_edit(page, \"buy milk\")\n    edit_input(page).fill(\"buy oat milk\")\n    page.get_by_role(\"button\", name=\"Save new title for buy milk\").click()\n    expect(page.get_by_text(\"buy oat milk\")).to_be_visible()\n\n\ndef test_starting_a_second_edit_closes_the_first_without_saving(page):\n    add_task(page, \"buy milk\")\n    add_task(page, \"walk dog\")\n    start_edit(page, \"buy milk\")\n    edit_input(page).fill(\"this draft is discarded\")\n    start_edit(page, \"walk dog\")\n    expect(page.get_by_text(\"buy milk\")).to_be_visible()\n    expect(page.get_by_text(\"this draft is discarded\")).to_have_count(0)"}, "session_id": "a37ae859-7a64-42e7-931c-2398d2ba4b7e"}}
