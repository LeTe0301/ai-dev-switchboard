{"ts": "2026-08-17T10:45:07Z", "agent": "claude", "seq": 56, "kind": "tool_result", "text": "\"\"\"Brings the whole app up for a browser test, then tears it down.\n\nBoth servers are started on ports derived from a free-port probe rather than\nhardcoded, so an e2e run does not collide with a dev server someone left\nrunning.\n\"\"\"\nimport json\nimport os\nimport signal\nimport socket\nimport subprocess\nimport sys\nimport time\nimport urllib.request\n\nimport pytest\n\nROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\n\n\ndef _free_port():\n    with socket.socket() as s:\n        s.bind((\"127.0.0.1\", 0))\n        return s.getsockname()[1]\n\n\ndef _wait_for(url, timeout=60):\n    deadline = time.time() + timeout\n    while time.time() < deadline:\n        try:\n            urllib.request.urlopen(url, timeout=2)\n            return True\n        except Exception:\n            time.sleep(0.4)\n    return False\n\n\ndef _stop_group(proc):\n    \"\"\"Signal the whole process group, then escalate. Killing just `proc`\n    leaves npm's vite child running forever.\"\"\"\n    if proc.poll() is not None:\n        return\n    for sig in (signal.SIGTERM, signal.SIGKILL):\n        try:\n            os.killpg(os.getpgid(proc.pid), sig)\n        except (ProcessLookupError, PermissionError):\n            return\n        try:\n            proc.wait(timeout=10)\n            return\n        except subprocess.TimeoutExpired:\n            continue\n\n\n@pytest.fixture(scope=\"session\")\ndef _servers():\n    api_port = _free_port()\n    web_port = _free_port()\n\n    # start_new_session puts each server in its own process GROUP so the whole", "meta": {"native_type": "user", "tool_use_id": "toolu_01TUSci8QfpEpdNLvXisGbob", "session_id": "9300d63a-d472-43a8-ba5f-b94b91e24ec9"}}
