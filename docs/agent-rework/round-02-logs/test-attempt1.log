{"ts": "2026-08-17T10:16:53Z", "agent": "claude", "seq": 30, "kind": "tool_result", "text": "diff --git a/frontend/src/App.css b/frontend/src/App.css\nindex 56339d2..ef486a0 100644\n--- a/frontend/src/App.css\n+++ b/frontend/src/App.css\n@@ -30,6 +30,24 @@ button:disabled { opacity: 0.5; cursor: not-allowed; }\n .task-title { flex: 1; }\n .task.done .task-title { text-decoration: line-through; opacity: 0.55; }\n \n+.task-edit-form { display: contents; }\n+.task-edit-input {\n+  flex: 1;\n+  min-width: 0;\n+  padding: 0.55rem 0.7rem;\n+  border: 1px solid #ccd2d6;\n+  border-radius: 5px;\n+  font: inherit;\n+}\n+.task-edit-input.invalid { border-color: #a3271d; }\n+.task-edit-error {\n+  flex-basis: 100%;\n+  order: 1;\n+  color: #a3271d;\n+  font-size: 0.85rem;\n+  margin: 0.3rem 0 0;\n+}\n+\n .task-filter {\n   display: inline-flex;\n   border: 1px solid #ccd2d6;\ndiff --git a/frontend/src/App.jsx b/frontend/src/App.jsx\nindex be56a75..16fd171 100644\n--- a/frontend/src/App.jsx\n+++ b/frontend/src/App.jsx\n@@ -52,6 +52,7 @@ export default function App() {\n           tasks={visibleTasks}\n           filter={filter}\n           onComplete={(id) => run(() => api.completeTask(id))}\n+          onEdit={(id, title) => run(() => api.updateTask(id, title))}\n           onDelete={(id) => run(() => api.deleteTask(id))}\n         />\n       )}\ndiff --git a/frontend/src/api.js b/frontend/src/api.js\nindex 82fb123..83e4b26 100644\n--- a/frontend/src/api.js\n+++ b/frontend/src/api.js\n@@ -18,4 +18,6 @@ export const listTasks = () => request('/api/tasks')\n export const createTask = (title) =>\n   request('/api/tasks', { method: 'POST', body: JSON.stringify({ title }) })\n export const completeTask = (id) => request(`/api/tasks/${id}/done`, { method: 'POST' })\n+export const updateTask = (id, title) =>\n+  request(`/api/tasks/${id}`, { method: 'PATCH', body: JSON.stringify({ title }) })\n export const deleteTask = (id) => request(`/api/tasks/${id}`, { method: 'DELETE' })\ndiff --git a/frontend/src/components/TaskList.jsx b/frontend/src/components/TaskList.jsx\nindex 45df8ac..08ca676 100644\n--- a/frontend/src/components/TaskList.jsx\n+++ b/frontend/src/components/TaskList.jsx\n@@ -1,28 +1,89 @@\n+import { useState } from 'react'\n+\n const EMPTY_COPY = {\n   all: 'Nothing to do yet.',\n   open: 'Nothing open right now.',\n   done: 'Nothing done yet.',\n }\n \n-export default function TaskList({ tasks, filter, onComplete, onDelete }) {\n+export default function TaskList({ tasks, filter, onComplete, onEdit, onDelete }) {\n+  const [editingId, setEditingId] = useState(null)\n+  const [draft, setDraft] = useState('')\n+  const [validationError, setValidationError] = useState(null)\n+\n   if (tasks.length === 0) {\n     return <p className=\"empty\">{EMPTY_COPY[filter]}</p>\n   }\n+\n+  function startEdit(task) {\n+    setEditingId(task.id)\n+    setDraft(task.title)\n+    setValidationError(null)\n+  }\n+\n+  function cancelEdit() {\n+    setEditingId(null)\n+    setValidationError(null)\n+  }\n+\n+  function submitEdit(e, task) {\n+    e.preventDefault()\n+    const trimmed = draft.trim()\n+    if (!trimmed) {\n+      setValidationError(\"Title can't be empty.\")\n+      return\n+    }\n+    setEditingId(null)\n+    setValidationError(null)\n+    onEdit(task.id, trimmed)\n+  }\n+\n   return (\n     <ul className=\"task-list\">\n-      {tasks.map((task) => (\n-        <li key={task.id} className={task.done ? 'task done' : 'task'}>\n-          <span className=\"task-title\">{task.title}</span>\n-          {!task.done && (\n-            <button onClick={() => onComplete(task.id)} aria-label={`Complete ${task.title}`}>\n-              Done\n+      {tasks.map((task) =>\n+        task.id === editingId ? (\n+          <li key={task.id} className={task.done ? 'task done' : 'task'}>\n+            <form className=\"task-edit-form\" onSubmit={(e) => submitEdit(e, task)}>\n+              <input\n+                value={draft}\n+                onChange={(e) => setDraft(e.target.value)}\n+                onKeyDown={(e) => e.key === 'Escape' && cancelEdit()}\n+                aria-label=\"Task title\"\n+                aria-invalid={validationError ? 'true' : undefined}\n+                aria-describedby={validationError ? `edit-error-${task.id}` : undefined}\n+                className={validationError ? 'task-edit-input invalid' : 'task-edit-input'}\n+                autoFocus\n+              />\n+              <button type=\"submit\" aria-label={`Save new title for ${task.title}`}>\n+                Save\n+              </button>\n+              <button type=\"button\" onClick={cancelEdit} aria-label={`Cancel editing ${task.title}`}>\n+                Cancel\n+              </button>\n+              {validationError && (\n+                <p className=\"task-edit-error\" role=\"alert\" id={`edit-error-${task.id}`}>\n+                  {validationError}\n+                </p>\n+              )}\n+            </form>\n+          </li>\n+        ) : (\n+          <li key={task.id} className={task.done ? 'task done' : 'task'}>\n+            <span className=\"task-title\">{task.title}</span>\n+            {!task.done && (\n+              <button onClick={() => onComplete(task.id)} aria-label={`Complete ${task.title}`}>\n+                Done\n+              </button>\n+            )}\n+            <button onClick={() => startEdit(task)} aria-label={`Edit ${task.title}`}>\n+              Edit\n+            </button>\n+            <button onClick={() => onDelete(task.id)} aria-label={`Delete ${task.title}`}>\n+              Delete\n             </button>\n-          )}\n-          <button onClick={() => onDelete(task.id)} aria-label={`Delete ${task.title}`}>\n-            Delete\n-          </button>\n-        </li>\n-      ))}\n+          </li>\n+        )\n+      )}\n     </ul>\n   )\n }", "meta": {"native_type": "user", "tool_use_id": "toolu_01ReuxZMGoYPcPGHwgHHoXNf", "session_id": "a37ae859-7a64-42e7-931c-2398d2ba4b7e"}}
