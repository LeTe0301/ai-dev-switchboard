{"ts": "2026-08-17T10:05:57Z", "agent": "claude", "seq": 19, "kind": "tool_result", "text": "1\t\"\"\"Wire shapes. Routes return these, never bare dicts.\"\"\"\n2\tfrom pydantic import BaseModel, Field\n3\t\n4\t\n5\tclass TaskIn(BaseModel):\n6\t    title: str = Field(min_length=1, max_length=200)\n7\t\n8\t\n9\tclass Task(BaseModel):\n10\t    id: int\n11\t    title: str\n12\t    done: bool = False\n13\t", "meta": {"native_type": "user", "tool_use_id": "toolu_01SCbxLMfEZLgPK1jmpzpHQe", "session_id": "852774c2-c0ba-46f2-a2f0-7bd73cc17f62"}}
