{"ts": "2026-08-17T10:33:18Z", "agent": "claude", "seq": 34, "kind": "tool_result", "text": "1\t// Every network call goes through here: components never call fetch directly,\n2\t// so the base URL and error handling stay in one place.\n3\tconst BASE = import.meta.env.VITE_API_BASE || 'http://localhost:8000'\n4\t\n5\tasync function request(path, options = {}) {\n6\t  const res = await fetch(BASE + path, {\n7\t    headers: { 'Content-Type': 'application/json' },\n8\t    ...options,\n9\t  })\n10\t  if (!res.ok) {\n11\t    const detail = await res.json().catch(() => null)\n12\t    throw new Error(detail?.detail || `request failed (${res.status})`)\n13\t  }\n14\t  return res.status === 204 ? null : res.json()\n15\t}\n16\t\n17\texport const listTasks = () => request('/api/tasks')\n18\texport const createTask = (title) =>\n19\t  request('/api/tasks', { method: 'POST', body: JSON.stringify({ title }) })\n20\texport const completeTask = (id) => request(`/api/tasks/${id}/done`, { method: 'POST' })\n21\texport const deleteTask = (id) => request(`/api/tasks/${id}`, { method: 'DELETE' })\n22\t", "meta": {"native_type": "user", "tool_use_id": "toolu_01N8wMqBq1uLpSmVdw4jqBfa", "session_id": "7316b1e8-1a1b-45f3-8c7b-90f2dd28a686"}}
