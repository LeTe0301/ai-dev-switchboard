{"ts": "2026-08-17T10:06:01Z", "agent": "claude", "seq": 34, "kind": "tool_result", "text": "1\tdef test_list_is_empty_initially(client):\n2\t    r = client.get(\"/api/tasks\")\n3\t    assert r.status_code == 200\n4\t    assert r.json() == []\n5\t\n6\t\n7\tdef test_create_returns_the_task(client):\n8\t    r = client.post(\"/api/tasks\", json={\"title\": \"write the thing\"})\n9\t    assert r.status_code == 201\n10\t    body = r.json()\n11\t    assert body[\"title\"] == \"write the thing\"\n12\t    assert body[\"done\"] is False\n13\t\n14\t\n15\tdef test_created_tasks_are_listed_in_id_order(client):\n16\t    for title in (\"one\", \"two\", \"three\"):\n17\t        client.post(\"/api/tasks\", json={\"title\": title})\n18\t    assert [t[\"title\"] for t in client.get(\"/api/tasks\").json()] == [\"one\", \"two\", \"three\"]\n19\t\n20\t\n21\tdef test_empty_title_is_rejected(client):\n22\t    assert client.post(\"/api/tasks\", json={\"title\": \"\"}).status_code == 422\n23\t\n24\t\n25\tdef test_completing_a_task_sets_done(client):\n26\t    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\"}).json()[\"id\"]\n27\t    assert client.post(f\"/api/tasks/{task_id}/done\").json()[\"done\"] is True\n28\t\n29\t\n30\tdef test_completing_a_missing_task_is_404(client):\n31\t    assert client.post(\"/api/tasks/999/done\").status_code == 404\n32\t\n33\t\n34\tdef test_delete_removes_it(client):\n35\t    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\"}).json()[\"id\"]\n36\t    assert client.delete(f\"/api/tasks/{task_id}\").status_code == 204\n37\t    assert client.get(\"/api/tasks\").json() == []\n38\t\n39\t\n40\tdef test_deleting_a_missing_task_is_404(client):\n41\t    assert client.delete(\"/api/tasks/999\").status_code == 404\n42\t", "meta": {"native_type": "user", "tool_use_id": "toolu_01SGGvD2EG8yHw8S8Xy1Tfv2", "session_id": "852774c2-c0ba-46f2-a2f0-7bd73cc17f62"}}
