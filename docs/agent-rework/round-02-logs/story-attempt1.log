jects/test-project/frontend/README.md\n/home/dev/projects/test-project/frontend/dist/assets/index-CZkNMfxT.js\n/home/dev/projects/test-project/frontend/dist/assets/index-XAl-t61W.css\n/home/dev/projects/test-project/frontend/dist/favicon.svg\n/home/dev/projects/test-project/frontend/dist/icons.svg\n/home/dev/projects/test-project/frontend/dist/index.html\n/home/dev/projects/test-project/frontend/index.html\n/home/dev/projects/test-project/frontend/package-lock.json\n/home/dev/projects/test-project/frontend/package.json\n/home/dev/projects/test-project/frontend/public/favicon.svg\n/home/dev/projects/test-project/frontend/public/icons.svg\n/home/dev/projects/test-project/frontend/src/App.css\n/home/dev/projects/test-project/frontend/src/App.jsx\n/home/dev/projects/test-project/frontend/src/api.js\n/home/dev/projects/test-project/frontend/src/assets/hero.png\n/home/dev/projects/test-project/frontend/src/assets/react.svg\n/home/dev/projects/test-project/frontend/src/assets/vite.svg\n/home/dev/projects/test-project/frontend/src/components/AddTask.jsx\n/home/dev/projects/test-project/frontend/src/components/TaskFilter.jsx\n/home/dev/projects/test-project/frontend/src/components/TaskList.jsx\n/home/dev/projects/test-project/frontend/src/main.jsx\n/home/dev/projects/test-project/frontend/vite.config.js", "meta": {"native_type": "user", "tool_use_id": "toolu_01HVMTbDhgHLku4cFmXFaJSY", "session_id": "7316b1e8-1a1b-45f3-8c7b-90f2dd28a686"}}
