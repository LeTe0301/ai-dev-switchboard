{"ts": "2026-08-17T10:33:17Z", "agent": "claude", "seq": 26, "kind": "tool_result", "text": "1\t\"\"\"Wire shapes. Routes return these, never bare dicts.\"\"\"\n2\tfrom pydantic import BaseModel, Field\n3\t\n4\t\n5\tclass TaskIn(BaseModel):\n6\t    title: str = Field(min_length=1, max_length=200)\n7\t\n8\t\n9\tclass Task(BaseModel):\n10\t    id: int\n11\t    title: str\n12\t    done: bool = False\n13\t", "meta": {"native_type": "user", "tool_use_id": "toolu_01RFzW1CQaVCpWad3QZ6eTod", "session_id": "7316b1e8-1a1b-45f3-8c7b-90f2dd28a686"}}
