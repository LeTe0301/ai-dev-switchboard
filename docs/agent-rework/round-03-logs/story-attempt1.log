{"ts": "2026-08-17T10:53:48Z", "agent": "claude", "seq": 38, "kind": "tool_result", "text": "1\tdef test_list_is_empty_initially(client):\n2\t    r = client.get(\"/api/tasks\")\n3\t    assert r.status_code == 200\n4\t    assert r.json() == []\n5\t\n6\t\n7\tdef test_create_returns_the_task(client):\n8\t    r = client.post(\"/api/tasks\", json={\"title\": \"write the thing\"})\n9\t    assert r.status_code == 201\n10\t    body = r.json()\n11\t    assert body[\"title\"] == \"write the thing\"\n12\t    assert body[\"done\"] is False\n13\t\n14\t\n15\tdef test_created_tasks_are_listed_in_id_order(client):\n16\t    for title in (\"one\", \"two\", \"three\"):\n17\t        client.post(\"/api/tasks\", json={\"title\": title})\n18\t    assert [t[\"title\"] for t in client.get(\"/api/tasks\").json()] == [\"one\", \"two\", \"three\"]\n19\t\n20\t\n21\tdef test_empty_title_is_rejected(client):\n22\t    assert client.post(\"/api/tasks\", json={\"title\": \"\"}).status_code == 422\n23\t\n24\t\n25\tdef test_completing_a_task_sets_done(client):\n26\t    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\"}).json()[\"id\"]\n27\t    assert client.post(f\"/api/tasks/{task_id}/done\").json()[\"done\"] is True\n28\t\n29\t\n30\tdef test_completing_a_missing_task_is_404(client):\n31\t    assert client.post(\"/api/tasks/999/done\").status_code == 404\n32\t\n33\t\n34\tdef test_delete_removes_it(client):\n35\t    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\"}).json()[\"id\"]\n36\t    assert client.delete(f\"/api/tasks/{task_id}\").status_code == 204\n37\t    assert client.get(\"/api/tasks\").json() == []\n38\t\n39\t\n40\tdef test_deleting_a_missing_task_is_404(client):\n41\t    assert client.delete(\"/api/tasks/999\").status_code == 404\n42\t\n43\t\n44\tdef test_updating_title_changes_it(client):\n45\t    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\"}).json()[\"id\"]\n46\t    r = client.patch(f\"/api/tasks/{task_id}\", json={\"title\": \"y\"})\n47\t    assert r.status_code == 200\n48\t    assert r.json()[\"title\"] == \"y\"\n49\t\n50\t\n51\tdef test_updating_title_does_not_change_done_or_id(client):\n52\t    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\"}).json()[\"id\"]\n53\t    client.post(f\"/api/tasks/{task_id}/done\")\n54\t    body = client.patch(f\"/api/tasks/{task_id}\", json={\"title\": \"y\"}).json()\n55\t    assert body[\"id\"] == task_id\n56\t    assert body[\"done\"] is True\n57\t\n58\t\n59\tdef test_updating_a_missing_task_is_404(client):\n60\t    assert client.patch(\"/api/tasks/999\", json={\"title\": \"y\"}).status_code == 404\n61\t\n62\t\n63\tdef test_updating_with_empty_title_is_rejected(client):\n64\t    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\"}).json()[\"id\"]\n65\t    r = client.patch(f\"/api/tasks/{task_id}\", json={\"title\": \"\"})\n66\t    assert r.status_code == 422\n67\t    assert client.get(\"/api/tasks\").json()[0][\"title\"] == \"x\"\n68\t\n69\t\n70\tdef test_updating_title_at_max_length_succeeds(client):\n71\t    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\"}).json()[\"id\"]\n72\t    title = \"a\" * 200\n73\t    r = client.patch(f\"/api/tasks/{task_id}\", json={\"title\": title})\n74\t    assert r.status_code == 200\n75\t    assert r.json()[\"title\"] == title\n76\t\n77\t\n78\tdef test_updating_title_beyond_max_length_is_rejected(client):\n79\t    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\"}).json()[\"id\"]\n80\t    r = client.patch(f\"/api/tasks/{task_id}\", json={\"title\": \"a\" * 201})\n81\t    assert r.status_code == 422\n82\t    assert client.get(\"/api/tasks\").json()[0][\"title\"] == \"x\"\n83\t", "meta": {"native_type": "user", "tool_use_id": "toolu_013fLCTtAMhdvBkwjwwbPqiz", "session_id": "5050ad49-a79b-4044-8c08-7ab6658e49c6"}}
