{"ts": "2026-08-17T10:53:48Z", "agent": "claude", "seq": 35, "kind": "tool_result", "text": "1\tconst OPTIONS = [\n2\t  { value: 'all', label: 'All' },\n3\t  { value: 'open', label: 'Open' },\n4\t  { value: 'done', label: 'Done' },\n5\t]\n6\t\n7\texport default function TaskFilter({ value, onChange }) {\n8\t  return (\n9\t    <div className=\"task-filter\" role=\"group\" aria-label=\"Filter tasks\">\n10\t      {OPTIONS.map((opt) => (\n11\t        <button\n12\t          key={opt.value}\n13\t          type=\"button\"\n14\t          className={opt.value === value ? 'filter-option active' : 'filter-option'}\n15\t          aria-pressed={opt.value === value}\n16\t          onClick={() => onChange(opt.value)}\n17\t        >\n18\t          {opt.label}\n19\t        </button>\n20\t      ))}\n21\t    </div>\n22\t  )\n23\t}\n24\t", "meta": {"native_type": "user", "tool_use_id": "toolu_01LsRGFX2JxEphxjWi8KJMHY", "session_id": "5050ad49-a79b-4044-8c08-7ab6658e49c6"}}
{"ts": "2026-08-17T10:53:48Z", "agent": "claude", "seq": 36, "kind": "tool_result", "text": "1\t// Every network call goes through here: components never call fetch directly,\n2\t// so the base URL and error handling stay in one place.\n3\tconst BASE = import.meta.env.VITE_API_BASE || 'http://localhost:8000'\n4\t\n5\tasync function request(path, options = {}) {\n6\t  const res = await fetch(BASE + path, {\n7\t    headers: { 'Content-Type': 'application/json' },\n8\t    ...options,\n9\t  })\n10\t  if (!res.ok) {\n11\t    const detail = await res.json().catch(() => null)\n12\t    throw new Error(detail?.detail || `request failed (${res.status})`)\n13\t  }\n14\t  return res.status === 204 ? null : res.json()\n15\t}\n16\t\n17\texport const listTasks = () => request('/api/tasks')\n18\texport const createTask = (title) =>\n19\t  request('/api/tasks', { method: 'POST', body: JSON.stringify({ title }) })\n20\texport const completeTask = (id) => request(`/api/tasks/${id}/done`, { method: 'POST' })\n21\texport const updateTask = (id, title) =>\n22\t  request(`/api/tasks/${id}`, { method: 'PATCH', body: JSON.stringify({ title }) })\n23\texport const deleteTask = (id) => request(`/api/tasks/${id}`, { method: 'DELETE' })\n24\t", "meta": {"native_type": "user", "tool_use_id": "toolu_013G8tWUBG3wGComma3qJPRx", "session_id": "5050ad49-a79b-4044-8c08-7ab6658e49c6"}}
