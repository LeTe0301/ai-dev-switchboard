{"ts": "2026-08-17T11:08:45Z", "agent": "claude", "seq": 127, "kind": "tool_result", "text": "1\t\"\"\"Brings the whole app up for a browser test, then tears it down.\n2\t\n3\tBoth servers are started on ports derived from a free-port probe rather than\n4\thardcoded, so an e2e run does not collide with a dev server someone left\n5\trunning.\n6\t\"\"\"\n7\timport json\n8\timport os\n9\timport signal\n10\timport socket\n11\timport subprocess\n12\timport sys\n13\timport time\n14\timport urllib.request\n15\t\n16\timport pytest\n17\t\n18\tROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\n19\t\n20\t\n21\tdef _free_port():\n22\t    with socket.socket() as s:\n23\t        s.bind((\"127.0.0.1\", 0))\n24\t        return s.getsockname()[1]\n25\t\n26\t\n27\tdef _wait_for(url, timeout=60):\n28\t    deadline = time.time() + timeout\n29\t    while time.time() < deadline:\n30\t        try:\n31\t            urllib.request.urlopen(url, timeout=2)\n32\t            return True\n33\t        except Exception:\n34\t            time.sleep(0.4)\n35\t    return False\n36\t\n37\t\n38\tdef _stop_group(proc):\n39\t    \"\"\"Signal the whole process group, then escalate. Killing just `proc`\n40\t    leaves npm's vite child running forever.\"\"\"\n41\t    if proc.poll() is not None:\n42\t        return\n43\t    for sig in (signal.SIGTERM, signal.SIGKILL):\n44\t        try:\n45\t            os.killpg(os.getpgid(proc.pid), sig)\n46\t        except (ProcessLookupError, PermissionError):\n47\t            return\n48\t        try:\n49\t            proc.wait(timeout=10)\n50\t            return\n51\t        except subprocess.TimeoutExpired:\n52\t            continue\n53\t\n54\t\n55\t@pytest.fixture(scope=\"session\")\n56\tdef _servers():\n57\t    api_port = _free_port()\n58\t    web_port = _free_port()\n59\t\n60\t    # start_new_session puts each server in its own process GROUP so the whole\n61\t    # tree can be signalled. Without it, terminate() kills only the process we\n62\t    # spawned -- and `npm run dev` is a wrapper whose vite child then survives\n63\t    # as an orphan. Nineteen of them accumulated across e2e runs on 2026-08-17,\n64\t    # holding ~1.4 GB on a 4 GB container.\n65\t    api = subprocess.Popen(\n66\t        [sys.executable, \"-m\", \"uvicorn\", \"app.main:app\", \"--port\", str(api_port)],\n67\t        cwd=os.path.join(ROOT, \"backend\"), start_new_session=True,\n68\t        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\n69\t    web = subprocess.Popen(\n70\t        # --host 127.0.0.1 is required, not cosmetic: vite defaults to\n71\t        # \"localhost\", which resolves to ::1 here, so an IPv4 probe never\n72\t        # connects and the fixture times out waiting for a server that is\n73\t        # actually up.\n74\t        [\"npm\", \"run\", \"dev\", \"--\", \"--port\", str(web_port),\n75\t         \"--strictPort\", \"--host\", \"127.0.0.1\"],\n76\t        cwd=os.path.join(ROOT, \"frontend\"), start_new_session=True,\n77\t        env={**os.environ, \"VITE_API_BASE\": f\"http://127.0.0.1:{api_port}\"},\n78\t        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\n79\t    try:\n80\t        assert _wait_for(f\"http://127.0.0.1:{api_port}/api/tasks\"), \"backend never came up\"\n81\t        assert _wait_for(f\"http://127.0.0.1:{web_port}/\"), \"frontend never came up\"\n82\t        yield f\"http://127.0.0.1:{web_port}\", f\"http://127.0.0.1:{api_port}\"\n83\t    finally:\n84\t        for p in (web, api):\n85\t            _stop_group(p)\n86\t\n87\t\n88\t@pytest.fixture\n89\tdef app_url(_servers):\n90\t    \"\"\"One server pair for the whole session, but an EMPTY store per test.\n91\t\n92\t    The backend store is process-global, so without this each test inherits\n93\t    the previous one's tasks: empty-state assertions never fire, counts are\n94\t    off by however many ran before, and a duplicate title makes a\n95\t    get_by_role() lookup ambiguous. Clearing through the public API keeps the\n96\t    app itself free of a test-only reset route.\n97\t    \"\"\"\n98\t    web, api = _servers\n99\t    existing = json.loads(urllib.request.urlopen(api + \"/api/tasks\", timeout=10).read())\n100\t    for task in existing:\n101\t        req = urllib.request.Request(f\"{api}/api/tasks/{task['id']}\", method=\"DELETE\")\n102\t        urllib.request.urlopen(req, timeout=10).read()\n103\t    return web\n104\t\n105\t\n106\t@pytest.fixture\n107\tdef page(app_url):\n108\t    from playwright.sync_api import sync_playwright\n109\t    with sync_playwright() as p:\n110\t        browser = p.chromium.launch()\n111\t        page = browser.new_page()\n112\t        page.goto(app_url)\n113\t        yield page\n114\t        browser.close()\n115\t", "meta": {"native_type": "user", "tool_use_id": "toolu_01CKGerexownUoqLW375XS6H", "session_id": "f5bbe20f-00f0-44c5-8e27-0f0d28f060fa"}}
