{"ts": "2026-08-17T11:08:45Z", "agent": "claude", "seq": 129, "kind": "tool_result", "text": "1\t\"\"\"End-to-end: a real browser against the real app.\n2\t\n3\tEvery assertion uses `expect()`, never `is_visible()`. `is_visible()` answers\n4\tabout *this instant* and does not wait, so against a UI that updates after a\n5\tnetwork round-trip it reports False before the update lands. `expect()`\n6\tretries until it passes or times out, which is what makes these tests\n7\tdeterministic rather than a race.\n8\t\"\"\"\n9\tfrom playwright.sync_api import expect\n10\t\n11\t\n12\tdef add_task(page, title):\n13\t    page.get_by_label(\"Task title\").fill(title)\n14\t    page.get_by_role(\"button\", name=\"Add\").click()\n15\t\n16\t\n17\tdef select_filter(page, name):\n18\t    page.get_by_role(\"button\", name=name).click()\n19\t\n20\t\n21\tdef complete_task(page, title):\n22\t    page.get_by_role(\"button\", name=f\"Complete {title}\").click()\n23\t\n24\t\n25\tdef start_edit(page, title):\n26\t    page.get_by_role(\"button\", name=f\"Edit {title}\").click()\n27\t\n28\t\n29\tdef test_empty_state_is_shown_first(page):\n30\t    expect(page.get_by_text(\"Nothing to do yet.\")).to_be_visible()\n31\t\n32\t\n33\tdef test_adding_a_task_shows_it_in_the_list(page):\n34\t    add_task(page, \"buy milk\")\n35\t    expect(page.get_by_text(\"buy milk\")).to_be_visible()\n36\t\n37\t\n38\tdef test_the_input_clears_after_adding(page):\n39\t    add_task(page, \"buy milk\")\n40\t    expect(page.get_by_label(\"Task title\")).to_have_value(\"\")\n41\t\n42\t\n43\tdef test_completing_a_task_strikes_it_through(page):\n44\t    add_task(page, \"buy milk\")\n45\t    page.get_by_role(\"button\", name=\"Complete buy milk\").click()\n46\t    expect(page.locator(\"li.task.done\")).to_have_count(1)\n47\t\n48\t\n49\tdef test_completing_a_task_hides_its_done_button(page):\n50\t    add_task(page, \"buy milk\")\n51\t    page.get_by_role(\"button\", name=\"Complete buy milk\").click()\n52\t    expect(page.get_by_role(\"button\", name=\"Complete buy milk\")).to_have_count(0)\n53\t\n54\t\n55\tdef test_deleting_a_task_removes_it(page):\n56\t    add_task(page, \"buy milk\")\n57\t    page.get_by_role(\"button\", name=\"Delete buy milk\").click()\n58\t    expect(page.get_by_text(\"Nothing to do yet.\")).to_be_visible()\n59\t\n60\t\n61\tdef test_add_is_disabled_until_something_is_typed(page):\n62\t    expect(page.get_by_role(\"button\", name=\"Add\")).to_be_disabled()\n63\t    page.get_by_label(\"Task title\").fill(\"x\")\n64\t    expect(page.get_by_role(\"button\", name=\"Add\")).to_be_enabled()\n65\t\n66\t\n67\tdef test_two_tasks_both_appear(page):\n68\t    add_task(page, \"first task\")\n69\t    add_task(page, \"second task\")\n70\t    expect(page.locator(\"li.task\")).to_have_count(2)\n71\t\n72\t\n73\tdef test_default_filter_is_all_and_marked_active(page):\n74\t    expect(page.get_by_role(\"button\", name=\"All\")).to_have_attribute(\"aria-pressed\", \"true\")\n75\t\n76\t\n77\tdef test_selecting_a_filter_marks_it_active_and_others_inactive(page):\n78\t    select_filter(page, \"Open\")\n79\t    expect(page.get_by_role(\"button\", name=\"Open\")).to_have_attribute(\"aria-pressed\", \"true\")\n80\t    expect(page.get_by_role(\"button\", name=\"All\")).to_have_attribute(\"aria-pressed\", \"false\")\n81\t    expect(page.get_by_role(\"button\", name=\"Done\")).to_have_attribute(\"aria-pressed\", \"false\")\n82\t\n83\t\n84\tdef test_open_filter_hides_done_tasks(page):\n85\t    add_task(page, \"buy milk\")\n86\t    add_task(page, \"walk dog\")\n87\t    complete_task(page, \"buy milk\")\n88\t    select_filter(page, \"Open\")\n89\t    expect(page.get_by_text(\"buy milk\")).to_have_count(0)\n90\t    expect(page.get_by_text(\"walk dog\")).to_be_visible()\n91\t\n92\t\n93\tdef test_done_filter_shows_only_done_tasks(page):\n94\t    add_task(page, \"buy milk\")\n95\t    add_task(page, \"walk dog\")\n96\t    complete_task(page, \"buy milk\")\n97\t    select_filter(page, \"Done\")\n98\t    expect(page.get_by_text(\"buy milk\")).to_be_visible()\n99\t    expect(page.get_by_text(\"walk dog\")).to_have_count(0)\n100\t\n101\t\n102\tdef test_all_filter_shows_every_task_again(page):\n103\t    add_task(page, \"buy milk\")\n104\t    add_task(page, \"walk dog\")\n105\t    complete_task(page, \"buy milk\")\n106\t    select_filter(page, \"Done\")\n107\t    select_filter(page, \"All\")\n108\t    expect(page.get_by_text(\"buy milk\")).to_be_visible()\n109\t    expect(page.get_by_text(\"walk dog\")).to_be_visible()\n110\t\n111\t\n112\tdef test_adding_a_task_while_open_filter_is_active_shows_it(page):\n113\t    select_filter(page, \"Open\")\n114\t    add_task(page, \"buy milk\")\n115\t    expect(page.get_by_text(\"buy milk\")).to_be_visible()\n116\t\n117\t\n118\tdef test_adding_a_task_while_done_filter_is_active_hides_it_until_completed(page):\n119\t    select_filter(page, \"Done\")\n120\t    add_task(page, \"buy milk\")\n121\t    expect(page.get_by_text(\"buy milk\")).to_have_count(0)\n122\t\n123\t\n124\tdef test_completing_a_task_removes_it_from_open_view_live(page):\n125\t    add_task(page, \"buy milk\")\n126\t    select_filter(page, \"Open\")\n127\t    complete_task(page, \"buy milk\")\n128\t    expect(page.get_by_text(\"buy milk\")).to_have_count(0)\n129\t\n130\t\n131\tdef test_completing_a_task_makes_it_appear_under_done_live(page):\n132\t    add_task(page, \"buy milk\")\n133\t    complete_task(page, \"buy milk\")\n134\t    select_filter(page, \"Done\")\n135\t    expect(page.get_by_text(\"buy milk\")).to_be_visible()\n136\t\n137\t\n138\tdef test_filter_choice_persists_across_add_and_delete(page):\n139\t    add_task(page, \"buy milk\")\n140\t    select_filter(page, \"Open\")\n141\t    add_task(page, \"walk dog\")\n142\t    expect(page.get_by_role(\"button\", name=\"Open\")).to_have_attribute(\"aria-pressed\", \"true\")\n143\t    page.get_by_role(\"button\", name=\"Delete buy milk\").click()\n144\t    expect(page.get_by_role(\"button\", name=\"Open\")).to_have_attribute(\"aria-pressed\", \"true\")\n145\t\n146\t\n147\tdef test_open_filter_empty_state_when_all_tasks_done(page):\n148\t    add_task(page, \"buy milk\")\n149\t    complete_task(page, \"buy milk\")\n150\t    select_filter(page, \"Open\")\n151\t    expect(page.get_by_text(\"Nothing open right now.\")).to_be_visible()\n152\t\n153\t\n154\tdef test_done_filter_empty_state_when_no_task_done(page):\n155\t    add_task(page, \"buy milk\")\n156\t    select_filter(page, \"Done\")\n157\t    expect(page.get_by_text(\"Nothing done yet.\")).to_be_visible()\n158\t\n159\t\n160\tdef test_edit_button_opens_input_prefilled_with_current_title(page):\n161\t    add_task(page, \"buy milk\")\n162\t    start_edit(page, \"buy milk\")\n163\t    expect(page.get_by_label(\"Title for buy milk\")).to_have_value(\"buy milk\")\n164\t\n165\t\n166\tdef test_saving_an_edited_title_updates_the_list(page):\n167\t    add_task(page, \"buy milk\")\n168\t    start_edit(page, \"buy milk\")\n169\t    page.get_by_label(\"Title for buy milk\").fill(\"buy oat milk\")\n170\t    page.get_by_role(\"button\", name=\"Save\").click()\n171\t    expect(page.get_by_text(\"buy oat milk\")).to_be_visible()\n172\t    expect(page.get_by_text(\"buy milk\", exact=True)).to_have_count(0)\n173\t\n174\t\n175\tdef test_saving_an_edit_closes_edit_mode(page):\n176\t    add_task(page, \"buy milk\")\n177\t    start_edit(page, \"buy milk\")\n178\t    page.get_by_label(\"Title for buy milk\").fill(\"buy oat milk\")\n179\t    page.get_by_role(\"button\", name=\"Save\").click()\n180\t    expect(page.get_by_role(\"button\", name=\"Edit buy oat milk\")).to_be_visible()\n181\t    expect(page.get_by_label(\"Title for buy milk\")).to_have_count(0)\n182\t\n183\t\n184\tdef test_cancelling_an_edit_reverts_the_title_and_makes_no_backend_call(page):\n185\t    add_task(page, \"buy milk\")\n186\t    start_edit(page, \"buy milk\")\n187\t    page.get_by_label(\"Title for buy milk\").fill(\"buy oat milk\")\n188\t    page.get_by_role(\"button\", name=\"Cancel\").click()\n189\t    expect(page.get_by_text(\"buy milk\", exact=True)).to_be_visible()\n190\t    expect(page.get_by_text(\"buy oat milk\")).to_have_count(0)\n191\t\n192\t\n193\tdef test_save_is_disabled_when_title_is_cleared(page):\n194\t    add_task(page, \"buy milk\")\n195\t    start_edit(page, \"buy milk\")\n196\t    page.get_by_label(\"Title for buy milk\").fill(\"\")\n197\t    expect(page.get_by_role(\"button\", name=\"Save\")).to_be_disabled()\n198\t\n199\t\n200\tdef test_submitting_an_empty_title_is_rejected(page):\n201\t    add_task(page, \"buy milk\")\n202\t    start_edit(page, \"buy milk\")\n203\t    page.get_by_label(\"Title for buy milk\").fill(\"\")\n204\t    page.get_by_label(\"Title for buy milk\").press(\"Enter\")\n205\t    expect(page.get_by_text(\"Title can't be empty\")).to_be_visible()\n206\t    expect(page.get_by_role(\"button\", name=\"Edit buy milk\")).to_have_count(0)\n207\t\n208\t\n209\tdef test_submitting_a_whitespace_only_title_is_rejected(page):\n210\t    add_task(page, \"buy milk\")\n211\t    start_edit(page, \"buy milk\")\n212\t    page.get_by_label(\"Title for buy milk\").fill(\"   \")\n213\t    page.get_by_label(\"Title for buy milk\").press(\"Enter\")\n214\t    expect(page.get_by_text(\"Title can't be empty\")).to_be_visible()\n215\t\n216\t\n217\tdef test_editing_does_not_change_done_state(page):\n218\t    add_task(page, \"buy milk\")\n219\t    complete_task(page, \"buy milk\")\n220\t    start_edit(page, \"buy milk\")\n221\t    page.get_by_label(\"Title for buy milk\").fill(\"buy oat milk\")\n222\t    page.get_by_role(\"button\", name=\"Save\").click()\n223\t    expect(page.locator(\"li.task.done\")).to_have_count(1)\n224\t    expect(page.get_by_text(\"buy oat milk\")).to_be_visible()\n225\t\n226\t\n227\tdef test_two_tasks_can_be_edited_at_the_same_time_independently(page):\n228\t    add_task(page, \"buy milk\")\n229\t    add_task(page, \"walk dog\")\n230\t    start_edit(page, \"buy milk\")\n231\t    start_edit(page, \"walk dog\")\n232\t    page.get_by_label(\"Title for buy milk\").fill(\"buy oat milk\")\n233\t    page.get_by_label(\"Title for walk dog\").fill(\"walk cat\")\n234\t    expect(page.get_by_label(\"Title for buy milk\")).to_have_value(\"buy oat milk\")\n235\t    expect(page.get_by_label(\"Title for walk dog\")).to_have_value(\"walk cat\")\n236\t    page.get_by_role(\"button\", name=\"Save\").first.click()\n237\t    expect(page.get_by_text(\"buy oat milk\")).to_be_visible()\n238\t    expect(page.get_by_label(\"Title for walk dog\")).to_have_value(\"walk cat\")\n239\t\n240\t\n241\tdef test_a_failed_save_keeps_edit_mode_open_with_the_draft_intact(page):\n242\t    add_task(page, \"buy milk\")\n243\t    start_edit(page, \"buy milk\")\n244\t    page.get_by_label(\"Title for buy milk\").fill(\"buy oat milk\")\n245\t    page.route(\n246\t        \"**/api/tasks/*\",\n247\t        lambda route: route.fulfill(\n248\t            status=500, content_type=\"application/json\", body='{\"detail\": \"boom\"}'\n249\t        )\n250\t        if route.request.method == \"PATCH\"\n251\t        else route.continue_(),\n252\t    )\n253\t    page.get_by_role(\"button\", name=\"Save\").click()\n254\t    expect(page.get_by_role(\"alert\").first).to_be_visible()\n255\t    expect(page.get_by_label(\"Title for buy milk\")).to_have_value(\"buy oat milk\")\n256\t", "meta": {"native_type": "user", "tool_use_id": "toolu_01RrTxEiaCbCswaCTdhrqk1N", "session_id": "f5bbe20f-00f0-44c5-8e27-0f0d28f060fa"}}
