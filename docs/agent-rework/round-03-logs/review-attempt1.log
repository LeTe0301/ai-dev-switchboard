{"ts": "2026-08-17T11:05:12Z", "agent": "claude", "seq": 167, "kind": "tool_result", "text": "85:def test_create_defaults_to_normal_priority(client):\n87:    assert r.json()[\"priority\"] == \"normal\"\n90:def test_create_with_explicit_priority(client):\n91:    r = client.post(\"/api/tasks\", json={\"title\": \"x\", \"priority\": \"high\"})\n93:    assert r.json()[\"priority\"] == \"high\"\n96:def test_create_with_invalid_priority_is_rejected(client):\n97:    r = client.post(\"/api/tasks\", json={\"title\": \"x\", \"priority\": \"urgent\"})\n102:def test_updating_priority_changes_it(client):\n104:    r = client.patch(f\"/api/tasks/{task_id}/priority\", json={\"priority\": \"high\"})\n106:    assert r.json()[\"priority\"] == \"high\"\n109:def test_updating_priority_does_not_change_title_id_or_done(client):\n112:    body = client.patch(f\"/api/tasks/{task_id}/priority\", json={\"priority\": \"low\"}).json()\n118:def test_updating_priority_of_a_missing_task_is_404(client):\n119:    assert client.patch(\"/api/tasks/999/priority\", json={\"priority\": \"high\"}).status_code == 404\n122:def test_updating_priority_with_invalid_value_is_rejected(client):\n124:    r = client.patch(f\"/api/tasks/{task_id}/priority\", json={\"priority\": \"urgent\"})\n126:    assert client.get(\"/api/tasks\").json()[0][\"priority\"] == \"normal\"\n129:def test_updating_title_leaves_priority_untouched(client):\n130:    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\", \"priority\": \"high\"}).json()[\"id\"]\n132:    assert body[\"priority\"] == \"high\"", "meta": {"native_type": "user", "tool_use_id": "toolu_01SDq5yR6kMtCcVtbhtczABF", "session_id": "3bc8142f-e811-46af-9f9d-e5b2e1f7a2ad"}}
