t.post(\"/api/tasks\", json={\"title\": \"x\", \"priority\": \"high\"})\n+    assert r.status_code == 201\n+    assert r.json()[\"priority\"] == \"high\"\n+\n+\n+def test_create_with_invalid_priority_is_rejected(client):\n+    r = client.post(\"/api/tasks\", json={\"title\": \"x\", \"priority\": \"urgent\"})\n+    assert r.status_code == 422\n+    assert client.get(\"/api/tasks\").json() == []\n+\n+\n+def test_updating_priority_changes_it(client):\n+    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\"}).json()[\"id\"]\n+    r = client.patch(f\"/api/tasks/{task_id}/priority\", json={\"priority\": \"high\"})\n+    assert r.status_code == 200\n+    assert r.json()[\"priority\"] == \"high\"\n+\n+\n+def test_updating_priority_does_not_change_title_id_or_done(client):\n+    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\"}).json()[\"id\"]\n+    client.post(f\"/api/tasks/{task_id}/done\")\n+    body = client.patch(f\"/api/tasks/{task_id}/priority\", json={\"priority\": \"low\"}).json()\n+    assert body[\"id\"] == task_id\n+    assert body[\"title\"] == \"x\"\n+    assert body[\"done\"] is True\n+\n+\n+def test_updating_priority_of_a_missing_task_is_404(client):\n+    assert client.patch(\"/api/tasks/999/priority\", json={\"priority\": \"high\"}).status_code == 404\n+\n+\n+def test_updating_priority_with_invalid_value_is_rejected(client):\n+    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\"}).json()[\"id\"]\n+    r = client.patch(f\"/api/tasks/{task_id}/priority\", json={\"priority\": \"urgent\"})\n+    assert r.status_code == 422\n+    assert client.get(\"/api/tasks\").json()[0][\"priority\"] == \"normal\"\n+\n+\n+def test_updating_title_leaves_priority_untouched(client):\n+    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\", \"priority\": \"high\"}).json()[\"id\"]\n+    body = client.patch(f\"/api/tasks/{task_id}\", json={\"title\": \"y\"}).json()\n+    assert body[\"priority\"] == \"high\"\ndiff --git a/frontend/src/App