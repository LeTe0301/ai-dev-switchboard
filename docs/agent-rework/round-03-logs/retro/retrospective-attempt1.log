t_by_label(\\\"Title for buy milk\\\").fill(\\\"buy oat milk\\\")\\n170\\t    page.get_by_role(\\\"button\\\", name=\\\"Save\\\").click()\\n171\\t    expect(page.get_by_text(\\\"buy oat milk\\\")).to_be_visible()\\n172\\t    expect(page.get_by_text(\\\"buy milk\\\", exact=True)).to_have_count(0)\\n173\\t\\n174\\t\\n175\\tdef test_saving_an_edit_closes_edit_mode(page):\\n176\\t    add_task(page, \\\"buy milk\\\")\\n177\\t    start_edit(page, \\\"buy milk\\\")\\n178\\t    page.get_by_label(\\\"Title for buy milk\\\").fill(\\\"buy oat milk\\\")\\n179\\t    page.get_by_role(\\\"button\\\", name=\\\"Save\\\").click()\\n180\\t    expect(page.get_by_role(\\\"button\\\", name=\\\"Edit buy oat milk\\\")).to_be_visible()\\n181\\t    expect(page.get_by_label(\\\"Title for buy milk\\\")).to_have_count(0)\\n182\\t\\n183\\t\\n184\\tdef test_cancelling_an_edit_reverts_the_title_and_makes_no_backend_call(page):\\n185\\t    add_task(page, \\\"buy milk\\\")\\n186\\t    start_edit(page, \\\"buy milk\\\")\\n187\\t    page.get_by_label(\\\"Title for buy milk\\\").fill(\\\"buy oat milk\\\")\\n188\\t    page.get_by_role(\\\"button\\\", name=\\\"Cancel\\\").click()\\n189\\t    expect(page.get_by_text(\\\"buy milk\\\", exact=True)).to_be_visible()\\n190\\t    expect(page.get_by_text(\\\"buy oat milk\\\")).to_have_count(0)\\n191\\t\\n192\\t\\n193\\tdef test_save_is_disabled_when_title_is_cleared(page):\\n194\\t    add_task(page, \\\"buy milk\\\")\\n195\\t    start_edit(page, \\\"buy milk\\\")\\n196\\t    page.get_by_label(\\\"Title for buy milk\\\").fill(\\\"\\\")\\n197\\t    expect(page.get_by_role(\\\"button\\\", name=\\\"Save\\\")).to_be_disabled()\\n198\\t\\n199\\t\\n200\\tdef test_submitting_an_empty_title_is_rejected(page):\\n201\\t    add_task(page, \\\"buy milk\\\")\\n202\\t    start_edit(page, \\\"buy milk\\\")\\n203\\t    page.get_by_label(\\\"Title for buy milk\\\").fill(\\\"\\\")\\n204\\t    page.get_by_label(\\\"Title for buy milk\\\").press(\\\"Enter\\\")\\n205\\t    expect(page.get_by_text(\\\"Title can't be empty\\\")).to_be_visible()\\n206\\t    expect(page.get_by_role(\\\"button\\\", name=\\\"Edit buy milk\\\")).to_have_count(0)\\n207\\t\\n208\\t\\n209\\tdef test_submitting_a_whitespace_only_title_is_rejected(page):\\n210\\t    add_task(page, \\\"buy milk\\\")\\n211\\t    start_edit(page, \\\"buy milk\\\")\\n212\\t    page.get_by_label(\\\"Title for buy milk\\\").fill(\\\"   \\\")\\n213\\t    page.get_by_label(\\\"Title for buy milk\\\").press(\\\"Enter\\\")\\n214\\t    expect(page.get_by_text(\\\"Title can't be empty\\\")).to_be_visible()\\n215\\t\\n216\\t\\n217\\tdef test_editing_does_not_change_done_state(page):\\n218\\t    add_task(page, \\\"buy milk\\\")\\n219\\t    complete_task(page, \\\"buy milk\\\")\\n220\\t    start_edit(page, \\\"buy milk\\\")\\n221\\t    page.get_by_label(\\\"Title for buy milk\\\").fill(\\\"buy oat milk\\\")\\n222\\t    page.get_by_role(\\\"button\\\", name=\\\"Save\\\").click()\\n223\\t    expect(page.locator(\\\"li.task.done\\\")).to_have_count(1)\\n224\\t    expect(page.get_by_text(\\\"buy oat milk\\\")).to_be_visible()\\n225\\t\\n226\\t\\n227\\tdef test_two_tasks_can_be_edited_at_the_same_time_independently(page):\\n228\\t    add_task(page, \\\"buy milk\\\")\\n229\\t    add_task(page, \\\"walk dog\\\")\\n230\\t    start_edit(page, \\\"buy milk\\\")\\n231\\t    start_edit(page, \\\"walk dog\\\")\\n232\\t    page.get_by_label(\\\"Title for buy milk\\\").fill(\\\"buy oat milk\\\")\\n233\\t    page.get_by_label(\\\"Title for walk dog\\\").fill(\\\"walk cat\\\")\\n234\\t    expect(page.get_by_label(\\\"Title for buy milk\\\")).to_have_value(\\\"buy oat milk\\\")\\n235\\t    expect(page.get_by_label(\\\"Title for walk dog\\\")).to_have_value(\\\"walk cat\\\")\\n236\\t    page.get_by_role(\\\"button\\\", name=\\\"Save\\\").first.click()\\n237\\t    expect(page.get_by_text(\\\"buy oat milk\\\")).to_be_visible()\\n238\\t    expect(page.get_by_label(\\\"Title for walk dog\\\")).to_have_value(\\\"walk cat\\\")\\