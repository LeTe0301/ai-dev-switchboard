n dev` is a wrapper and its vite child survived as an orphan, so\\n    every run left one behind: nineteen had accumulated, holding roughly 1.4 GB on\\n    a 4 GB container.\\n    \\n    Both servers now start with start_new_session=True, which puts each in its own\\n    process group, and teardown signals the whole group -- SIGTERM, then SIGKILL if\\n    it does not go quietly -- rather than only the direct child.\\n    \\n    Verified by counting vite and uvicorn processes either side of a full run:\\n    zero before, zero after, 20/20 still passing.\\n\\n e2e/conftest.py | 33 ++++++++++++++++++++++++++-------\\n 1 file changed, 26 insertions(+), 7 deletions(-)\", \"meta\": {\"native_type\": \"user\", \"tool_use_id\": \"toolu_012eeezDL1vX1bZJ8iEDizvW\", \"session_id\": \"f5bbe20f-00f0-44c5-8e27-0f0d28f060fa\"}}\n117\t{\"ts\": \"2026-08-17T11:08:42Z\", \"agent\": \"claude\", \"seq\": 117, \"kind\": \"status\", \"text\": \"\", \"meta\": {\"native_type\": \"system\", \"subtype\": \"thinking_tokens\", \"session_id\": \"f5bbe20f-00f0-44c5-8e27-0f0d28f060fa\"}}\n118\t{\"ts\": \"2026-08-17T11:08:42Z\", \"agent\": \"claude\", \"seq\": 118, \"kind\": \"status\", \"text\": \"\", \"meta\": {\"native_type\": \"system\", \"subtype\": \"thinking_tokens\", \"session_id\": \"f5bbe20f-00f0-44c5-8e27-0f0d28f060fa\"}}\n119\t{\"ts\": \"2026-08-17T11:08:42Z\", \"agent\": \"claude\", \"seq\": 119, \"kind\": \"status\", \"text\": \"\", \"meta\": {\"native_type\": \"assistant\", \"block_type\": \"thinking\", \"session_id\": \"f5bbe20f-00f0-44c5-8e27-0f0d28f060fa\"}}\n120\t{\"ts\": \"2026-08-17T11:08:42Z\", \"agent\": \"claude\", \"seq\": 120, \"kind\": \"message\", \"text\": \"There's an existing e2e test harness that handles server lifecycle properly. Let me check it \\u2014 this is likely the project's actual \\\"run the app for real\\\" path.\", \"meta\": {\"native_type\": \"assistant\", \"block_type\": \"text\", \"session_id\": \"f5bbe20f-00f0-44c5-8e27-0f0d28f060fa\"}}\n121\t{\"ts\": \"2026-08-17T11:08:43Z\", \"agent\": \"claude\", \"seq\": 121, \"kind\": \"tool_use\", \"text\": \"Bash\", \"meta\": {\"native_type\": \"assistant\", \"block_type\": \"tool_use\", \"tool_use_id\": \"toolu_011Wtfj57KHjGSXZ2iVnqY8D\", \"input\": {\"command\": \"find /home/dev/projects/test-project/e2e -type f | head -30\", \"description\": \"List e2e test directory contents\"}, \"session_id\": \"f5bbe20f-00f0-44c5-8e27-0f0d28f060fa\"}}\n122\t{\"ts\": \"2026-08-17T11:08:43Z\", \"agent\": \"claude\", \"seq\": 122, \"kind\": \"tool_result\", \"text\": \"/home/dev/projects/test-project/e2e/conftest.py\\n/home/dev/projects/test-project/e2e/test_tasks_e2e.py\\n/home/dev/projects/test-project/e2e/.pytest_cache/CACHEDIR.TAG\\n/home/dev/projects/test-project/e2e/.pytest_cache/.gitignore\\n/home/dev/projects/test-project/e2e/.pytest_cache/README.md\\n/home/dev/projects/test-project/e2e/__pycache__/test_tasks_e2e.cpython-311-pytest-9.1.1.pyc\\n/home/dev/projects/test-project/e2e/__pycache__/conftest.cpython-311-pytest-9.1.1.pyc\\n/home/dev/projects/test-project/e2e/__pycache__/conftest.cpython-311.pyc\\n/home/dev/projects/test-project/e2e/.pytest_cache/v/cache/nodeids\\n/home/dev/projects/test-project/e2e/.pytest_cache/v/cache/lastfailed\", \"meta\": {\"native_type\": \"user\", \"tool_use_id\": \"toolu_011Wtfj57KHjGSXZ2iVnqY8D\", \"session_id\": \"f5bbe20f-00f0-44c5-8e27-0f0d28f060fa\"}}\n123\t{\"ts\": \"2026-08-17T11:08:44Z\", \"agent\": \"claude\", \"seq\": 123, \"kind\": \"status\", \"text\": \"\", \"meta\": {\"native_type\": \"system\", \"subtype\": \"thinking_tokens\", \"session_id\": \"f5bbe20f-00f0-44c5-8e27-0f0d28f060fa\"}}\n124\t{\"ts\": \"2026-08-17T11:08:45Z\", \"agent\": \"claude\", \"seq\": 124, \"kind\": \"status\", \"text\": \"\", \"meta\": {\"native_type\": \"system\", \"subtype\": \"thinking_tokens\", \"session_id\": \"f5bbe20f-00f0-44c5-8e27-0f0d28f060fa\"}}\n125\t{\"ts\": \"2026-08-17T11:08:45Z\", \"agent\": \"claude\", \"seq\": 125, \"kind\": \"status\", \"text\": \"\", \"meta\": {\"native_type\": \"assistant\", \"block_type\": \"thinking\", \"session_id\": \"f5bbe20f-00f0-44c5-8e27-0f0d28f060fa\"}}\n126\t{\"ts\": \"2026-08-17T11:08:45Z\", \"agent\": \"claude\", \"seq\": 126, \"kind\": \"tool_use\", \"text\": \"Read\", \"meta\": {\"native_type\": \"assistant\", \"block_type\": \"tool_use\", \"tool_use_id\": \"toolu_01CKGerexownUoqLW375XS6H\", \"input\": {\"file_path\": \"/home/dev/projects/test-project/e2e/conftest.py\"}, \"session_id\": \"f5bbe20f-00f0-44c5-8e27-0f0d28f060fa\"}}\n127\t{\"ts\": \"2026-08-17T11:08:45Z\", \"agent\": \"claude\", \"seq\": 127, \"kind\": \"tool_result\", \"text\": \"1\\t\\\"\\\"\\\"Brings the whole app up for a browser test, then tears it down.\\n2\\t\\n3\\tBoth servers are started on ports derived from a free-port probe rather than\\n4\\thardcoded, so an e2e run does not collide with a dev server someone left\\n5\\trunning.\\n6\\t\\\"\\\"\\\"\\n7\\timport json\\n8\\timport os\\n9\\timport signal\\n10\\timport socket\\n11\\timport subprocess\\n12\\timport sys\\n13\\timport time\\n14\\timport urllib.request\\n15\\t\\n16\\timport pytest\\n17\\t\\n18\\tROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\\n19\\t\\n20\\t\\n21\\tdef _free_port():\\n22\\t    with socket.socket() as s:\\n23\\t        s.bind((\\\"127.0.0.1\\\", 0))\\n24\\t        return s.getsockname()[1]\\n25\\t\\n26\\t\\n27\\tdef _wait_for(url, timeout=60):\\n28\\t    deadline = time.time() + timeout\\n29\\t    while time.time() < deadline:\\n30\\t        try:\\n31\\t            urllib.request.urlopen(url, timeout=2)\\n32\\t            return True\\n33\\t        except Exception:\\n34\\t            time.sleep(0.4)\\n35\\t    return False\\n36\\t\\n37\\t\\n38\\tdef _stop_group(proc):\\n39\\t    \\\"\\\"\\\"Signal the whole process group, then escalate. Killing just `proc`\\n40\\t    leaves npm's vite child running forever.\\\"\\\"\\\"\\n41\\t    if proc.poll() is not None:\\n42\\t        return\\n43\\t    for sig in (signal.SIGTERM, signal.SIGKILL):\\n44\\t        try:\\n45\\t            os.killpg(os.getpgid(proc.pid), sig)\\n46\\t        except (ProcessLookupError, PermissionError):\\n47\\t            return\\n48\\t        try:\\n49\\t            proc.wait(timeout=10)\\n50\\t            return\\n51\\t        except subprocess.TimeoutExpired:\\n52\\t            continue\\n53\\t\\n54\\t\\n55\\t@pytest.fixture(scope=\\\"session\\\")\\n56\\tdef _servers():\\n57\\t    api_port = _free_port()\\n58\\t    web_port = _free_port()\\n59\\t\\n60\\t    # start_new_session puts each server in its own process GROUP so the whole\\n61\\t    # tree can be signalled. Without it, terminate() kills only the process we\\n62\\t    # spawned -- and `npm run dev` is a wrapper whose vite child then survives\\n63\\t    # as an orphan. Nineteen of them accumulated across e2e runs on 2026-08-17,\\n64\\t    # holding ~1.4 GB on a 4 GB container.\\n65\\t    api = subprocess.Popen(\\n66\\t        [sys.executable, \\\"-m\\\", \\\"uvicorn\\\", \\\"app.main:app\\\", \\\"--port\\\", str(api_port)],\\n67\\t        cwd=os.path.join(ROOT, \\\"backend\\\"), start_new_session=True,\\n68\\t        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\\n69\\t    web = subprocess.Popen(\\n70\\t        # --host 127.0.0.1 is required, not cosmetic: vite defaults to\\n71\\t        # \\\"localhost\\\", which resolves to ::1 here, so an IPv4 probe never\\n72\\t        # connects and the fixture times out waiting for a server that is\\n73\\t        # actually up.\\n74\\t        [\\\"npm\\\", \\\"run\\\", \\\"dev\\\", \\\"--\\\", \\\"--port\\\", str(web_port),\\n75\\t         \\\"--strictPort\\\", \\\"--host\\\", \\\"127.0.0.1\\\"],\\n76\\t        cwd=os.path.join(ROOT, \\\"frontend\\\"), start_new_session=True,\\n77\\t        env={**os.environ, \\\"VITE_API_BASE\\\": f\\\"http://127.0.0.1:{api_port}\\\"},\\n78\\t        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\\n79\\t    try:\\n80\\t        assert _wait_for(f\\\"http://127.0.0.1:{api_port}/api/tasks\\\"), \\\"backend never came up\\\"\\n81\\t        assert _wait_for(f\\\"http://127.0.0.1:{web_port}/\\\"), \\\"frontend never came up\\\"\\n82\\t        yield f\\\"http://127.0.0.1:{web_port}\\\", f\\\"http://127.0.0.1:{api_port}\\\"\\n83\\t    finally:\\n84\\t        for p in (web, api):\\n85\\t            _stop_group(p)\\n86\\t\\n87\\t\\n88\\t@pytest.fixture\\n89\\tdef app_url(_servers):\\n90\\t    \\\"\\\"\\\"One server pair for the whole session, but an EMPTY store per test.\\n91\\t\\n92\\t    The backend store is process-global, so without this each test inherits\\n93\\t    the previous one's tasks: empty-state assertions never fire, counts are\\n94\\t    off by however many ran before, and a duplicate title makes a\\n95\\t    get_by_role() lookup ambiguous. Clearing through the public API keeps the\\n96\\t    app itself free of a test-only reset route.\\n97\\t    \\\"\\\"\\\"\\n98\\t    web, api = _servers\\n99\\t    existing = json.loads(urllib.request.urlopen(api + \\\"/api/tasks\\\", timeout=10).read())\\n100\\t    for task in existing:\\n101\\t        req = urllib.request.Request(f\\\"{api}/api/tasks/{task['id']}\\\", method=\\\"DELETE\\\")\\n102\\t        urllib.request.urlopen(req, timeout=10).read()\\n103\\t    return web\\n104\\t\\n105\\t\\n106\\t@pytest.fixture\\n107\\tdef page(app_url):\\n108\\t    from playwright.sync_api import sync_playwright\\n109\\t    with sync_playwright() as p:\\n110\\t        browser = p.chromium.launch()\\n111\\t        page = browser.new_page()\\n112\\t        page.goto(app_url)\\n113\\t        yield page\\n114\\t        browser.close()\\n115\\t\", \"meta\": {\"native_type\": \"user\", \"tool_use_id\": \"toolu_01CKGerexownUoqLW375XS6H\", \"session_id\": \"f5bbe20f-00f0-44c5-8e27-0f0d28f060fa\"}}\n128\t{\"ts\": \"2026-08-17T11:08:45Z\", \"agent\": \"claude\", \"seq\": 128, \"kind\": \"tool_use\", \"text\": \"Read\", \"meta\": {\"native_type\": \"assistant\", \"block_type\": \"tool_use\", \"tool_use_id\": \"toolu_01RrTxEiaCbCswaCTdhrqk1N\", \"input\": {\"file_path\": \"/home/dev/projects/test-project/e2e/test_tasks_e2e.py\"}, \"session_id\": \"f5bbe20f-00f0-44c5-8e27-0f0d28f060fa\"}}\n129\t{\"ts\": \"2026-08-17T11:08:45Z\", \"agent\": \"claude\", \"seq\": 129, \"kind\": \"tool_result\", \"text\": \"1\\t\\\"\\\"\\\"End-to-end: a real browser against the real app.\\n2\\t\\n3\\tEvery assertion uses `expect()`, never `is_visible()`. `is_visible()` answers\\n4\\tabout *this instant* and does not wait, so against a UI that updates after a\\n5\\tnetwork round-trip it reports False before the update lands. `expect()`\\n6\\tretries until it passes or times out, which is what makes these tests\\n7\\tdeterministic rather than a race.\\n8\\t\\\"\\\"\\\"\\n9\\tfrom playwright.sync_api import expect\\n10\\t\\n11\\t\\n12\\tdef add_task(page, title):\\n13\\t    page.get_by_label(\\\"Task title\\\").fill(title)\\n14\\t    page.get_by_role(\\\"button\\\", name=\\\"Add\\\").click()\\n15\\t\\n16\\t\\n17\\tdef select_filter(page, name):\\n18\\t    page.get_by_role(\\\"button\\\", name=name).click()\\n19\\t\\n20\\t\\n21\\tdef complete_task(page, title):\\n22\\t    page.get_by_role(\\\"button\\\", name=f\\\"Complete {title}\\\").click()\\n23\\t\\n24\\t\\n25\\tdef start_edit(page, title):\\n26\\t    page.get_by_role(\\\"button\\\", name=f\\\"Edit {title}\\\").click()\\n27\\t\\n28\\t\\n29\\tdef test_empty_state_is_shown_first(page):\\n30\\t    expect(page.get_by_text(\\\"Nothing to do yet.\\\")).to_be_visible()\\n31\\t\\n32\\t\\n33\\tdef test_adding_a_task_shows_it_in_the_list(page):\\n34\\t    add_task(page, \\\"buy milk\\\")\\n35\\t    expect(page.get_by_text(\\\"buy milk\\\")).to_be_visible()\\n36\\t\\n37\\t\\n38\\tdef test_the_input_clears_after_adding(page):\\n39\\t    add_task(page, \\\"buy milk\\\")\\n40\\t    expect(page.get_by_label(\\\"Task title\\\")).to_have_value(\\\"\\\")\\n41\\t\\n42\\t\\n43\\tdef test_completing_a_task_strikes_it_through(page):\\n44\\t    add_task(page, \\\"buy milk\\\")\\n45\\t    page.get_by_role(\\\"button\\\", name=\\\"Complete buy milk\\\").click()\\n46\\t    expect(page.locator(\\\"li.task.done\\\")).to_have_count(1)\\n47\\t\\n48\\t\\n49\\tdef test_completing_a_task_hides_its_done_button(page):\\n50\\t    add_task(page, \\\"buy milk\\\")\\n51\\t    page.get_by_role(\\\"button\\\", name=\\\"Complete buy milk\\\").click()\\n52\\t    expect(page.get_by_role(\\\"button\\\", name=\\\"Complete buy milk\\\")).to_have_count(0)\\n53\\t\\n54\\t\\n55\\tdef test_deleting_a_task_removes_it(page):\\n56\\t    add_task(page, \\\"buy milk\\\")\\n57\\t    page.get_by_role(\\\"button\\\", name=\\\"Delete buy milk\\\").click()\\n58\\t    expect(page.get_by_text(\\\"Nothing to do yet.\\\")).to_be_visible()\\n59\\t\\n60\\t\\n61\\tdef test_add_is_disabled_until_something_is_typed(page):\\n62\\t    expect(page.get_by_role(\\\"button\\\", name=\\\"Add\\\")).to_be_disabled()\\n63\\t    page.get_by_label(\\\"Task title\\\").fill(\\\"x\\\")\\n64\\t    expect(page.get_by_role(\\\"button\\\", name=\\\"Add\\\")).to_be_enabled()\\n65\\t\\n66\\t\\n67\\tdef test_two_tasks_both_appear(page):\\n68\\t    add_task(page, \\\"first task\\\")\\n69\\t    add_task(page, \\\"second task\\\")\\n70\\t    expect(page.locator(\\\"li.task\\\")).to_have_count(2)\\n71\\t\\n72\\t\\n73\\tdef test_default_filter_is_all_and_marked_active(page):\\n74\\t    expect(page.get_by_role(\\\"button\\\", name=\\\"All\\\")).to_have_attribute(\\\"aria-pressed\\\", \\\"true\\\")\\n75\\t\\n76\\t\\n77\\tdef test_selecting_a_filter_marks_it_active_and_others_inactive(page):\\n78\\t    select_filter(page, \\\"Open\\\")\\n79\\t    expect(page.get_by_role(\\\"button\\\", name=\\\"Open\\\")).to_have_attribute(\\\"aria-pressed\\\", \\\"true\\\")\\n80\\t    expect(page.get_by_role(\\\"button\\\", name=\\\"All\\\")).to_have_attribute(\\\"aria-pressed\\\", \\\"false\\\")\\n81\\t    expect(page.get_by_role(\\\"button\\\", name=\\\"Done\\\")).to_have_attribute(\\\"aria-pressed\\\", \\\"false\\\")\\n82\\t\\n83\\t\\n84\\tdef test_open_filter_hides_done_tasks(page):\\n85\\t    add_task(page, \\\"buy milk\\\")\\n86\\t    add_task(page, \\\"walk dog\\\")\\n87\\t    complete_task(page, \\\"buy milk\\\")\\n88\\t    select_filter(page, \\\"Open\\\")\\n89\\t    expect(page.get_by_text(\\\"buy milk\\\")).to_have_count(0)\\n90\\t    expect(page.get_by_text(\\\"walk dog\\\")).to_be_visible()\\n91\\t\\n92\\t\\n93\\tdef test_done_filter_shows_only_done_tasks(page):\\n94\\t    add_task(page, \\\"buy milk\\\")\\n95\\t    add_task(page, \\\"walk dog\\\")\\n96\\t    complete_task(page, \\\"buy milk\\\")\\n97\\t    select_filter(page, \\\"Done\\\")\\n98\\t    expect(page.get_by_text(\\\"buy milk\\\")).to_be_visible()\\n99\\t    expect(page.get_by_text(\\\"walk dog\\\")).to_have_count(0)\\n100\\t\\n101\\t\\n102\\tdef test_all_filter_shows_every_task_again(page):\\n103\\t    add_task(page, \\\"buy milk\\\")\\n104\\t    add_task(page, \\\"walk dog\\\")\\n105\\t    complete_task(page, \\\"buy milk\\\")\\n106\\t    select_filter(page, \\\"Done\\\")\\n107\\t    select_filter(page, \\\"All\\\")\\n108\\t    expect(page.get_by_text(\\\"buy milk\\\")).to_be_visible()\\n109\\t    expect(page.get_by_text(\\\"walk dog\\\")).to_be_visible()\\n110\\t\\n111\\t\\n112\\tdef test_adding_a_task_while_open_filter_is_active_shows_it(page):\\n113\\t    select_filter(page, \\\"Open\\\")\\n114\\t    add_task(page, \\\"buy milk\\\")\\n115\\t    expect(page.get_by_text(\\\"buy milk\\\")).to_be_visible()\\n116\\t\\n117\\t\\n118\\tdef test_adding_a_task_while_done_filter_is_active_hides_it_until_completed(page):\\n119\\t    select_filter(page, \\\"Done\\\")\\n120\\t    add_task(page, \\\"buy milk\\\")\\n121\\t    expect(page.get_by_text(\\\"buy milk\\\")).to_have_count(0)\\n122\\t\\n123\\t\\n124\\tdef test_completing_a_task_removes_it_from_open_view_live(page):\\n125\\t    add_task(page, \\\"buy milk\\\")\\n126\\t    select_filter(page, \\\"Open\\\")\\n127\\t    complete_task(page