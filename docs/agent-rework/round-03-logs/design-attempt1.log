{"ts": "2026-08-17T10:56:44Z", "agent": "claude", "seq": 55, "kind": "tool_result", "text": "1\tconst OPTIONS = [\n2\t  { value: 'all', label: 'All' },\n3\t  { value: 'open', label: 'Open' },\n4\t  { value: 'done', label: 'Done' },\n5\t]\n6\t\n7\texport default function TaskFilter({ value, onChange }) {\n8\t  return (\n9\t    <div className=\"task-filter\" role=\"group\" aria-label=\"Filter tasks\">\n10\t      {OPTIONS.map((opt) => (\n11\t        <button\n12\t          key={opt.value}\n13\t          type=\"button\"\n14\t          className={opt.value === value ? 'filter-option active' : 'filter-option'}\n15\t          aria-pressed={opt.value === value}\n16\t          onClick={() => onChange(opt.value)}\n17\t        >\n18\t          {opt.label}\n19\t        </button>\n20\t      ))}\n21\t    </div>\n22\t  )\n23\t}\n24\t", "meta": {"native_type": "user", "tool_use_id": "toolu_01W5QYiwvPeq44xL1bRaCJLz", "session_id": "96a0105a-64a6-440a-96f7-9609c83b15f1"}}
{"ts": "2026-08-17T10:56:44Z", "agent": "claude", "seq": 56, "kind": "tool_result", "text": "1\t\"\"\"Wire shapes. Routes return these, never bare dicts.\"\"\"\n2\tfrom pydantic import BaseModel, Field\n3\t\n4\t\n5\tclass TaskIn(BaseModel):\n6\t    title: str = Field(min_length=1, max_length=200)\n7\t\n8\t\n9\tclass Task(BaseModel):\n10\t    id: int\n11\t    title: str\n12\t    done: bool = False\n13\t", "meta": {"native_type": "user", "tool_use_id": "toolu_01MUzMpUqEf9cs4mf9U7PM7f", "session_id": "96a0105a-64a6-440a-96f7-9609c83b15f1"}}
