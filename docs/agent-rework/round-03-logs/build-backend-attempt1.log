{"ts": "2026-08-17T11:01:08Z", "agent": "claude", "seq": 22, "kind": "tool_result", "text": "def test_list_is_empty_initially(client):\n    r = client.get(\"/api/tasks\")\n    assert r.status_code == 200\n    assert r.json() == []\n\n\ndef test_create_returns_the_task(client):\n    r = client.post(\"/api/tasks\", json={\"title\": \"write the thing\"})\n    assert r.status_code == 201\n    body = r.json()\n    assert body[\"title\"] == \"write the thing\"\n    assert body[\"done\"] is False\n\n\ndef test_created_tasks_are_listed_in_id_order(client):\n    for title in (\"one\", \"two\", \"three\"):\n        client.post(\"/api/tasks\", json={\"title\": title})\n    assert [t[\"title\"] for t in client.get(\"/api/tasks\").json()] == [\"one\", \"two\", \"three\"]\n\n\ndef test_empty_title_is_rejected(client):\n    assert client.post(\"/api/tasks\", json={\"title\": \"\"}).status_code == 422\n\n\ndef test_completing_a_task_sets_done(client):\n    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\"}).json()[\"id\"]\n    assert client.post(f\"/api/tasks/{task_id}/done\").json()[\"done\"] is True\n\n\ndef test_completing_a_missing_task_is_404(client):\n    assert client.post(\"/api/tasks/999/done\").status_code == 404\n\n\ndef test_delete_removes_it(client):\n    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\"}).json()[\"id\"]\n    assert client.delete(f\"/api/tasks/{task_id}\").status_code == 204\n    assert client.get(\"/api/tasks\").json() == []\n\n\ndef test_deleting_a_missing_task_is_404(client):\n    assert client.delete(\"/api/tasks/999\").status_code == 404\n\n\ndef test_updating_title_changes_it(client):\n    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\"}).json()[\"id\"]\n    r = client.patch(f\"/api/tasks/{task_id}\", json={\"title\": \"y\"})\n    assert r.status_code == 200\n    assert r.json()[\"title\"] == \"y\"\n\n\ndef test_updating_title_does_not_change_done_or_id(client):\n    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\"}).json()[\"id\"]\n    client.post(f\"/api/tasks/{task_id}/done\")\n    body = client.patch(f\"/api/tasks/{task_id}\", json={\"title\": \"y\"}).json()\n    assert body[\"id\"] == task_id\n    assert body[\"done\"] is True\n\n\ndef test_updating_a_missing_task_is_404(client):\n    assert client.patch(\"/api/tasks/999\", json={\"title\": \"y\"}).status_code == 404\n\n\ndef test_updating_with_empty_title_is_rejected(client):\n    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\"}).json()[\"id\"]\n    r = client.patch(f\"/api/tasks/{task_id}\", json={\"title\": \"\"})\n    assert r.status_code == 422\n    assert client.get(\"/api/tasks\").json()[0][\"title\"] == \"x\"\n\n\ndef test_updating_title_at_max_length_succeeds(client):\n    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\"}).json()[\"id\"]\n    title = \"a\" * 200\n    r = client.patch(f\"/api/tasks/{task_id}\", json={\"title\": title})\n    assert r.status_code == 200\n    assert r.json()[\"title\"] == title\n\n\ndef test_updating_title_beyond_max_length_is_rejected(client):\n    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\"}).json()[\"id\"]\n    r = client.patch(f\"/api/tasks/{task_id}\", json={\"title\": \"a\" * 201})\n    assert r.status_code == 422\n    assert client.get(\"/api/tasks\").json()[0][\"title\"] == \"x\"\n=== conftest ===\nimport os\nimport sys\n\nimport pytest\nfrom fastapi.testclient import TestClient\n\nsys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))\n\nfrom app.main import app          # noqa: E402\nfrom app.store import store       # noqa: E402\n\n\n@pytest.fixture(autouse=True)\ndef _clean_store():\n    \"\"\"Each test starts from an empty store -- the store is module-level, so\n    without this the tests would depend on each other's leftovers.\"\"\"\n    store.reset()\n    yield\n    store.reset()\n\n\n@pytest.fixture\ndef client():\n    return TestClient(app)", "meta": {"native_type": "user", "tool_use_id": "toolu_01WFpmESqHMt3E7tZAJQEdNL", "session_id": "7f5e0a1a-3392-4c0e-af12-a01e18a479a1"}}
