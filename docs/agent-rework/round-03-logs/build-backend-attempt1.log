{"ts": "2026-08-17T11:01:55Z", "agent": "claude", "seq": 50, "kind": "tool_use", "text": "Edit", "meta": {"native_type": "assistant", "block_type": "tool_use", "tool_use_id": "toolu_01Fhu16fKmjP7vxvcfswhHvt", "input": {"replace_all": false, "file_path": "/home/dev/projects/test-project/backend/tests/test_tasks.py", "old_string": "def test_updating_title_beyond_max_length_is_rejected(client):\n    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\"}).json()[\"id\"]\n    r = client.patch(f\"/api/tasks/{task_id}\", json={\"title\": \"a\" * 201})\n    assert r.status_code == 422\n    assert client.get(\"/api/tasks\").json()[0][\"title\"] == \"x\"", "new_string": "def test_updating_title_beyond_max_length_is_rejected(client):\n    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\"}).json()[\"id\"]\n    r = client.patch(f\"/api/tasks/{task_id}\", json={\"title\": \"a\" * 201})\n    assert r.status_code == 422\n    assert client.get(\"/api/tasks\").json()[0][\"title\"] == \"x\"\n\n\ndef test_create_defaults_to_normal_priority(client):\n    r = client.post(\"/api/tasks\", json={\"title\": \"x\"})\n    assert r.json()[\"priority\"] == \"normal\"\n\n\ndef test_create_with_explicit_priority(client):\n    r = client.post(\"/api/tasks\", json={\"title\": \"x\", \"priority\": \"high\"})\n    assert r.status_code == 201\n    assert r.json()[\"priority\"] == \"high\"\n\n\ndef test_create_with_invalid_priority_is_rejected(client):\n    r = client.post(\"/api/tasks\", json={\"title\": \"x\", \"priority\": \"urgent\"})\n    assert r.status_code == 422\n    assert client.get(\"/api/tasks\").json() == []\n\n\ndef test_updating_priority_changes_it(client):\n    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\"}).json()[\"id\"]\n    r = client.patch(f\"/api/tasks/{task_id}/priority\", json={\"priority\": \"high\"})\n    assert r.status_code == 200\n    assert r.json()[\"priority\"] == \"high\"\n\n\ndef test_updating_priority_does_not_change_title_id_or_done(client):\n    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\"}).json()[\"id\"]\n    client.post(f\"/api/tasks/{task_id}/done\")\n    body = client.patch(f\"/api/tasks/{task_id}/priority\", json={\"priority\": \"low\"}).json()\n    assert body[\"id\"] == task_id\n    assert body[\"title\"] == \"x\"\n    assert body[\"done\"] is True\n\n\ndef test_updating_priority_of_a_missing_task_is_404(client):\n    assert client.patch(\"/api/tasks/999/priority\", json={\"priority\": \"high\"}).status_code == 404\n\n\ndef test_updating_priority_with_invalid_value_is_rejected(client):\n    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\"}).json()[\"id\"]\n    r = client.patch(f\"/api/tasks/{task_id}/priority\", json={\"priority\": \"urgent\"})\n    assert r.status_code == 422\n    assert client.get(\"/api/tasks\").json()[0][\"priority\"] == \"normal\"\n\n\ndef test_updating_title_leaves_priority_untouched(client):\n    task_id = client.post(\"/api/tasks\", json={\"title\": \"x\", \"priority\": \"high\"}).json()[\"id\"]\n    body = client.patch(f\"/api/tasks/{task_id}\", json={\"title\": \"y\"}).json()\n    assert body[\"priority\"] == \"high\""}, "session_id": "7f5e0a1a-3392-4c0e-af12-a01e18a479a1"}}
