by_role(\"status\")).to_have_text(\"1 task open \u00b7 0 tasks done\")\n\n\ndef test_completing_a_task_moves_it_from_open_to_done_count(page):\n    add_task(page, \"buy milk\")\n    complete_task(page, \"buy milk\")\n    expect(page.get_by_role(\"status\")).to_have_text(\"0 tasks open \u00b7 1 task done\")\n\n\ndef test_deleting_an_open_task_decreases_only_the_open_count(page):\n    add_task(page, \"buy milk\")\n    add_task(page, \"walk dog\")\n    page.get_by_role(\"button\", name=\"Delete buy milk\").click()\n    expect(page.get_by_role(\"status\")).to_have_text(\"1 task open \u00b7 0 tasks done\")\n\n\ndef test_deleting_a_done_task_decreases_only_the_done_count(page):\n    add_task(page, \"buy milk\")\n    add_task(page, \"walk dog\")\n    complete_task(page, \"buy milk\")\n    page.get_by_role(\"button\", name=\"Delete buy milk\").click()\n    expect(page.get_by_role(\"status\")).to_have_text(\"1 task open \u00b7 0 tasks done\")\n\n\ndef test_clear_completed_decreases_done_count_by_n_and_leaves_open_unchanged(page):\n    add_task(page, \"buy milk\")\n    add_task(page, \"walk dog\")\n    add_task(page, \"wash car\")\n    complete_task(page, \"buy milk\")\n    complete_task(page, \"walk dog\")\n    page.get_by_role(\"button\", name=\"Clear completed (2)\").click()\n    expect(page.get_by_role(\"status\")).to_have_text(\"1 task open \u00b7 0 tasks done\")\n\n\ndef test_counts_reflect_true_totals_not_the_active_filter(page):\n    add_task(page, \"buy milk\")\n    add_task(page, \"walk dog\")\n    complete_task(page, \"buy milk\")\n    select_filter(page, \"Done\")\n    expect(page.get_by_role(\"status\")).to_have_text(\"1 task open \u00b7 1 task done\")\n\n\ndef test_counts_are_not_shown_while_the_list_is_loading(page):\n    page.route(\n        \"**/api/tasks\",\n        lambda route: route.continue_() if route.request.method != \"GET\"\n        else time.sleep(1) or route.continue_(),\n    )\n    page.reload()\n    expect(page.get_by_role(\"status\")).to_have_count(0)\n    expect(page.get_by_role(\"status\")).to_be_visible()"}, "session_id": "a1a9fb2d-6eda-4780-a0e2-d3742e9e5fcd"}}
