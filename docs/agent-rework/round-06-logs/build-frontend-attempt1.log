pi.clearCompleted())} />\n59\t      </div>\n60\t      {loading ? (\n61\t        <p className=\"loading\">Loading\u2026</p>\n62\t      ) : (\n63\t        <TaskList\n64\t          tasks={sortedTasks}\n65\t          filter={filter}\n66\t          onComplete={(id) => run(() => api.completeTask(id))}\n67\t          onDelete={(id) => run(() => api.deleteTask(id))}\n68\t          onUpdate={(id, title) => run(() => api.updateTask(id, title))}\n69\t          onPriorityChange={(id, priority) => run(() => api.setPriority(id, priority))}\n70\t        />\n71\t      )}\n72\t    </main>\n73\t  )\n74\t}\n75\t", "meta": {"native_type": "user", "tool_use_id": "toolu_01AuAt3Y54LWm8vZ5Kspxd2n", "session_id": "eb1aff4e-108a-4bde-8658-8db081cacd36"}}
