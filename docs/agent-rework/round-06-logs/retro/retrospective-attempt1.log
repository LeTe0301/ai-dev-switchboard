{"ts": "2026-08-17T12:25:06Z", "agent": "claude-edits", "seq": 191, "kind": "tool_result", "text": "60\tdef build_prompt(role, scope, stage, context, conventions=None):\n61\t    \"\"\"The full briefing for one stage dispatch.\n62\t\n63\t    A headless agent gets exactly one prompt and has no memory of the run, so\n64\t    everything it needs is assembled here explicitly rather than assumed.\n65\t    \"\"\"\n66\t    parts = []\n67\t    definition = rolesmod.role_definition(role) if hasattr(role, \"definition\") else \"\"\n68\t    if definition:\n69\t        parts.append(definition)\n70\t\n71\t    conv = conventions if conventions is not None else conventions_text()\n72\t    if conv:\n73\t        parts.append(\"# Shared conventions\\n\\n\" + conv)\n74\t\n75\t    brief = [\"# This dispatch\", \"\", \"**Stage:** %s\" % stage.name]\n76\t    if scope:\n77\t        brief.append(\"**Your scope:** %s \u2014 stay strictly inside it. Another agent \"\n78\t                     \"may be working on a different scope of the same change \"\n79\t                     \"right now, so do not edit outside yours.\" % scope)\n80\t    if stage.purpose:\n81\t        brief.append(\"**What this stage is for:** %s\" % stage.purpose)\n82\t    attempt = context.get(\"attempt\", 1)\n83\t    if attempt > 1:\n84\t        brief.append(\"**Attempt %d.** This stage has run before in this cycle.\" % attempt)\n85\t    parts.append(\"\\n\".join(brief))\n86\t\n87\t    parts.append(\"# The request\\n\\n\" + (context.get(\"task\") or \"\"))\n88\t\n89\t    prior = context.get(\"prior\") or {}\n90\t    if prior:\n91\t        chunks = [\"# What earlier stages produced\", \"\"]\n92\t        for name in [s.name for s in pipemod.DEFAULT_STAGES if s.name in prior]:\n93\t            chunks.append(\"## Stage: %s\\n\\n%s\\n\" % (name, _clip(prior[name], PRIOR_MAX_CHARS,\n94\t                                                                \"%s output\" % name)))\n95\t        parts.append(\"\\n\".join(chunks))\n96\t\n97\t    feedback = context.get(\"feedback\")\n98\t    if feedback:\n99\t        parts.append(\n100\t            \"# You are being asked to fix this\\n\\n\"\n101\t            \"The **%s** stage returned `%s`. Address every must-fix item below, at \"\n102\t            \"the root cause rather than the symptom. If one of these findings is \"\n103\t            \"actually wrong, or the fix it implies would be worse than the problem, \"\n104\t            \"say so instead of complying silently.\\n\\n%s\"\n105\t            % (feedback[\"from\"], feedback[\"verdict\"],\n106\t               _clip(feedback[\"report\"], PRIOR_MAX_CHARS, \"report\")))\n107\t\n108\t    return _clip(\"\\n\\n---\\n\\n\".join(p for p in parts if p), PROMPT_MAX_CHARS, \"prompt\")\n109\t\n110\t\n111\tdef make_dispatcher(workdir, roles, log_dir=None, timeout=STAGE_TIMEOUT_SECONDS,\n112\t                    agent_run=None, on_dispatch=None):\n113\t    \"\"\"\n114\t    A `dispatch` callable for PipelineRun.\n115\t\n116\t    `agent_run` is injectable for the same reason pipeline.py's dispatch is:\n117\t    so this module's own prompt assembly can be tested without spawning\n118\t    anything.\n119\t    \"\"\"\n120\t    if agent_run is None:\n121\t        import teams\n122\t        agent_run = teams.agent_run\n123\t    runner = agent_run\n124\t    conventions = conventions_text()\n125\t\n126\t    def dispatch(role_name, scope, stage, context):\n127\t        role = roles.get(role_name)\n128\t        if role is None:\n129\t            return False, \"\", \"role %r is not configured\" % role_name\n130\t        if not role.usable:\n131\t            return False, \"\", \"role %r has no engine\" % role_name\n132\t\n133\t        prompt = build_prompt(role, scope, stage, context, conventions=conventions)\n134\t        log_path = None\n135\t        if log_dir:\n136\t            os.makedirs(log_dir, exist_ok=True)\n137\t            log_path = os.path.join(\n138\t                log_dir, \"%s%s-attempt%d.log\"\n139\t                % (stage.name, \"-\" + scope if scope else \"\", context.get(\"attempt\", 1)))", "meta": {"native_type": "user", "tool_use_id": "toolu_01F7tB6nwqtxdEuggqB8gY9Q", "session_id": "744b1940-c4ba-4635-afb0-ac675d200ec2"}}
