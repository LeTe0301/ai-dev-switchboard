{"ts": "2026-08-17T12:09:16Z", "agent": "claude", "seq": 23, "kind": "tool_result", "text": "1\t\"\"\"Route wiring only -- behaviour lives in store.py.\"\"\"\n2\tfrom fastapi import FastAPI, HTTPException\n3\tfrom fastapi.middleware.cors import CORSMiddleware\n4\t\n5\tfrom .models import ClearResult, PriorityIn, Task, TaskIn\n6\tfrom .store import store\n7\t\n8\tapp = FastAPI(title=\"test-project\")\n9\t\n10\t# A regex, not a fixed list: the dev server is reached as both localhost and\n11\t# 127.0.0.1, and the e2e harness binds it to a free port rather than 5173, so\n12\t# a hardcoded origin silently blocks every write from the browser while GETs\n13\t# keep working -- which reads as \"adding a task does nothing\".\n14\tapp.add_middleware(\n15\t    CORSMiddleware,\n16\t    allow_origin_regex=r\"http://(localhost|127\\.0\\.0\\.1):\\d+\",\n17\t    allow_methods=[\"*\"],\n18\t    allow_headers=[\"*\"],\n19\t)\n20\t\n21\t\n22\t@app.get(\"/api/tasks\", response_model=list[Task])\n23\tdef list_tasks() -> list[Task]:\n24\t    return store.list()\n25\t\n26\t\n27\t@app.post(\"/api/tasks\", response_model=Task, status_code=201)\n28\tdef create_task(payload: TaskIn) -> Task:\n29\t    return store.add(payload.title, payload.priority)\n30\t\n31\t\n32\t@app.post(\"/api/tasks/{task_id}/done\", response_model=Task)\n33\tdef complete_task(task_id: int) -> Task:\n34\t    task = store.set_done(task_id, True)\n35\t    if task is None:\n36\t        raise HTTPException(status_code=404, detail=\"no such task\")\n37\t    return task\n38\t\n39\t\n40\t@app.patch(\"/api/tasks/{task_id}/priority\", response_model=Task)\n41\tdef update_priority(task_id: int, payload: PriorityIn) -> Task:\n42\t    task = store.set_priority(task_id, payload.priority)\n43\t    if task is None:\n44\t        raise HTTPException(status_code=404, detail=\"no such task\")\n45\t    return task\n46\t\n47\t\n48\t@app.patch(\"/api/tasks/{task_id}\", response_model=Task)\n49\tdef update_task(task_id: int, payload: TaskIn) -> Task:\n50\t    task = store.update_title(task_id, payload.title)\n51\t    if task is None:\n52\t        raise HTTPException(status_code=404, detail=\"no such task\")\n53\t    return task\n54\t\n55\t\n56\t@app.delete(\"/api/tasks/completed\", response_model=ClearResult)\n57\tdef clear_completed() -> ClearResult:\n58\t    return ClearResult(count=store.clear_completed())\n59\t\n60\t\n61\t@app.delete(\"/api/tasks/{task_id}\", status_code=204)\n62\tdef delete_task(task_id: int) -> None:\n63\t    if not store.delete(task_id):\n64\t        raise HTTPException(status_code=404, detail=\"no such task\")\n65\t", "meta": {"native_type": "user", "tool_use_id": "toolu_01MbdTFJiTF1bhEyLZnjTKWu", "session_id": "af69a51a-65ab-43c5-a509-abdf1673915b"}}
{"ts": "2026-08-17T12:09:16Z", "agent": "claude", "seq": 24, "kind": "tool_result", "text": "1\t\"\"\"Wire shapes. Routes return these, never bare dicts.\"\"\"\n2\tfrom typing import Literal\n3\t\n4\tfrom pydantic import BaseModel, Field\n5\t\n6\tPriority = Literal[\"low\", \"normal\", \"high\"]\n7\t\n8\t\n9\tclass TaskIn(BaseModel):\n10\t    title: str = Field(min_length=1, max_length=200)\n11\t    priority: Priority = \"normal\"\n12\t\n13\t\n14\tclass PriorityIn(BaseModel):\n15\t    priority: Priority\n16\t\n17\t\n18\tclass Task(BaseModel):\n19\t    id: int\n20\t    title: str\n21\t    done: bool = False\n22\t    priority: Priority = \"normal\"\n23\t\n24\t\n25\tclass ClearResult(BaseModel):\n26\t    count: int\n27\t", "meta": {"native_type": "user", "tool_use_id": "toolu_01Se5Cb6tNkJ3TR2DzmjBXkv", "session_id": "af69a51a-65ab-43c5-a509-abdf1673915b"}}
