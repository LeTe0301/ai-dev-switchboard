{"ts": "2026-08-17T12:02:50Z", "agent": "claude", "seq": 41, "kind": "tool_result", "text": "diff --git a/backend/tests/test_persistence.py b/backend/tests/test_persistence.py\nindex 99a5a54..492b4f5 100644\n--- a/backend/tests/test_persistence.py\n+++ b/backend/tests/test_persistence.py\n@@ -84,6 +84,22 @@ def test_id_counter_continues_after_reload(tmp_path, monkeypatch):\n     assert new_task.id == 4\n \n \n+def test_cleared_completed_tasks_do_not_reappear_after_restart(tmp_path, monkeypatch):\n+    data_file = tmp_path / \"tasks.json\"\n+    monkeypatch.setenv(\"TASKS_DATA_FILE\", str(data_file))\n+\n+    first = TaskStore()\n+    first.add(\"keep me\")\n+    first.add(\"clear me\")\n+    first.set_done(2, True)\n+    first.clear_completed()\n+\n+    second = TaskStore()\n+    tasks = second.list()\n+    assert len(tasks) == 1\n+    assert tasks[0].title == \"keep me\"\n+\n+\n def test_data_directory_is_created_on_first_write(tmp_path, monkeypatch):\n     data_file = tmp_path / \"nested\" / \"dir\" / \"tasks.json\"\n     monkeypatch.setenv(\"TASKS_DATA_FILE\", str(data_file))\ndiff --git a/backend/tests/test_tasks.py b/backend/tests/test_tasks.py\nindex 7b87eb5..5cb4cc2 100644\n--- a/backend/tests/test_tasks.py\n+++ b/backend/tests/test_tasks.py\n@@ -130,3 +130,40 @@ def test_updating_title_leaves_priority_untouched(client):\n     task_id = client.post(\"/api/tasks\", json={\"title\": \"x\", \"priority\": \"high\"}).json()[\"id\"]\n     body = client.patch(f\"/api/tasks/{task_id}\", json={\"title\": \"y\"}).json()\n     assert body[\"priority\"] == \"high\"\n+\n+\n+def test_clear_completed_on_empty_store_returns_zero(client):\n+    r = client.delete(\"/api/tasks/completed\")\n+    assert r.status_code == 200\n+    assert r.json()[\"count\"] == 0\n+\n+\n+def test_clear_completed_with_no_completed_tasks_removes_nothing(client):\n+    client.post(\"/api/tasks\", json={\"title\": \"x\"})\n+    r = client.delete(\"/api/tasks/completed\")\n+    assert r.json()[\"count\"] == 0\n+    assert len(client.get(\"/api/tasks\").json()) == 1\n+\n+\n+def test_clear_completed_removes_only_done_tasks(client):\n+    open_id = client.post(\"/api/tasks\", json={\"title\": \"open\"}).json()[\"id\"]\n+    done_id = client.post(\"/api/tasks\", json={\"title\": \"done\"}).json()[\"id\"]\n+    client.post(f\"/api/tasks/{done_id}/done\")\n+\n+    r = client.delete(\"/api/tasks/completed\")\n+    assert r.status_code == 200\n+    assert r.json()[\"count\"] == 1\n+\n+    remaining = client.get(\"/api/tasks\").json()\n+    assert [t[\"id\"] for t in remaining] == [open_id]\n+    assert remaining[0][\"done\"] is False\n+\n+\n+def test_clear_completed_leaves_no_done_tasks_in_list(client):\n+    for title in (\"a\", \"b\", \"c\"):\n+        task_id = client.post(\"/api/tasks\", json={\"title\": title}).json()[\"id\"]\n+        client.post(f\"/api/tasks/{task_id}/done\")\n+    client.post(\"/api/tasks\", json={\"title\": \"open\"})\n+\n+    client.delete(\"/api/tasks/completed\")\n+    assert all(not t[\"done\"] for t in client.get(\"/api/tasks\").json())", "meta": {"native_type": "user", "tool_use_id": "toolu_016JgsVBPcQFnuwthM49sHnK", "session_id": "08601e55-96d8-4d8a-bc6a-06fcd683a3eb"}}
