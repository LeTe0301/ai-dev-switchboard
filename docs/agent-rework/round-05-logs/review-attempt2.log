{"ts": "2026-08-17T12:03:16Z", "agent": "claude", "seq": 73, "kind": "tool_result", "text": "import os\nimport sys\nimport tempfile\n\nimport pytest\nfrom fastapi.testclient import TestClient\n\nsys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))\n\n# Must happen before `app.main` is imported: that import constructs the\n# module-level `store` singleton, and its data-file path is fixed at\n# construction time. Without this, tests would load from and write to the\n# real data file a locally-running server uses.\nos.environ[\"TASKS_DATA_FILE\"] = os.path.join(tempfile.mkdtemp(), \"tasks.json\")\n\nfrom app.main import app          # noqa: E402\nfrom app.store import store       # noqa: E402\n\n\n@pytest.fixture(autouse=True)\ndef _clean_store():\n    \"\"\"Each test starts from an empty store -- the store is module-level, so\n    without this the tests would depend on each other's leftovers.\"\"\"\n    store.reset()\n    yield\n    store.reset()\n\n\n@pytest.fixture\ndef client():\n    return TestClient(app)", "meta": {"native_type": "user", "tool_use_id": "toolu_011Q5Bwcfd391TauPq2f4nfD", "session_id": "08601e55-96d8-4d8a-bc6a-06fcd683a3eb"}}
