": \"y\"}).json()\n132\t    assert body[\"priority\"] == \"high\"\n133\t\n134\t\n135\tdef test_clear_completed_on_empty_store_returns_zero(client):\n136\t    r = client.delete(\"/api/tasks/completed\")\n137\t    assert r.status_code == 200\n138\t    assert r.json()[\"count\"] == 0\n139\t\n140\t\n141\tdef test_clear_completed_with_no_completed_tasks_removes_nothing(client):\n142\t    client.post(\"/api/tasks\", json={\"title\": \"x\"})\n143\t    r = client.delete(\"/api/tasks/completed\")\n144\t    assert r.json()[\"count\"] == 0\n145\t    assert len(client.get(\"/api/tasks\").json()) == 1\n146\t\n147\t\n148\tdef test_clear_completed_removes_only_done_tasks(client):\n149\t    open_id = client.post(\"/api/tasks\", json={\"title\": \"open\"}).json()[\"id\"]\n150\t    done_id = client.post(\"/api/tasks\", json={\"title\": \"done\"}).json()[\"id\"]\n151\t    client.post(f\"/api/tasks/{done_id}/done\")\n152\t\n153\t    r = client.delete(\"/api/tasks/completed\")\n154\t    assert r.status_code == 200\n155\t    assert r.json()[\"count\"] == 1\n156\t\n157\t    remaining = client.get(\"/api/tasks\").json()\n158\t    assert [t[\"id\"] for t in remaining] == [open_id]\n159\t    assert remaining[0][\"done\"] is False\n160\t\n161\t\n162\tdef test_clear_completed_leaves_no_done_tasks_in_list(client):\n163\t    for title in (\"a\", \"b\", \"c\"):\n164\t        task_id = client.post(\"/api/tasks\", json={\"title\": title}).json()[\"id\"]\n165\t        client.post(f\"/api/tasks/{task_id}/done\")\n166\t    client.post(\"/api/tasks\", json={\"title\": \"open\"})\n167\t\n168\t    client.delete(\"/api/tasks/completed\")\n169\t    assert all(not t[\"done\"] for t in client.get(\"/api/tasks\").json())\n170\t", "meta": {"native_type": "user", "tool_use_id": "toolu_01MAWXEKNYcwSqyj1i6ybo8V", "session_id": "e5bac698-42a1-4525-9134-7ad9880fb352"}}
