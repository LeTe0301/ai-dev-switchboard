ne_tasks_in_list(client):\n    for title in (\"a\", \"b\", \"c\"):\n        task_id = client.post(\"/api/tasks\", json={\"title\": title}).json()[\"id\"]\n        client.post(f\"/api/tasks/{task_id}/done\")\n    client.post(\"/api/tasks\", json={\"title\": \"open\"})\n\n    client.delete(\"/api/tasks/completed\")\n    assert all(not t[\"done\"] for t in client.get(\"/api/tasks\").json())"}, "session_id": "a08aef13-3276-4679-921c-60d5cb97c247"}}
