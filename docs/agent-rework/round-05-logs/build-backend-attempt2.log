{"ts": "2026-08-17T12:01:20Z", "agent": "claude", "seq": 89, "kind": "tool_result", "text": "1\timport json\n2\t\n3\tfrom app.store import TaskStore\n4\t\n5\t\n6\tdef test_state_survives_a_simulated_restart(tmp_path, monkeypatch):\n7\t    data_file = tmp_path / \"tasks.json\"\n8\t    monkeypatch.setenv(\"TASKS_DATA_FILE\", str(data_file))\n9\t\n10\t    first = TaskStore()\n11\t    first.add(\"write the thing\", priority=\"high\")\n12\t    first.set_done(1, True)\n13\t\n14\t    second = TaskStore()\n15\t    tasks = second.list()\n16\t    assert len(tasks) == 1\n17\t    assert tasks[0].id == 1\n18\t    assert tasks[0].title == \"write the thing\"\n19\t    assert tasks[0].done is True\n20\t    assert tasks[0].priority == \"high\"\n21\t\n22\t\n23\tdef test_missing_file_starts_empty(tmp_path, monkeypatch):\n24\t    monkeypatch.setenv(\"TASKS_DATA_FILE\", str(tmp_path / \"does-not-exist.json\"))\n25\t\n26\t    store = TaskStore()\n27\t\n28\t    assert store.list() == []\n29\t\n30\t\n31\tdef test_corrupt_json_starts_empty(tmp_path, monkeypatch):\n32\t    data_file = tmp_path / \"tasks.json\"\n33\t    data_file.write_text(\"{not valid json\")\n34\t    monkeypatch.setenv(\"TASKS_DATA_FILE\", str(data_file))\n35\t\n36\t    store = TaskStore()\n37\t\n38\t    assert store.list() == []\n39\t\n40\t\n41\tdef test_wrong_top_level_shape_starts_empty(tmp_path, monkeypatch):\n42\t    data_file = tmp_path / \"tasks.json\"\n43\t    data_file.write_text(json.dumps({\"not\": \"a list\"}))\n44\t    monkeypatch.setenv(\"TASKS_DATA_FILE\", str(data_file))\n45\t\n46\t    store = TaskStore()\n47\t\n48\t    assert store.list() == []\n49\t\n50\t\n51\tdef test_wrong_item_shape_starts_empty(tmp_path, monkeypatch):\n52\t    data_file = tmp_path / \"tasks.json\"\n53\t    data_file.write_text(json.dumps([{\"foo\": \"bar\"}]))\n54\t    monkeypatch.setenv(\"TASKS_DATA_FILE\", str(data_file))\n55\t\n56\t    store = TaskStore()\n57\t\n58\t    assert store.list() == []\n59\t\n60\t\n61\tdef test_empty_file_starts_empty(tmp_path, monkeypatch):\n62\t    data_file = tmp_path / \"tasks.json\"\n63\t    data_file.write_text(\"\")\n64\t    monkeypatch.setenv(\"TASKS_DATA_FILE\", str(data_file))\n65\t\n66\t    store = TaskStore()\n67\t\n68\t    assert store.list() == []\n69\t\n70\t\n71\tdef test_id_counter_continues_after_reload(tmp_path, monkeypatch):\n72\t    data_file = tmp_path / \"tasks.json\"\n73\t    monkeypatch.setenv(\"TASKS_DATA_FILE\", str(data_file))\n74\t\n75\t    first = TaskStore()\n76\t    first.add(\"one\")\n77\t    first.add(\"two\")\n78\t    first.add(\"three\")\n79\t    first.delete(2)\n80\t\n81\t    second = TaskStore()\n82\t    new_task = second.add(\"four\")\n83\t\n84\t    assert new_task.id == 4\n85\t\n86\t\n87\tdef test_cleared_completed_tasks_do_not_reappear_after_restart(tmp_path, monkeypatch):\n88\t    data_file = tmp_path / \"tasks.json\"\n89\t    monkeypatch.setenv(\"TASKS_DATA_FILE\", str(data_file))\n90\t\n91\t    first = TaskStore()\n92\t    first.add(\"keep me\")\n93\t    first.add(\"clear me\")\n94\t    first.set_done(2, True)\n95\t    first.clear_completed()\n96\t\n97\t    second = TaskStore()\n98\t    tasks = second.list()\n99\t    assert len(tasks) == 1\n100\t    assert tasks[0].title == \"keep me\"\n101\t\n102\t\n103\tdef test_data_directory_is_created_on_first_write(tmp_path, monkeypatch):\n104\t    data_file = tmp_path / \"nested\" / \"dir\" / \"tasks.json\"\n105\t    monkeypatch.setenv(\"TASKS_DATA_FILE\", str(data_file))\n106\t\n107\t    store = TaskStore()\n108\t    store.add(\"x\")\n109\t\n110\t    assert data_file.exists()\n111\t    assert json.loads(data_file.read_text())[0][\"title\"] == \"x\"\n112\t", "meta": {"native_type": "user", "tool_use_id": "toolu_01SxLt7WdYzfyrqHARV5M1ai", "session_id": "a08aef13-3276-4679-921c-60d5cb97c247"}}
