{"ts": "2026-08-17T12:00:39Z", "agent": "claude", "seq": 49, "kind": "tool_result", "text": "\"\"\"Wire shapes. Routes return these, never bare dicts.\"\"\"$\nfrom typing import Literal$\n$\nfrom pydantic import BaseModel, Field$\n$\nPriority = Literal[\"low\", \"normal\", \"high\"]$\n$\n$\nclass TaskIn(BaseModel):$\n    title: str = Field(min_length=1, max_length=200)$\n    priority: Priority = \"normal\"$\n$\n$\nclass PriorityIn(BaseModel):$\n    priority: Priority$\n$\n$\nclass Task(BaseModel):$\n    id: int$\n    title: str$\n    done: bool = False$\n    priority: Priority = \"normal\"$\n$\n$\nclass ClearResult(BaseModel):$\n    count: int$\n$\n$\nclass ClearResult(BaseModel):$\n    count: int$\n---STORE---\n94:    def clear_completed(self) -> int:\n102:    def clear_completed(self) -> int:", "meta": {"native_type": "user", "tool_use_id": "toolu_01Wfzf4icgCCpMQA2xKrjy6Y", "session_id": "a08aef13-3276-4679-921c-60d5cb97c247"}}
