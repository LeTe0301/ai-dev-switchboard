   assert r.json()[\"count\"] == 0\n    assert len(client.get(\"/api/tasks\").json()) == 1\n\n\ndef test_clear_completed_removes_only_done_tasks(client):\n    open_id = client.post(\"/api/tasks\", json={\"title\": \"open\"}).json()[\"id\"]\n    done_id = client.post(\"/api/tasks\", json={\"title\": \"done\"}).json()[\"id\"]\n    client.post(f\"/api/tasks/{done_id}/done\")\n\n    r = client.delete(\"/api/tasks/completed\")\n    assert r.status_code == 200\n    assert r.json()[\"count\"] == 1\n\n    remaining = client.get(\"/api/tasks\").json()\n    assert [t[\"id\"] for t in remaining] == [open_id]\n    assert remaining[0][\"done\"] is False\n\n\ndef test_clear_completed_leaves_no_done_task_behind(client):\n    for title in (\"a\", \"b\", \"c\"):\n        task_id = client.post(\"/api/tasks\", json={\"title\": title}).json()[\"id\"]\n        if title != \"b\":\n            client.post(f\"/api/tasks/{task_id}/done\")\n\n    client.delete(\"/api/tasks/completed\")\n\n    assert all(not t[\"done\"] for t in client.get(\"/api/tasks\").json())\n\n\ndef test_clear_completed_on_empty_store_is_not_an_error(client):\n    r = client.delete(\"/api/tasks/completed\")\n    assert r.status_code == 200\n    assert r.json()[\"count\"] == 0", "new_string": "def test_clear_completed_on_empty_store_returns_zero(client):\n    r = client.delete(\"/api/tasks/completed\")\n    assert r.status_code == 200\n    assert r.json()[\"count\"] == 0\n\n\ndef test_clear_completed_with_no_completed_tasks_removes_nothing(client):\n    client.post(\"/api/tasks\", json={\"title\": \"x\"})\n    r = client.delete(\"/api/tasks/completed\")\n    assert r.json()[\"count\"] == 0\n    assert len(client.get(\"/api/tasks\").json()) == 1\n\n\ndef test_clear_completed_removes_only_done_tasks(client):\n    open_id = client.post(\"/api/tasks\", json={\"title\": \"open\"}).json()[\"id\"]\n    done_id = client.post(\"/api/tasks\", json={\"title\": \"done\"}).json()[\"id\"]\n    client.post(f\"/api/tasks/{done_id}/done\