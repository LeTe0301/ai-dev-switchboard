{"ts": "2026-08-17T12:04:24Z", "agent": "claude", "seq": 18, "kind": "tool_result", "text": " backend/app/main.py               |   7 +-\n backend/app/models.py             |   4 +\n backend/app/store.py              |   8 ++\n backend/tests/test_persistence.py |  16 +++\n backend/tests/test_tasks.py       |  37 ++++++\n docs/design.md                    | 263 +++++++++++++++++++++++++++++++-------\n docs/spec.md                      | 246 ++++++++++++++++-------------------\n frontend/src/App.css              |  10 ++\n frontend/src/App.jsx              |   8 +-\n frontend/src/api.js               |   1 +\n 10 files changed, 417 insertions(+), 183 deletions(-)\n---main.py---\n\"\"\"Route wiring only -- behaviour lives in store.py.\"\"\"\nfrom fastapi import FastAPI, HTTPException\nfrom fastapi.middleware.cors import CORSMiddleware\n\nfrom .models import ClearResult, PriorityIn, Task, TaskIn\nfrom .store import store\n\napp = FastAPI(title=\"test-project\")\n\n# A regex, not a fixed list: the dev server is reached as both localhost and\n# 127.0.0.1, and the e2e harness binds it to a free port rather than 5173, so\n# a hardcoded origin silently blocks every write from the browser while GETs\n# keep working -- which reads as \"adding a task does nothing\".\napp.add_middleware(\n    CORSMiddleware,\n    allow_origin_regex=r\"http://(localhost|127\\.0\\.0\\.1):\\d+\",\n    allow_methods=[\"*\"],\n    allow_headers=[\"*\"],\n)\n\n\n@app.get(\"/api/tasks\", response_model=list[Task])\ndef list_tasks() -> list[Task]:\n    return store.list()\n\n\n@app.post(\"/api/tasks\", response_model=Task, status_code=201)\ndef create_task(payload: TaskIn) -> Task:\n    return store.add(payload.title, payload.priority)\n\n\n@app.post(\"/api/tasks/{task_id}/done\", response_model=Task)\ndef complete_task(task_id: int) -> Task:\n    task = store.set_done(task_id, True)\n    if task is None:\n        raise HTTPException(status_code=404, detail=\"no such task\")\n    return task\n\n\n@app.patch(\"/api/tasks/{task_id}/priority\", response_model=Task)\ndef update_priority(task_id: int, payload: PriorityIn) -> Task:\n    task = store.set_priority(task_id, payload.priority)\n    if task is None:\n        raise HTTPException(status_code=404, detail=\"no such task\")\n    return task\n\n\n@app.patch(\"/api/tasks/{task_id}\", response_model=Task)\ndef update_task(task_id: int, payload: TaskIn) -> Task:\n    task = store.update_title(task_id, payload.title)\n    if task is None:\n        raise HTTPException(status_code=404, detail=\"no such task\")\n    return task\n\n\n@app.delete(\"/api/tasks/completed\", response_model=ClearResult)\ndef clear_completed() -> ClearResult:\n    return ClearResult(count=store.clear_completed())\n\n\n@app.delete(\"/api/tasks/{task_id}\", status_code=204)\ndef delete_task(task_id: int) -> None:\n    if not store.delete(task_id):\n        raise HTTPException(status_code=404, detail=\"no such task\")\n---store.py---\n\"\"\"In-memory task store, backed by a JSON snapshot on disk.\n\nDeliberately not a database: this project exists to exercise a development\npipeline, and a real datastore would add setup cost to every cycle without\nadding anything to test. Adding one is a decision, not an implementation\ndetail. Disk persistence here is just a full-snapshot write on every\nmutation -- the simplest thing that survives a restart, not a WAL.\n\"\"\"\nimport json\nimport logging\nimport os\nfrom pathlib import Path\nfrom typing import Optional\n\nfrom .models import Priority, Task\n\nlogger = logging.getLogger(__name__)\n\nDEFAULT_DATA_FILE = Path(__file__).resolve().parent.parent / \"data\" / \"tasks.json\"\n\n\nclass TaskStore:\n    def __init__(self):\n        self._data_file = Path(os.environ.get(\"TASKS_DATA_FILE\", DEFAULT_DATA_FILE))\n        self._tasks: dict[int, Task] = {}\n        self._next_id = 1\n        self._load()\n\n    def _load(self) -> None:\n        try:\n            raw = json.loads(self._data_file.read_text())\n            tasks = [Task(**item) for item in raw]\n        except FileNotFoundError:\n            return\n        except Exception:\n            logger.warning(\n                \"Could not parse %s; starting with an empty task list.\",\n                self._data_file,\n            )\n            return\n        self._tasks = {task.id: task for task in tasks}\n        self._next_id = max(self._tasks, default=0) + 1\n\n    def _save(self) -> None:\n        self._data_file.parent.mkdir(parents=True, exist_ok=True)\n        payload = json.dumps([task.model_dump() for task in self.list()])\n        tmp_file = self._data_file.with_suffix(f\"{self._data_file.suffix}.tmp\")\n        tmp_file.write_text(payload)\n        os.replace(tmp_file, self._data_file)\n\n    def list(self) -> list[Task]:\n        return [self._tasks[k] for k in sorted(self._tasks)]\n\n    def add(self, title: str, priority: Priority = \"normal\") -> Task:\n        task = Task(id=self._next_id, title=title, priority=priority)\n        self._tasks[task.id] = task\n        self._next_id += 1\n        self._save()\n        return task\n\n    def get(self, task_id: int) -> Optional[Task]:\n        return self._tasks.get(task_id)\n\n    def set_done(self, task_id: int, done: bool) -> Optional[Task]:\n        task = self._tasks.get(task_id)\n        if task is None:\n            return None\n        task.done = done\n        self._save()\n        return task\n\n    def set_priority(self, task_id: int, priority: Priority) -> Optional[Task]:\n        task = self._tasks.get(task_id)\n        if task is None:\n            return None\n        task.priority = priority\n        self._save()\n        return task\n\n    def update_title(self, task_id: int, title: str) -> Optional[Task]:\n        task = self._tasks.get(task_id)\n        if task is None:\n            return None\n        task.title = title\n        self._save()\n        return task\n\n    def delete(self, task_id: int) -> bool:\n        found = self._tasks.pop(task_id, None) is not None\n        if found:\n            self._save()\n        return found\n\n    def clear_completed(self) -> int:\n        done_ids = [task_id for task_id, task in self._tasks.items() if task.done]\n        for task_id in done_ids:\n            del self._tasks[task_id]\n        if done_ids:\n            self._save()\n        return len(done_ids)\n\n    def reset(self) -> None:\n        self._tasks.clear()\n        self._next_id = 1\n        self._save()\n\n\nstore = TaskStore()\n---models.py---\n\"\"\"Wire shapes. Routes return these, never bare dicts.\"\"\"\nfrom typing import Literal\n\nfrom pydantic import BaseModel, Field\n\nPriority = Literal[\"low\", \"normal\", \"high\"]\n\n\nclass TaskIn(BaseModel):\n    title: str = Field(min_length=1, max_length=200)\n    priority: Priority = \"normal\"\n\n\nclass PriorityIn(BaseModel):\n    priority: Priority\n\n\nclass Task(BaseModel):\n    id: int\n    title: str\n    done: bool = False\n    priority: Priority = \"normal\"\n\n\nclass ClearResult(BaseModel):\n    count: int", "meta": {"native_type": "user", "tool_use_id": "toolu_01GR26uzFXW2ZA2BTyjHVg3Y", "session_id": "869168bf-fd2f-4b7d-a294-9154db9db099"}}
