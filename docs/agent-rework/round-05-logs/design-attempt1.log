{"ts": "2026-08-17T11:56:22Z", "agent": "claude", "seq": 31, "kind": "tool_result", "text": "1\timport { useState } from 'react'\n2\t\n3\tconst PRIORITIES = [\n4\t  { value: 'low', label: 'Low' },\n5\t  { value: 'normal', label: 'Normal' },\n6\t  { value: 'high', label: 'High' },\n7\t]\n8\t\n9\texport default function AddTask({ onAdd }) {\n10\t  const [title, setTitle] = useState('')\n11\t  const [priority, setPriority] = useState('normal')\n12\t\n13\t  function submit(e) {\n14\t    e.preventDefault()\n15\t    const trimmed = title.trim()\n16\t    if (!trimmed) return\n17\t    onAdd(trimmed, priority)\n18\t    setTitle('')\n19\t    setPriority('normal')\n20\t  }\n21\t\n22\t  return (\n23\t    <form className=\"add-task\" onSubmit={submit}>\n24\t      <input\n25\t        value={title}\n26\t        onChange={(e) => setTitle(e.target.value)}\n27\t        placeholder=\"What needs doing?\"\n28\t        aria-label=\"Task title\"\n29\t      />\n30\t      <select\n31\t        className={`priority-select priority-${priority}`}\n32\t        value={priority}\n33\t        onChange={(e) => setPriority(e.target.value)}\n34\t        aria-label=\"Priority\"\n35\t      >\n36\t        {PRIORITIES.map((p) => <option key={p.value} value={p.value}>{p.label}</option>)}\n37\t      </select>\n38\t      <button type=\"submit\" disabled={!title.trim()}>Add</button>\n39\t    </form>\n40\t  )\n41\t}\n42\t", "meta": {"native_type": "user", "tool_use_id": "toolu_015fiHThVtMg5hLzZxvm87eB", "session_id": "227f188c-d9da-4a93-804a-9521f303ed03"}}
