{"ts": "2026-08-17T13:53:13Z", "agent": "claude", "seq": 31, "kind": "tool_result", "text": "1\timport { useEffect, useRef, useState } from 'react'\n2\timport AddTask from './components/AddTask'\n3\timport ClearCompleted from './components/ClearCompleted'\n4\timport SearchTasks from './components/SearchTasks'\n5\timport TaskCounts from './components/TaskCounts'\n6\timport TaskFilter from './components/TaskFilter'\n7\timport TaskList from './components/TaskList'\n8\timport * as api from './api'\n9\timport './App.css'\n10\t\n11\texport default function App() {\n12\t  const [tasks, setTasks] = useState([])\n13\t  const [error, setError] = useState(null)\n14\t  const [loading, setLoading] = useState(true)\n15\t  const [filter, setFilter] = useState('all')\n16\t  const [search, setSearch] = useState('')\n17\t  const [focusRequest, setFocusRequest] = useState(null)\n18\t\n19\t  const addTaskRef = useRef(null)\n20\t  // task.id -> { delete: HTMLButtonElement, done: HTMLButtonElement }. Kept\n21\t  // in a ref (not state) since it's a DOM bookkeeping cache, not something\n22\t  // that should trigger a re-render.\n23\t  const rowButtonRefs = useRef(new Map())\n24\t\n25\t  function registerRowButtonRef(id, kind, el) {\n26\t    const entry = rowButtonRefs.current.get(id) ?? {}\n27\t    if (el) {\n28\t      entry[kind] = el\n29\t      rowButtonRefs.current.set(id, entry)\n30\t    } else {\n31\t      delete entry[kind]\n32\t      if (Object.keys(entry).length === 0) rowButtonRefs.current.delete(id)\n33\t    }\n34\t  }\n35\t\n36\t  async function refresh() {\n37\t    try {\n38\t      setTasks(await api.listTasks())\n39\t      setError(null)\n40\t    } catch (e) {\n41\t      setError(e.message)\n42\t    } finally {\n43\t      setLoading(false)\n44\t    }\n45\t  }\n46\t\n47\t  useEffect(() => { refresh() }, [])\n48\t\n49\t  const stateFiltered = tasks.filter((t) => {\n50\t    if (filter === 'open') return !t.done\n51\t    if (filter === 'done') return t.done\n52\t    return true\n53\t  })\n54\t\n55\t  const searchTerm = search.trim().toLowerCase()\n56\t  const visibleTasks = stateFiltered.filter((t) =>\n57\t    t.title.toLowerCase().includes(searchTerm)\n58\t  )\n59\t\n60\t  const sortedTasks = [...visibleTasks].sort(\n61\t    (a, b) => (a.priority === 'high' ? 0 : 1) - (b.priority === 'high' ? 0 : 1)\n62\t  )\n63\t\n64\t  const completedCount = tasks.filter((t) => t.done).length\n65\t  const openCount = tasks.filter((t) => !t.done).length\n66\t\n67\t  async function run(fn) {\n68\t    try {\n69\t      await fn()\n70\t      await refresh()\n71\t      return true\n72\t    } catch (e) {\n73\t      setError(e.message)\n74\t      return false\n75\t    }\n76\t  }\n77\t\n78\t  // Where should focus land once `id`'s row is gone from view? Next visible\n79\t  // row's `kind` control, else the previous row's, else the AddTask title\n80\t  // input (AC4/AC5). Computed from `sortedTasks` before the row-removing\n81\t  // call runs, since afterwards the row is no longer in that list.\n82\t  function computeFocusFallback(id, kind) {\n83\t    const idx = sortedTasks.findIndex((t) => t.id === id)\n84\t    if (idx === -1) return { type: 'addTask' }\n85\t    const candidates = [sortedTasks[idx + 1], idx > 0 ? sortedTasks[idx - 1] : undefined]\n86\t    const next = candidates.find((t) => t)\n87\t    return next ? { type: 'row', id: next.id, kind } : { type: 'addTask' }\n88\t  }\n89\t\n90\t  async function handleDelete(id) {\n91\t    const fallback = computeFocusFallback(id, 'delete')\n92\t    const ok = await run(() => api.deleteTask(id))\n93\t    if (ok) setFocusRequest(fallback)\n94\t  }\n95\t\n96\t  async function handleComplete(id) {\n97\t    // If the current filter keeps the row visible (\"all\"/\"done\"), only the\n98\t    // Done button disappears and the row stays \u2014 no focus-loss scenario per\n99\t    // AC5, so no fallback is computed.\n100\t    const rowWillDisappear = filter === 'open'\n101\t    const fallback = rowWillDisappear ? computeFocusFallback(id, 'done') : null\n102\t    const ok = await run(() => api.completeTask(id))\n103\t    if (ok && fallback) setFocusRequest(fallback)\n104\t  }\n105\t\n106\t  useEffect(() => {\n107\t    if (!focusRequest) return\n108\t    if (focusRequest.type === 'addTask') {\n109\t      addTaskRef.current?.focus()\n110\t    } else {\n111\t      const entry = rowButtonRefs.current.get(focusRequest.id)\n112\t      const target = entry?.[focusRequest.kind] ?? entry?.delete\n113\t      if (target) target.focus()\n114\t      else addTaskRef.current?.focus()\n115\t    }\n116\t    setFocusRequest(null)\n117\t  }, [tasks, focusRequest])\n118\t\n119\t  return (\n120\t    <main className=\"app\">\n121\t      <h1>Tasks</h1>\n122\t      {!loading && <TaskCounts open={openCount} done={completedCount} />}\n123\t      <AddTask ref={addTaskRef} onAdd={(title, priority, dueDate) => run(() => api.createTask(title, priority, dueDate))} />\n124\t      {error && <p className=\"error\" role=\"alert\">{error}</p>}\n125\t      <div className=\"list-toolbar\">\n126\t        <div className=\"toolbar-filters\">\n127\t          <SearchTasks value={search} onChange={setSearch} />\n128\t          <TaskFilter value={filter} onChange={setFilter} />\n129\t        </div>\n130\t        <ClearCompleted count={completedCount} onClear={() => run(() => api.clearCompleted())} />\n131\t      </div>\n132\t      {loading ? (\n133\t        <p className=\"loading\">Loading\u2026</p>\n134\t      ) : (\n135\t        <TaskList\n136\t          tasks={sortedTasks}\n137\t          filter={filter}\n138\t          search={search}\n139\t          hasFilterResults={stateFiltered.length > 0}\n140\t          onComplete={handleComplete}\n141\t          onDelete={handleDelete}\n142\t          onUpdate={(id, title) => run(() => api.updateTask(id, title))}\n143\t          onPriorityChange={(id, priority) => run(() => api.setPriority(id, priority))}\n144\t          onDueDateChange={(id, dueDate) => run(() => api.setDueDate(id, dueDate))}\n145\t          registerRowButtonRef={registerRowButtonRef}\n146\t        />\n147\t      )}\n148\t    </main>\n149\t  )\n150\t}\n151\t", "meta": {"native_type": "user", "tool_use_id": "toolu_01DPmqKgTUGki2oBjyz2TQez", "session_id": "60bfea07-e828-480e-ac6a-3bd43110e491"}}
