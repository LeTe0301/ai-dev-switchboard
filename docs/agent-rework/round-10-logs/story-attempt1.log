 return <p className=\"empty\" aria-live=\"polite\">{message}</p>\n  }\n  return (\n    <ul className=\"task-list\">\n      {tasks.map((task) => (\n        <TaskRow\n          key={task.id}\n          task={task}\n          onComplete={onComplete}\n          onDelete={onDelete}\n          onUpdate={onUpdate}\n          onPriorityChange={onPriorityChange}\n          onDueDateChange={onDueDateChange}\n          registerRowButtonRef={registerRowButtonRef}\n        />\n      ))}\n    </ul>\n  )\n}\n\nfunction TaskRow({ task, onComplete, onDelete, onUpdate, onPriorityChange, onDueDateChange, registerRowButtonRef }) {\n  const [isEditing, setIsEditing] = useState(false)\n  const [draft, setDraft] = useState(task.title)\n  const [showError, setShowError] = useState(false)\n  const editButtonRef = useRef(null)\n  const skipNextFocusRestore = useRef(true)\n\n  // Return focus to the Edit button once the edit form closes (Escape,\n  // Cancel, or a successful Save) \u2014 AC6/AC7. The ref itself survives the\n  // isEditing toggle since TaskRow doesn't unmount, but the effect should\n  // only act on the true -> false transition, not on initial mount.\n  useEffect(() => {\n    if (skipNextFocusRestore.current) {\n      skipNextFocusRestore.current = false\n      return\n    }\n    if (!isEditing) {\n      editButtonRef.current?.focus()\n    }\n  }, [isEditing])\n\n  function startEdit() {\n    setDraft(task.title)\n    setShowError(false)\n    setIsEditing(true)\n  }\n\n  function cancel() {\n    setDraft(task.title)\n    setShowError(false)\n    setIsEditing(false)\n  }"}, "session_id": "dc5f8c4c-3ccf-4cb5-b01c-d37b1d5c560b"}}
