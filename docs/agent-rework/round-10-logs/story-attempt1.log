{"ts": "2026-08-17T13:36:36Z", "agent": "claude", "seq": 364, "kind": "tool_result", "text": "diff --git a/frontend/src/App.css b/frontend/src/App.css\nindex b7a479d..c18b111 100644\n--- a/frontend/src/App.css\n+++ b/frontend/src/App.css\n@@ -149,3 +149,25 @@ button:disabled { opacity: 0.5; cursor: not-allowed; }\n   font-weight: 600;\n   white-space: nowrap;\n }\n+\n+*:focus-visible {\n+  outline: 2px solid #0066cc;\n+  outline-offset: 2px;\n+  box-shadow: 0 0 0 2px #fff;\n+}\n+\n+/* The rule above relies on the white box-shadow ring reading as high-contrast\n+   against dark button fills. In practice an outset box-shadow with no\n+   offset/blur paints in the space immediately outside the border box, which\n+   for these two controls is either the page background (#f6f7f8) or \u2014 for\n+   .filter-option, whose siblings sit flush against it with no gap\n+   (App.css:65-74) \u2014 can be partially painted over by the next filter button\n+   in DOM order. An inset outline sits inside the control's own fill instead,\n+   so it can't be occluded by a flush neighbour and its contrast doesn't\n+   depend on what's behind the element. */\n+.filter-option.active:focus-visible,\n+.priority-select.priority-high:focus-visible {\n+  outline: 2px solid #fff;\n+  outline-offset: -4px;\n+  box-shadow: none;\n+}\ndiff --git a/frontend/src/App.jsx b/frontend/src/App.jsx\nindex e89e6d8..1c86958 100644\n--- a/frontend/src/App.jsx\n+++ b/frontend/src/App.jsx\n@@ -1,4 +1,4 @@\n-import { useEffect, useState } from 'react'\n+import { useEffect, useRef, useState } from 'react'\n import AddTask from './components/AddTask'\n import ClearCompleted from './components/ClearCompleted'\n import SearchTasks from './components/SearchTasks'\n@@ -14,6 +14,24 @@ export default function App() {\n   const [loading, setLoading] = useState(true)\n   const [filter, setFilter] = useState('all')\n   const [search, setSearch] = useState('')\n+  const [focusRequest, setFocusRequest] = useState(null)\n+\n+  const addTaskRef = useRef(null)\n+  // task.id -> { delete: HTMLButtonElement, done: HTMLButtonElement }. Kept\n+  // in a ref (not state) since it's a DOM bookkeeping cache, not something\n+  // that should trigger a re-render.\n+  const rowButtonRefs = useRef(new Map())\n+\n+  function registerRowButtonRef(id, kind, el) {\n+    const entry = rowButtonRefs.current.get(id) ?? {}\n+    if (el) {\n+      entry[kind] = el\n+      rowButtonRefs.current.set(id, entry)\n+    } else {\n+      delete entry[kind]\n+      if (Object.keys(entry).length === 0) rowButtonRefs.current.delete(id)\n+    }\n+  }\n \n   async function refresh() {\n     try {\n@@ -57,11 +75,52 @@ export default function App() {\n     }\n   }\n \n+  // Where should focus land once `id`'s row is gone from view? Next visible\n+  // row's `kind` control, else the previous row's, else the AddTask title\n+  // input (AC4/AC5). Computed from `sortedTasks` before the row-removing\n+  // call runs, since afterwards the row is no longer in that list.\n+  function computeFocusFallback(id, kind) {\n+    const idx = sortedTasks.findIndex((t) => t.id === id)\n+    if (idx === -1) return { type: 'addTask' }\n+    const candidates = [sortedTasks[idx + 1], idx > 0 ? sortedTasks[idx - 1] : undefined]\n+    const next = candidates.find((t) => t)\n+    return next ? { type: 'row', id: next.id, kind } : { type: 'addTask' }\n+  }\n+\n+  async function handleDelete(id) {\n+    const fallback = computeFocusFallback(id, 'delete')\n+    const ok = await run(() => api.deleteTask(id))\n+    if (ok) setFocusRequest(fallback)\n+  }\n+\n+  async function handleComplete(id) {\n+    // If the current filter keeps the row visible (\"all\"/\"done\"), only the\n+    // Done button disappears and the row stays \u2014 no focus-loss scenario per\n+    // AC5, so no fallback is computed.\n+    const rowWillDisappear = filter === 'open'\n+    const fallback = rowWillDisappear ? computeFocusFallback(id, 'done') : null\n+    const ok = await r