{"ts": "2026-08-17T13:38:42Z", "agent": "claude", "seq": 500, "kind": "tool_result", "text": "1\timport { forwardRef, useImperativeHandle, useRef, useState } from 'react'\n2\t\n3\tconst PRIORITIES = [\n4\t  { value: 'low', label: 'Low' },\n5\t  { value: 'normal', label: 'Normal' },\n6\t  { value: 'high', label: 'High' },\n7\t]\n8\t\n9\tconst AddTask = forwardRef(function AddTask({ onAdd }, ref) {\n10\t  const [title, setTitle] = useState('')\n11\t  const [priority, setPriority] = useState('normal')\n12\t  const [dueDate, setDueDate] = useState('')\n13\t  const titleInputRef = useRef(null)\n14\t\n15\t  // Lets App.jsx return focus here (e.g. once the task list empties out)\n16\t  // without reaching into this component's internals.\n17\t  useImperativeHandle(ref, () => ({\n18\t    focus: () => titleInputRef.current?.focus(),\n19\t  }))\n20\t\n21\t  function submit(e) {\n22\t    e.preventDefault()\n23\t    const trimmed = title.trim()\n24\t    if (!trimmed) return\n25\t    onAdd(trimmed, priority, dueDate || null)\n26\t    setTitle('')\n27\t    setPriority('normal')\n28\t    setDueDate('')\n29\t  }\n30\t\n31\t  return (\n32\t    <form className=\"add-task\" onSubmit={submit}>\n33\t      <input\n34\t        ref={titleInputRef}\n35\t        value={title}\n36\t        onChange={(e) => setTitle(e.target.value)}\n37\t        placeholder=\"What needs doing?\"\n38\t        aria-label=\"Task title\"\n39\t        autoFocus\n40\t      />\n41\t      <select\n42\t        className={`priority-select priority-${priority}`}\n43\t        value={priority}\n44\t        onChange={(e) => setPriority(e.target.value)}\n45\t        aria-label=\"Priority\"\n46\t      >\n47\t        {PRIORITIES.map((p) => <option key={p.value} value={p.value}>{p.label}</option>)}\n48\t      </select>\n49\t      <input\n50\t        type=\"date\"\n51\t        className=\"due-date-input\"\n52\t        value={dueDate}\n53\t        onChange={(e) => setDueDate(e.target.value)}\n54\t        aria-label=\"Due date (optional)\"\n55\t      />\n56\t      <button type=\"submit\" disabled={!title.trim()}>Add</button>\n57\t    </form>\n58\t  )\n59\t})\n60\t\n61\texport default AddTask\n62\t", "meta": {"native_type": "user", "tool_use_id": "toolu_01M1PQE7yd2nZDCt1eQMjEnt", "session_id": "dc5f8c4c-3ccf-4cb5-b01c-d37b1d5c560b"}}
