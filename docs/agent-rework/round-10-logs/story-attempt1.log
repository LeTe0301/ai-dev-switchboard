   if (ok && fallback) setFocusRequest(fallback)\n  }\n\n  useEffect(() => {\n    if (!focusRequest) return\n    if (focusRequest.type === 'addTask') {\n      addTaskRef.current?.focus()\n    } else {\n      const entry = rowButtonRefs.current.get(focusRequest.id)\n      const target = entry?.[focusRequest.kind] ?? entry?.delete\n      if (target) target.focus()\n      else addTaskRef.current?.focus()\n    }\n    setFocusRequest(null)\n  }, [tasks, focusRequest])\n\n  return ("}, "session_id": "dc5f8c4c-3ccf-4cb5-b01c-d37b1d5c560b"}}
