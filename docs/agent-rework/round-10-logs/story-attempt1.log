{"ts": "2026-08-17T13:37:35Z", "agent": "claude", "seq": 424, "kind": "tool_result", "text": "1\timport { useEffect, useRef, useState } from 'react'\n2\t\n3\tconst EMPTY_COPY = {\n4\t  all: 'Nothing to do yet.',\n5\t  open: 'Nothing open right now.',\n6\t  done: 'Nothing done yet.',\n7\t}\n8\t\n9\tconst PRIORITIES = [\n10\t  { value: 'low', label: 'Low' },\n11\t  { value: 'normal', label: 'Normal' },\n12\t  { value: 'high', label: 'High' },\n13\t]\n14\t\n15\tconst todayISO = () => new Date().toLocaleDateString('en-CA') // YYYY-MM-DD, local time\n16\tconst isOverdue = (task) => !task.done && task.due_date != null && task.due_date < todayISO()\n17\t\n18\texport default function TaskList({ tasks, filter, search, hasFilterResults, onComplete, onDelete, onUpdate, onPriorityChange, onDueDateChange, registerRowButtonRef }) {\n19\t  if (tasks.length === 0) {\n20\t    const trimmedSearch = search?.trim()\n21\t    const message = hasFilterResults && trimmedSearch\n22\t      ? `No tasks match \"${trimmedSearch}\".`\n23\t      : EMPTY_COPY[filter]\n24\t    return <p className=\"empty\" aria-live=\"polite\">{message}</p>\n25\t  }\n26\t  return (\n27\t    <ul className=\"task-list\">\n28\t      {tasks.map((task) => (\n29\t        <TaskRow\n30\t          key={task.id}\n31\t          task={task}\n32\t          onComplete={onComplete}\n33\t          onDelete={onDelete}\n34\t          onUpdate={onUpdate}\n35\t          onPriorityChange={onPriorityChange}\n36\t          onDueDateChange={onDueDateChange}\n37\t          registerRowButtonRef={registerRowButtonRef}\n38\t        />\n39\t      ))}\n40\t    </ul>\n41\t  )\n42\t}\n43\t\n44\tfunction TaskRow({ task, onComplete, onDelete, onUpdate, onPriorityChange, onDueDateChange, registerRowButtonRef }) {\n45\t  const [isEditing, setIsEditing] = useState(false)\n46\t  const [draft, setDraft] = useState(task.title)\n47\t  const [showError, setShowError] = useState(false)\n48\t  const editButtonRef = useRef(null)\n49\t  const skipNextFocusRestore = useRef(true)\n50\t\n51\t  // Return focus to the Edit button once the edit form closes (Escape,\n52\t  // Cancel, or a successful Save) \u2014 AC6/AC7. The ref itself survives the\n53\t  // isEditing toggle since TaskRow doesn't unmount, but the effect should\n54\t  // only act on the true -> false transition, not on initial mount.\n55\t  useEffect(() => {\n56\t    if (skipNextFocusRestore.current) {\n57\t      skipNextFocusRestore.current = false\n58\t      return\n59\t    }\n60\t    if (!isEditing) {\n61\t      editButtonRef.current?.focus()\n62\t    }\n63\t  }, [isEditing])\n64\t\n65\t  function startEdit() {\n66\t    setDraft(task.title)\n67\t    setShowError(false)\n68\t    setIsEditing(true)\n69\t  }\n70\t\n71\t  function cancel() {\n72\t    setDraft(task.title)\n73\t    setShowError(false)\n74\t    setIsEditing(false)\n75\t  }\n76\t\n77\t  async function submit(e) {\n78\t    e.preventDefault()\n79\t    const trimmed = draft.trim()\n80\t    if (!trimmed) {\n81\t      setShowError(true)\n82\t      return\n83\t    }\n84\t    const ok = await onUpdate(task.id, trimmed)\n85\t    if (ok) setIsEditing(false)\n86\t  }\n87\t\n88\t  if (isEditing) {\n89\t    return (\n90\t      <li className={task.done ? 'task done' : 'task'}>\n91\t        <form\n92\t          className=\"task-edit\"\n93\t          onSubmit={submit}\n94\t          onKeyDown={(e) => {\n95\t            if (e.key === 'Escape') cancel()\n96\t            // A disabled Save button blocks the browser's native implicit\n97\t            // submit-on-Enter, so an empty draft would never reach submit()\n98\t            // to show the error. Handling Enter here bypasses that.\n99\t            if (e.key === 'Enter') { e.preventDefault(); submit(e) }\n100\t          }}\n101\t        >\n102\t          <input\n103\t            className=\"task-title-input\"\n104\t            value={draft}\n105\t            onChange={(e) => { setDraft(e.target.value); setShowError(false) }}\n106\t            aria-label={`Title for ${task.title}`}\n107\t            autoFocus\n108\t            onFocus={(e) => e.target.select()}\n109\t          />\n110\t          <button type=\"submit\" disabled={!draft.trim()}>Save</button>\n111\t          <button type=\"button\" onClick={cancel}>Cancel</button>\n112\t        </form>\n113\t        {showError && <p className=\"field-error\" role=\"alert\">Title can't be empty</p>}\n114\t      </li>\n115\t    )\n116\t  }\n117\t\n118\t  return (\n119\t    <li className={task.done ? 'task done' : 'task'}>\n120\t      <span className=\"task-title\">{task.title}</span>\n121\t      <select\n122\t        className={`priority-select priority-${task.priority}`}\n123\t        value={task.priority}\n124\t        onChange={(e) => onPriorityChange(task.id, e.target.value)}\n125\t        aria-label={`Priority for ${task.title}`}\n126\t      >\n127\t        {PRIORITIES.map((p) => <option key={p.value} value={p.value}>{p.label}</option>)}\n128\t      </select>\n129\t      <input\n130\t        type=\"date\"\n131\t        className=\"due-date-input\"\n132\t        value={task.due_date || ''}\n133\t        onChange={(e) => onDueDateChange(task.id, e.target.value || null)}\n134\t        aria-label={`Due date for ${task.title}`}\n135\t      />\n136\t      {task.due_date && (\n137\t        <button\n138\t          type=\"button\"\n139\t          className=\"due-date-clear\"\n140\t          onClick={() => onDueDateChange(task.id, null)}\n141\t          aria-label={`Clear due date for ${task.title}`}\n142\t        >\n143\t          \u00d7\n144\t        </button>\n145\t      )}\n146\t      {isOverdue(task) && (\n147\t        <span className=\"overdue-badge\" role=\"status\">\n148\t          <span aria-hidden=\"true\">\u26a0</span> Overdue\n149\t        </span>\n150\t      )}\n151\t      <button ref={editButtonRef} onClick={startEdit} aria-label={`Edit ${task.title}`}>Edit</button>\n152\t      {!task.done && (\n153\t        <button\n154\t          ref={(el) => registerRowButtonRef?.(task.id, 'done', el)}\n155\t          onClick={() => onComplete(task.id)}\n156\t          aria-label={`Complete ${task.title}`}\n157\t        >\n158\t          Done\n159\t        </button>\n160\t      )}\n161\t      <button\n162\t        ref={(el) => registerRowButtonRef?.(task.id, 'delete', el)}\n163\t        onClick={() => onDelete(task.id)}\n164\t        aria-label={`Delete ${task.title}`}\n165\t      >\n166\t        Delete\n167\t      </button>\n168\t    </li>\n169\t  )\n170\t}\n171\t", "meta": {"native_type": "user", "tool_use_id": "toolu_013gvH8FGUmLdPRxnTWAf29r", "session_id": "dc5f8c4c-3ccf-4cb5-b01c-d37b1d5c560b"}}
{"ts": "2026-08-17T13:37:35Z", "agent": "claude", "seq": 425, "kind": "tool_result", "text": "1\t# Implementation: Make the app usable from the keyboard\n2\t\n3\t**Taiga:** #14\n4\t**Spec:** `docs/spec.md`\n5\t**Design:** `docs/design.md`\n6\t**Branch:** feature/tp-14/make-app-usable-from-keyboard\n7\t\n8\t## Summary\n9\t\n10\tEvery control was already a native, keyboard-operable element, so this cycle\n11\tadds the three things that were actually missing: an initial focus target\n12\t(AC1), a guaranteed-visible `:focus-visible` style including the two dark\n13\tbutton backgrounds the default outline is weak against (AC2), and explicit\n14\tfocus restoration after the three actions that used to drop focus to\n15\t`<body>` \u2014 Delete, Done (when the row disappears), and closing the edit\n16\tform via Escape/Cancel/Save (AC4\u2013AC7). No markup, ARIA, or visual design\n17\tchanged beyond the focus indicator itself.\n18\t\n19\t## Changes by file\n20\t\n21\t### `frontend/src/components/AddTask.jsx`\n22\t- Added `autoFocus` to the task-title input (AC1).\n23\t- Wrapped the component in `forwardRef` + `useImperativeHandle`, exposing a\n24\t  `.focus()` method, so `App.jsx` can return focus to this input once the\n25\t  task list empties out (AC4's last fallback) without reaching into the\n26\t  component's internal DOM. This is the option the design doc named\n27\t  explicitly (\"Developer choice: either `useImperativeHandle` or a ref via\n28\t  `forwardRef`\").\n29\t\n30\t### `frontend/src/components/TaskList.jsx`\n31\t- `TaskList` and `TaskRow` now accept a `registerRowButtonRef(id, kind, el)`\n32\t  callback prop, threaded down from `App.jsx`.\n33\t- Each row's Done and Delete buttons pass themselves to\n34\t  `registerRowButtonRef(task.id, 'done'|'delete', el)` via a callback ref.\n35\t  React calls this with `null` on unmount, which the App-side registry uses\n36\t  to clean up its bookkeeping.\n37\t- `TaskRow` keeps a local `editButtonRef` (a plain `useRef`, not lifted to\n38\t  `App`, since the Edit button belongs to the same component instance across\n39\t  the `isEditing` toggle \u2014 it never unmounts as a *component*, only its\n40\t  rendered subtree changes shape). A `useEffect` watching `isEditing` calls\n41\t  `editButtonRef.current?.focus()` whenever `isEditing` transitions from\n42\t  `true` to `false` (Escape, Cancel, or a successful Save), covering AC6 and\n43\t  AC7 with one code path. A `skipNextFocusRestore` ref guards against this\n44\t  effect firing on the row's initial mount (where `isEditing` starts\n45\t  `false`), which would otherwise steal focus from the AC1 autofocus target\n46\t  on every page load.\n47\t\n48\t### `frontend/src/App.jsx`\n49\t- Added `addTaskRef` (passed to `AddTask`) and `rowButtonRefs` \u2014 a\n50\t  `useRef(new Map())` keyed by `task.id`, each entry `{ delete, done }`\n51\t  pointing at that row's live button elements. Kept as a ref, not state,\n52\t  since it's DOM bookkeeping that shouldn't itself cause re-renders.\n53\t- `registerRowButtonRef(id, kind, el)`: writes/clears one entry per\n54\t  register/unregister call.\n55\t- `computeFocusFallback(id, kind)`: given the row being removed and which\n56\t  control \"kind\" to prefer, looks at `sortedTasks` (the same array passed to\n57\t  `TaskList`, so it matches on-screen order under the current filter/search)\n58\t  and returns the next row's `{id, kind}`, else the previous row's, else\n59\t  `{ type: 'addTask' }`. This must be computed *before* the delete/complete\n60\t  API call, since afterwards the row is gone from `sortedTasks`.\n61\t- `handleDelete(id)`: computes the fallback with `kind: 'delete'` (AC4 always\n62\t  targets the neighbour's Delete button), performs the delete, and on\n63\t  success stores the fallback as a pending `focusRequest`.\n64\t- `handleComplete(id)`: only computes a fallback (`kind: 'done'`) when\n65\t  `filter === 'open'`, i.e. only when completing the task will actually\n66\t  remove the row from view. If the filter is `'all'` (the only other filter\n67\t  a Done click is reachable from \u2014 a task can't be completed from a `'done'`\n68\t  filter, since it wouldn't be visible there yet), no fallback is computed\n69\t  and no `focusRequest` is set, per AC5's \"no special handling needed\" case.\n70\t- A `useEffect` on `[tasks, focusRequest]` resolves any pending\n71\t  `focusRequest` once the post-action render has committed: for\n72\t  `type: 'addTask'` it calls `addTaskRef.current.focus()`; for `type: 'row'`\n73\t  it looks up `rowButtonRefs.current.get(id)`, focuses that row's `kind`\n74\t  button, falling back to that row's Delete button if the preferred kind\n75\t  isn't present (the \"Done-or-Delete-position control\" wording in AC5 \u2014 e.g.\n76\t  the next row happens to already be done and has no Done button) or to the\n77\t  AddTask input as a last-resort safety net if the row's entry is missing\n78\t  entirely. It then clears `focusRequest`.\n79\t- `<AddTask ref={addTaskRef} .../>` and\n80\t  `<TaskList ... registerRowButtonRef={registerRowButtonRef} onComplete={handleComplete} onDelete={handleDelete} .../>`\n81\t  wire the above into the render tree. `onUpdate`/`onPriorityChange`/\n82\t  `onDueDateChange` are unchanged.\n83\t\n84\t### `frontend/src/App.css`\n85\tAppended after the existing rules (`App.css:153` on):\n86\t\n87\t```css\n88\t*:focus-visible {\n89\t  outline: 2px solid #0066cc;\n90\t  outline-offset: 2px;\n91\t  box-shadow: 0 0 0 2px #fff;\n92\t}\n93\t\n94\t.filter-option.active:focus-visible,\n95\t.priority-select.priority-high:focus-visible {\n96\t  outline: 2px solid #fff;\n97\t  outline-offset: -4px;\n98\t  box-shadow: none;\n99\t}\n100\t```\n101\t\n102\tThe first rule is the design doc's global `:focus-visible` treatment,\n103\tunchanged. The second rule is a deviation \u2014 see below.\n104\t\n105\t## Deviation from `docs/design.md`\n106\t\n107\tThe design's global rule pairs a 2px blue outline (offset 2px out) with a\n108\t2px white `box-shadow`, reasoning that the white ring gives ~7:1 contrast\n109\tagainst `.filter-option.active` (`#16191c`) and ~2.7:1 against\n110\t`.priority-select.priority-high` (`#a8480a`).\n111\t\n112\tI was asked to sanity-check this before shipping it as-is, because an\n113\toutset `box-shadow` with no offset/blur paints in the 2px band *immediately\n114\toutside* the element's border box \u2014 not over the element's own fill. For\n115\tmost controls that band sits over `.task { background: #fff }` or the page\n116\tbackground (`#f6f7f8`), directly touching the button's edge, so the ring\n117\tstill reads as a real edge against a dark fill in isolation.\n118\t\n119\t`.filter-option` is the case where this breaks down further: filter buttons\n120\tare laid out flush against each other with a 1px separator border and no\n121\tgap (`App.css:65-74`, `.task-filter { display: inline-flex; ... overflow:\n122\thidden }`). When the focused button's box-shadow spreads 2px into a\n123\tneighbour's space, that space is painted over the *next* sibling's own\n124\topaque background as browsers paint later-DOM-order siblings on top \u2014 so\n125\tpart of the ring can be visually clipped or bled into the adjacent button\n126\tinstead of forming a clean ring, on top of the fact that the ring's outer\n127\tedge is barely distinguishable from the surrounding page background either\n128\tway.\n129\t\n130\tFor these two selectors only, I replaced the outset white box-shadow with\n131\tan **inset** white outline (`outline-offset: -4px`) instead. An inset\n132\toutline is drawn entirely inside the control's own border box, directly\n133\tagainst its own dark fill, so it can't bleed into or be occluded by a flush\n134\tneighbour, and its contrast doesn't depend on whatever happens to be\n135\tpainted behind the element. `.priority-select.priority-low` (light grey,\n136\t`#e8eaec`) and every other control keep the design's original global rule \u2014\n137\tthe blue outline alone is already \"soft but perceptible\" there per the\n138\tdesign's own contrast table, matching the plain-white-background case, and\n139\tthe spec only calls out the near-black and dark-orange backgrounds as\n140\tneeding extra treatment.\n141\t\n142\tI don't have browser/rendering tooling in this environment to screenshot\n143\tthe result, so this is a reasoned-through adjustment, not a visually\n144\tconfirmed one \u2014 worth a look once it's running, per the request that\n145\tflagged this.\n146\t\n147\t## Other notes / non-deviations\n148\t\n149\t- AC5's \"no special handling needed\" case (filter `'all'`, row stays\n150\t  visible, only the Done button disappears) is implemented literally as\n151\t  the spec decided it: `handleComplete` doesn't set a `focusRequest` in\n152\t  that branch, so the browser's own default behaviour applies when a\n153\t  focused button is removed from the DOM. This was a spec decision, not an\n154\t  oversight \u2014 flagging it here in case the reviewer's manual/Playwright\n155\t  pass wants to double check it still feels acceptable in practice.\n156\t- The re-sort-after-priority-change edge case needed no code change, as the\n157\t  spec predicted: `key={task.id}` in `TaskList.jsx` already lets React\n158\t  reconcile a reordered row into the same DOM node, so a focused control's\n159\t  focus survives a priority-driven reorder automatically.\n160\t- No ARIA attributes, disabled-control behaviour, or non-focus-indicator\n161\t  visual styling were touched, per the spec's non-goals.\n162\t\n163\t## How to verify\n164\t\n165\t```bash\n166\tcd frontend && npm run build   # type/build check \u2014 passes\n167\tcd frontend && npm run lint    # oxlint \u2014 could not be run in this session,\n168\t                                # see \"Known limitations\" below\n169\t```\n170\t\n171\tThere is still no frontend test runner (`frontend/package.json` has no\n172\t`test` script, no test files exist) \u2014 this predates this cycle per the\n173\tspec's note to the reviewer, and no test infra setup was in scope here.\n174\tJS logic (the focus-fallback computation, the registry, the edit-focus\n175\teffect's mount guard) was verified by tracing through each acceptance\n176\tcriterion's scenario by hand against the code rather than by running\n177\tautomated tests, since none exist to run yet.\n178\t\n179\tManual/keyboard verification path for the reviewer:\n180\t1. Load the app \u2014 focus should be in the task-title input (AC1).\n181\t2. Tab through every control listed in AC2, including a filter button\n182\t   toggled active and a task set to High priority, and confirm each shows a\n183\t   visible ring (Tab to `.filter-option.active` and to a High-priority\n184\t   `<select>` specifically, since those are the two with the CSS deviation\n185\t   above).\n186\t3. Add a few tasks, Tab to a middle row's Delete button, press Enter/Space \u2014\n187\t   focus should land on the next row's Delete button (AC4).\n188\t4. Repeat, deleting the last remaining row \u2014 focus should land back on the\n189\t   task-title input.\n190\t5. With the filter on \"Open\", complete a middle row via its Done button \u2014\n191\t   focus should land on the next row's Done button, or its Delete button if\n192\t   that row is already done (AC5).\n193\t6. With the filter on \"All\", complete a task \u2014 the row stays, only Done\n194\t   disappears; no keyboard trap is claimed here per spec.\n195\t7. Open a row's editor, press Escape \u2014 focus should land back on that row's\n196\t   Edit button (AC6). Repeat via Cancel, and again via Save (AC7).\n197\t\n198\t## Known limitations\n199\t\n200\t- Lint (`npm run lint`, which runs `oxlint`) could not be executed in this\n201\t  session \u2014 every invocation attempt (via `npm run lint`, the `oxlint`\n202\t  binary directly, and via its Node wrapper) was blocked by this\n203\t  environment's command-approval sandboxing before it could run, regardless\n204\t  of invocation form. `npm run build` (Vite's production build, which\n205\t  type-checks JSX via esbuild) ran successfully and is clean. The reviewer\n206\t  should run `npm run lint` directly if their environment allows it.\n207\t- The `:focus-visible` deviation above (inset outline for\n208\t  `.filter-option.active` / `.priority-select.priority-high`) is reasoned\n209\t  through geometrically, not visually confirmed \u2014 no browser/screenshot\n210\t  tooling was available in this session.\n211\t", "meta": {"native_type": "user", "tool_use_id": "toolu_015wHxHfAqvhxhA2fjnir12G", "session_id": "dc5f8c4c-3ccf-4cb5-b01c-d37b1d5c560b"}}
