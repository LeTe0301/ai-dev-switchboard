0 ? sortedTasks[idx - 1] : undefined]\n+    const next = candidates.find((t) => t)\n+    return next ? { type: 'row', id: next.id, kind } : { type: 'addTask' }\n+  }\n+\n+  async function handleDelete(id) {\n+    const fallback = computeFocusFallback(id, 'delete')\n+    const ok = await run(() => api.deleteTask(id))\n+    if (ok) setFocusRequest(fallback)\n+  }\n+\n+  async function handleComplete(id) {\n+    // If the current filter keeps the row visible (\"all\"/\"done\"), only the\n+    // Done button disappears and the row stays \u2014 no focus-loss scenario per\n+    // AC5, so no fallback is computed.\n+    const rowWillDisappear = filter === 'open'\n+    const fallback = rowWillDisappear ? computeFocusFallback(id, 'done') : null\n+    const ok = await run(() => api.completeTask(id))\n+    if (ok && fallback) setFocusRequest(fallback)\n+  }\n+\n+  useEffect(() => {\n+    if (!focusRequest) return\n+    if (focusRequest.type === 'addTask') {\n+      addTaskRef.current?.focus()\n+    } else {\n+      const entry = rowButtonRefs.current.get(focusRequest.id)\n+      const target = entry?.[focusRequest.kind] ?? entry?.delete\n+      if (target) target.focus()\n+      else addTaskRef.current?.focus()\n+    }\n+    setFocusRequest(null)\n+  }, [tasks, focusRequest])\n+\n   return (\n     <main className=\"app\">\n       <h1>Tasks</h1>\n       {!loading && <TaskCounts open={openCount} done={completedCount} />}\n-      <AddTask onAdd={(title, priority, dueDate) => run(() => api.createTask(title, priority, dueDate))} />\n+      <AddTask ref={addTaskRef} onAdd={(title, priority, dueDate) => run(() => api.createTask(title, priority, dueDate))} />\n       {error && <p className=\"error\" role=\"alert\">{error}</p>}\n       <div className=\"list-toolbar\">\n         <div className=\"toolbar-filters\">\n@@ -78,11 +137,12 @@ export default function App() {\n           filter={filter}\n           search={search}\n           hasFilterResults={stateFiltered.length > 0}\n-       