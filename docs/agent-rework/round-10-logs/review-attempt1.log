{"ts": "2026-08-17T13:55:52Z", "agent": "claude", "seq": 67, "kind": "tool_result", "text": "1\timport { useEffect, useRef, useState } from 'react'\n2\t\n3\tconst EMPTY_COPY = {\n4\t  all: 'Nothing to do yet.',\n5\t  open: 'Nothing open right now.',\n6\t  done: 'Nothing done yet.',\n7\t}\n8\t\n9\tconst PRIORITIES = [\n10\t  { value: 'low', label: 'Low' },\n11\t  { value: 'normal', label: 'Normal' },\n12\t  { value: 'high', label: 'High' },\n13\t]\n14\t\n15\tconst todayISO = () => new Date().toLocaleDateString('en-CA') // YYYY-MM-DD, local time\n16\tconst isOverdue = (task) => !task.done && task.due_date != null && task.due_date < todayISO()\n17\t\n18\texport default function TaskList({ tasks, filter, search, hasFilterResults, onComplete, onDelete, onUpdate, onPriorityChange, onDueDateChange, registerRowButtonRef }) {\n19\t  if (tasks.length === 0) {\n20\t    const trimmedSearch = search?.trim()\n21\t    const message = hasFilterResults && trimmedSearch\n22\t      ? `No tasks match \"${trimmedSearch}\".`\n23\t      : EMPTY_COPY[filter]\n24\t    return <p className=\"empty\" aria-live=\"polite\">{message}</p>\n25\t  }\n26\t  return (\n27\t    <ul className=\"task-list\">\n28\t      {tasks.map((task) => (\n29\t        <TaskRow\n30\t          key={task.id}\n31\t          task={task}\n32\t          onComplete={onComplete}\n33\t          onDelete={onDelete}\n34\t          onUpdate={onUpdate}\n35\t          onPriorityChange={onPriorityChange}\n36\t          onDueDateChange={onDueDateChange}\n37\t          registerRowButtonRef={registerRowButtonRef}\n38\t        />\n39\t      ))}\n40\t    </ul>\n41\t  )\n42\t}\n43\t\n44\tfunction TaskRow({ task, onComplete, onDelete, onUpdate, onPriorityChange, onDueDateChange, registerRowButtonRef }) {\n45\t  const [isEditing, setIsEditing] = useState(false)\n46\t  const [draft, setDraft] = useState(task.title)\n47\t  const [showError, setShowError] = useState(false)\n48\t  const editButtonRef = useRef(null)\n49\t  const skipNextFocusRestore = useRef(true)\n50\t\n51\t  // Return focus to the Edit button once the edit form closes (Escape,\n52\t  // Cancel, or a successful Save) \u2014 AC6/AC7. The ref itself survives the\n53\t  // isEditing toggle since TaskRow doesn't unmount, but the effect should\n54\t  // only act on the true -> false transition, not on initial mount.\n55\t  useEffect(() => {\n56\t    if (skipNextFocusRestore.current) {\n57\t      skipNextFocusRestore.current = false\n58\t      return\n59\t    }\n60\t    if (!isEditing) {\n61\t      editButtonRef.current?.focus()\n62\t    }\n63\t  }, [isEditing])\n64\t\n65\t  function startEdit() {\n66\t    setDraft(task.title)\n67\t    setShowError(false)\n68\t    setIsEditing(true)\n69\t  }\n70\t\n71\t  function cancel() {\n72\t    setDraft(task.title)\n73\t    setShowError(false)\n74\t    setIsEditing(false)\n75\t  }\n76\t\n77\t  async function submit(e) {\n78\t    e.preventDefault()\n79\t    const trimmed = draft.trim()\n80\t    if (!trimmed) {\n81\t      setShowError(true)\n82\t      return\n83\t    }\n84\t    const ok = await onUpdate(task.id, trimmed)\n85\t    if (ok) setIsEditing(false)\n86\t  }\n87\t\n88\t  if (isEditing) {\n89\t    return (\n90\t      <li className={task.done ? 'task done' : 'task'}>\n91\t        <form\n92\t          className=\"task-edit\"\n93\t          onSubmit={submit}\n94\t          onKeyDown={(e) => {\n95\t            if (e.key === 'Escape') cancel()\n96\t            // A disabled Save button blocks the browser's native implicit\n97\t            // submit-on-Enter, so an empty draft would never reach submit()\n98\t            // to show the error. Handling Enter here bypasses that.\n99\t            if (e.key === 'Enter') { e.preventDefault(); submit(e) }\n100\t          }}\n101\t        >\n102\t          <input\n103\t            className=\"task-title-input\"\n104\t            value={draft}\n105\t            onChange={(e) => { setDraft(e.target.value); setShowError(false) }}\n106\t            aria-label={`Title for ${task.title}`}\n107\t            autoFocus\n108\t            onFocus={(e) => e.target.select()}\n109\t          />\n110\t          <button type=\"submit\" disabled={!draft.trim()}>Save</button>\n111\t          <button type=\"button\" onClick={cancel}>Cancel</button>\n112\t        </form>\n113\t        {showError && <p className=\"field-error\" role=\"alert\">Title can't be empty</p>}\n114\t      </li>\n115\t    )\n116\t  }\n117\t\n118\t  return (\n119\t    <li className={task.done ? 'task done' : 'task'}>\n120\t      <span className=\"task-title\">{task.title}</span>\n121\t      <select\n122\t        className={`priority-select priority-${task.priority}`}\n123\t        value={task.priority}\n124\t        onChange={(e) => onPriorityChange(task.id, e.target.value)}\n125\t        aria-label={`Priority for ${task.title}`}\n126\t      >\n127\t        {PRIORITIES.map((p) => <option key={p.value} value={p.value}>{p.label}</option>)}\n128\t      </select>\n129\t      <input\n130\t        type=\"date\"\n131\t        className=\"due-date-input\"\n132\t        value={task.due_date || ''}\n133\t        onChange={(e) => onDueDateChange(task.id, e.target.value || null)}\n134\t        aria-label={`Due date for ${task.title}`}\n135\t      />\n136\t      {task.due_date && (\n137\t        <button\n138\t          type=\"button\"\n139\t          className=\"due-date-clear\"\n140\t          onClick={() => onDueDateChange(task.id, null)}\n141\t          aria-label={`Clear due date for ${task.title}`}\n142\t        >\n143\t          \u00d7\n144\t        </button>\n145\t      )}\n146\t      {isOverdue(task) && (\n147\t        <span className=\"overdue-badge\" role=\"status\">\n148\t          <span aria-hidden=\"true\">\u26a0</span> Overdue\n149\t        </span>\n150\t      )}\n151\t      <button ref={editButtonRef} onClick={startEdit} aria-label={`Edit ${task.title}`}>Edit</button>\n152\t      {!task.done && (\n153\t        <button\n154\t          ref={(el) => registerRowButtonRef?.(task.id, 'done', el)}\n155\t          onClick={() => onComplete(task.id)}\n156\t          aria-label={`Complete ${task.title}`}\n157\t        >\n158\t          Done\n159\t        </button>\n160\t      )}\n161\t      <button\n162\t        ref={(el) => registerRowButtonRef?.(task.id, 'delete', el)}\n163\t        onClick={() => onDelete(task.id)}\n164\t        aria-label={`Delete ${task.title}`}\n165\t      >\n166\t        Delete\n167\t      </button>\n168\t    </li>\n169\t  )\n170\t}\n171\t", "meta": {"native_type": "user", "tool_use_id": "toolu_019yoFszGVRRszS28XjWrXp8", "session_id": "81525146-4aee-4ecb-9258-95581c0d5dc8"}}
