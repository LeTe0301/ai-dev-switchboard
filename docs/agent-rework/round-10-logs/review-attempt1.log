{"ts": "2026-08-17T13:55:31Z", "agent": "claude", "seq": 43, "kind": "tool_result", "text": "diff --git a/frontend/src/App.css b/frontend/src/App.css\nindex b7a479d..c18b111 100644\n--- a/frontend/src/App.css\n+++ b/frontend/src/App.css\n@@ -149,3 +149,25 @@ button:disabled { opacity: 0.5; cursor: not-allowed; }\n   font-weight: 600;\n   white-space: nowrap;\n }\n+\n+*:focus-visible {\n+  outline: 2px solid #0066cc;\n+  outline-offset: 2px;\n+  box-shadow: 0 0 0 2px #fff;\n+}\n+\n+/* The rule above relies on the white box-shadow ring reading as high-contrast\n+   against dark button fills. In practice an outset box-shadow with no\n+   offset/blur paints in the space immediately outside the border box, which\n+   for these two controls is either the page background (#f6f7f8) or \u2014 for\n+   .filter-option, whose siblings sit flush against it with no gap\n+   (App.css:65-74) \u2014 can be partially painted over by the next filter button\n+   in DOM order. An inset outline sits inside the control's own fill instead,\n+   so it can't be occluded by a flush neighbour and its contrast doesn't\n+   depend on what's behind the element. */\n+.filter-option.active:focus-visible,\n+.priority-select.priority-high:focus-visible {\n+  outline: 2px solid #fff;\n+  outline-offset: -4px;\n+  box-shadow: none;\n+}\ndiff --git a/frontend/src/components/AddTask.jsx b/frontend/src/components/AddTask.jsx\nindex fb43dfd..b908f61 100644\n--- a/frontend/src/components/AddTask.jsx\n+++ b/frontend/src/components/AddTask.jsx\n@@ -1,4 +1,4 @@\n-import { useState } from 'react'\n+import { forwardRef, useImperativeHandle, useRef, useState } from 'react'\n \n const PRIORITIES = [\n   { value: 'low', label: 'Low' },\n@@ -6,10 +6,17 @@ const PRIORITIES = [\n   { value: 'high', label: 'High' },\n ]\n \n-export default function AddTask({ onAdd }) {\n+const AddTask = forwardRef(function AddTask({ onAdd }, ref) {\n   const [title, setTitle] = useState('')\n   const [priority, setPriority] = useState('normal')\n   const [dueDate, setDueDate] = useState('')\n+  const titleInputRef = useRef(null)\n+\n+  // Lets App.jsx return focus here (e.g. once the task list empties out)\n+  // without reaching into this component's internals.\n+  useImperativeHandle(ref, () => ({\n+    focus: () => titleInputRef.current?.focus(),\n+  }))\n \n   function submit(e) {\n     e.preventDefault()\n@@ -24,10 +31,12 @@ export default function AddTask({ onAdd }) {\n   return (\n     <form className=\"add-task\" onSubmit={submit}>\n       <input\n+        ref={titleInputRef}\n         value={title}\n         onChange={(e) => setTitle(e.target.value)}\n         placeholder=\"What needs doing?\"\n         aria-label=\"Task title\"\n+        autoFocus\n       />\n       <select\n         className={`priority-select priority-${priority}`}\n@@ -47,4 +56,6 @@ export default function AddTask({ onAdd }) {\n       <button type=\"submit\" disabled={!title.trim()}>Add</button>\n     </form>\n   )\n-}\n+})\n+\n+export default AddTask", "meta": {"native_type": "user", "tool_use_id": "toolu_01HYVmzKhVchbJpwLkCfJuCr", "session_id": "81525146-4aee-4ecb-9258-95581c0d5dc8"}}
