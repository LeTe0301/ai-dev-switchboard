\n129\t  padding: 0.4rem 0.6rem;\n130\t  border: 1px solid #ccd2d6;\n131\t  border-radius: 5px;\n132\t  background: #fff;\n133\t  color: #5a646c;\n134\t  font-size: 0.85rem;\n135\t  line-height: 1;\n136\t  cursor: pointer;\n137\t}\n138\t.due-date-clear:hover { background: #f0f2f3; }\n139\t\n140\t.overdue-badge {\n141\t  display: inline-flex;\n142\t  align-items: center;\n143\t  gap: 0.3rem;\n144\t  padding: 0.2rem 0.55rem;\n145\t  border-radius: 999px;\n146\t  background: #fbe9e7;\n147\t  color: #a3271d;\n148\t  font-size: 0.8rem;\n149\t  font-weight: 600;\n150\t  white-space: nowrap;\n151\t}\n152\t\n153\t*:focus-visible {\n154\t  outline: 2px solid #0066cc;\n155\t  outline-offset: 2px;\n156\t  box-shadow: 0 0 0 2px #fff;\n157\t}\n158\t\n159\t/* The rule above relies on the white box-shadow ring reading as high-contrast\n160\t   against dark button fills. In practice an outset box-shadow with no\n161\t   offset/blur paints in the space immediately outside the border box, which\n162\t   for these two controls is either the page background (#f6f7f8) or \u2014 for\n163\t   .filter-option, whose siblings sit flush against it with no gap\n164\t   (App.css:65-74) \u2014 can be partially painted over by the next filter button\n165\t   in DOM order. An inset outline sits inside the control's own fill instead,\n166\t   so it can't be occluded by a flush neighbour and its contrast doesn't\n167\t   depend on what's behind the element. */\n168\t.filter-option.active:focus-visible,\n169\t.priority-select.priority-high:focus-visible {\n170\t  outline: 2px solid #fff;\n171\t  outline-offset: -4px;\n172\t  box-shadow: none;\n173\t}\n174\t", "meta": {"native_type": "user", "tool_use_id": "toolu_011EfidBYB7c8y761W7ek1Ps", "session_id": "79e2ac9d-8f8f-4122-ac4c-30abb4aa5ed1"}}
