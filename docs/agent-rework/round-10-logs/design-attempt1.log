{"ts": "2026-08-17T13:48:56Z", "agent": "claude", "seq": 57, "kind": "tool_use", "text": "Write", "meta": {"native_type": "assistant", "block_type": "tool_use", "tool_use_id": "toolu_01FEd2jEKQofoFWbv2tstxaX", "input": {"file_path": "/tmp/contrast.py", "content": "def lin(c):\n    c = c / 255\n    if c <= 0.03928:\n        return c / 12.92\n    return ((c + 0.055) / 1.055) ** 2.4\n\n\ndef luminance(hexcode):\n    hexcode = hexcode.lstrip(\"#\")\n    r, g, b = int(hexcode[0:2], 16), int(hexcode[2:4], 16), int(hexcode[4:6], 16)\n    return 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b)\n\n\ndef contrast(c1, c2):\n    L1, L2 = luminance(c1), luminance(c2)\n    lighter, darker = max(L1, L2), min(L1, L2)\n    return (lighter + 0.05) / (darker + 0.05)\n\n\ncolors = {\n    \"white\": \"#ffffff\",\n    \"near-black\": \"#16191c\",\n    \"dark-orange\": \"#a8480a\",\n    \"light-grey\": \"#e8eaec\",\n    \"blue-outline\": \"#0066cc\",\n}\n\nfor name, hexc in colors.items():\n    print(name, hexc, \"L =\", round(luminance(hexc), 4))\n\nprint()\nbg_list = [\"white\", \"near-black\", \"dark-orange\", \"light-grey\"]\nfor bg in bg_list:\n    print(\"blue outline vs\", bg, \":\", round(contrast(\"#0066cc\", colors[bg]), 2), \":1\")\n\nprint()\nfor bg in [\"near-black\", \"dark-orange\"]:\n    print(\"white ring vs\", bg, \":\", round(contrast(\"#ffffff\", colors[bg]), 2), \":1\")\n"}, "session_id": "79e2ac9d-8f8f-4122-ac4c-30abb4aa5ed1"}}
