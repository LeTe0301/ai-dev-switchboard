{"ts": "2026-08-17T13:47:40Z", "agent": "claude", "seq": 77, "kind": "tool_result", "text": "1:import { forwardRef, useImperativeHandle, useRef, useState } from 'react'\n9:const AddTask = forwardRef(function AddTask({ onAdd }, ref) {\n17:  useImperativeHandle(ref, () => ({\n39:        autoFocus\n---TaskList---\n18:export default function TaskList({ tasks, filter, search, hasFilterResults, onComplete, onDelete, onUpdate, onPriorityChange, onDueDateChange, registerRowButtonRef }) {\n37:          registerRowButtonRef={registerRowButtonRef}\n44:function TaskRow({ task, onComplete, onDelete, onUpdate, onPriorityChange, onDueDateChange, registerRowButtonRef }) {\n48:  const editButtonRef = useRef(null)\n61:      editButtonRef.current?.focus()\n151:      <button ref={editButtonRef} onClick={startEdit} aria-label={`Edit ${task.title}`}>Edit</button>\n154:          ref={(el) => registerRowButtonRef?.(task.id, 'done', el)}\n162:        ref={(el) => registerRowButtonRef?.(task.id, 'delete', el)}\n---App---\n17:  const [focusRequest, setFocusRequest] = useState(null)\n19:  const addTaskRef = useRef(null)\n82:  function computeFocusFallback(id, kind) {\n91:    const fallback = computeFocusFallback(id, 'delete')\n101:    const fallback = rowWillDisappear ? computeFocusFallback(id, 'done') : null\n107:    if (!focusRequest) return\n108:    if (focusRequest.type === 'addTask') {\n109:      addTaskRef.current?.focus()\n111:      const entry = rowButtonRefs.current.get(focusRequest.id)\n112:      const target = entry?.[focusRequest.kind] ?? entry?.delete\n114:      else addTaskRef.current?.focus()\n117:  }, [tasks, focusRequest])\n123:      <AddTask ref={addTaskRef} onAdd={(title, priority, dueDate) => run(() => api.createTask(title, priority, dueDate))} />\n---CSS---\n  outline: 2px solid #0066cc;\n  outline-offset: 2px;\n  box-shadow: 0 0 0 2px #fff;\n}\n\n/* The rule above relies on the white box-shadow ring reading as high-contrast\n   against dark button fills. In practice an outset box-shadow with no\n   offset/blur paints in the space immediately outside the border box, which\n   for these two controls is either the page background (#f6f7f8) or \u2014 for\n   .filter-option, whose siblings sit flush against it with no gap\n   (App.css:65-74) \u2014 can be partially painted over by the next filter button\n   in DOM order. An inset outline sits inside the control's own fill instead,\n   so it can't be occluded by a flush neighbour and its contrast doesn't\n   depend on what's behind the element. */\n.filter-option.active:focus-visible,\n.priority-select.priority-high:focus-visible {\n  outline: 2px solid #fff;\n  outline-offset: -4px;\n  box-shadow: none;\n}", "meta": {"native_type": "user", "tool_use_id": "toolu_018SWCDQKk9JMLTDn7RqmQkP", "session_id": "2837eeec-4555-4bd5-a94f-21d7d392dd49"}}
