{"ts": "2026-08-17T12:30:52Z", "agent": "claude", "seq": 24, "kind": "tool_result", "text": "1\timport { useState } from 'react'\n2\t\n3\tconst EMPTY_COPY = {\n4\t  all: 'Nothing to do yet.',\n5\t  open: 'Nothing open right now.',\n6\t  done: 'Nothing done yet.',\n7\t}\n8\t\n9\tconst PRIORITIES = [\n10\t  { value: 'low', label: 'Low' },\n11\t  { value: 'normal', label: 'Normal' },\n12\t  { value: 'high', label: 'High' },\n13\t]\n14\t\n15\texport default function TaskList({ tasks, filter, onComplete, onDelete, onUpdate, onPriorityChange }) {\n16\t  if (tasks.length === 0) {\n17\t    return <p className=\"empty\">{EMPTY_COPY[filter]}</p>\n18\t  }\n19\t  return (\n20\t    <ul className=\"task-list\">\n21\t      {tasks.map((task) => (\n22\t        <TaskRow\n23\t          key={task.id}\n24\t          task={task}\n25\t          onComplete={onComplete}\n26\t          onDelete={onDelete}\n27\t          onUpdate={onUpdate}\n28\t          onPriorityChange={onPriorityChange}\n29\t        />\n30\t      ))}\n31\t    </ul>\n32\t  )\n33\t}\n34\t\n35\tfunction TaskRow({ task, onComplete, onDelete, onUpdate, onPriorityChange }) {\n36\t  const [isEditing, setIsEditing] = useState(false)\n37\t  const [draft, setDraft] = useState(task.title)\n38\t  const [showError, setShowError] = useState(false)\n39\t\n40\t  function startEdit() {\n41\t    setDraft(task.title)\n42\t    setShowError(false)\n43\t    setIsEditing(true)\n44\t  }\n45\t\n46\t  function cancel() {\n47\t    setDraft(task.title)\n48\t    setShowError(false)\n49\t    setIsEditing(false)\n50\t  }\n51\t\n52\t  async function submit(e) {\n53\t    e.preventDefault()\n54\t    const trimmed = draft.trim()\n55\t    if (!trimmed) {\n56\t      setShowError(true)\n57\t      return\n58\t    }\n59\t    const ok = await onUpdate(task.id, trimmed)\n60\t    if (ok) setIsEditing(false)\n61\t  }\n62\t\n63\t  if (isEditing) {\n64\t    return (\n65\t      <li className={task.done ? 'task done' : 'task'}>\n66\t        <form\n67\t          className=\"task-edit\"\n68\t          onSubmit={submit}\n69\t          onKeyDown={(e) => {\n70\t            if (e.key === 'Escape') cancel()\n71\t            // A disabled Save button blocks the browser's native implicit\n72\t            // submit-on-Enter, so an empty draft would never reach submit()\n73\t            // to show the error. Handling Enter here bypasses that.\n74\t            if (e.key === 'Enter') { e.preventDefault(); submit(e) }\n75\t          }}\n76\t        >\n77\t          <input\n78\t            className=\"task-title-input\"\n79\t            value={draft}\n80\t            onChange={(e) => { setDraft(e.target.value); setShowError(false) }}\n81\t            aria-label={`Title for ${task.title}`}\n82\t            autoFocus\n83\t            onFocus={(e) => e.target.select()}\n84\t          />\n85\t          <button type=\"submit\" disabled={!draft.trim()}>Save</button>\n86\t          <button type=\"button\" onClick={cancel}>Cancel</button>\n87\t        </form>\n88\t        {showError && <p className=\"field-error\" role=\"alert\">Title can't be empty</p>}\n89\t      </li>\n90\t    )\n91\t  }\n92\t\n93\t  return (\n94\t    <li className={task.done ? 'task done' : 'task'}>\n95\t      <span className=\"task-title\">{task.title}</span>\n96\t      <select\n97\t        className={`priority-select priority-${task.priority}`}\n98\t        value={task.priority}\n99\t        onChange={(e) => onPriorityChange(task.id, e.target.value)}\n100\t        aria-label={`Priority for ${task.title}`}\n101\t      >\n102\t        {PRIORITIES.map((p) => <option key={p.value} value={p.value}>{p.label}</option>)}\n103\t      </select>\n104\t      <button onClick={startEdit} aria-label={`Edit ${task.title}`}>Edit</button>\n105\t      {!task.done && (\n106\t        <button onClick={() => onComplete(task.id)} aria-label={`Complete ${task.title}`}>\n107\t          Done\n108\t        </button>\n109\t      )}\n110\t      <button onClick={() => onDelete(task.id)} aria-label={`Delete ${task.title}`}>\n111\t        Delete\n112\t      </button>\n113\t    </li>\n114\t  )\n115\t}\n116\t", "meta": {"native_type": "user", "tool_use_id": "toolu_016r4t513X1w2SgWcahop4Zh", "session_id": "c61f2e14-8069-45c7-82e4-a0377a07e709"}}
{"ts": "2026-08-17T12:30:52Z", "agent": "claude", "seq": 25, "kind": "tool_result", "text": "1\texport default function ClearCompleted({ count, onClear }) {\n2\t  return (\n3\t    <button\n4\t      type=\"button\"\n5\t      className=\"clear-completed\"\n6\t      disabled={count === 0}\n7\t      onClick={onClear}\n8\t    >\n9\t      Clear completed ({count})\n10\t    </button>\n11\t  )\n12\t}\n13\t", "meta": {"native_type": "user", "tool_use_id": "toolu_01QGtNUunWBQS3ijjrzc1dRi", "session_id": "c61f2e14-8069-45c7-82e4-a0377a07e709"}}
