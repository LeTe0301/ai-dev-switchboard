{"ts": "2026-08-17T12:35:34Z", "agent": "claude", "seq": 131, "kind": "tool_result", "text": "// Every network call goes through here: components never call fetch directly,\n// so the base URL and error handling stay in one place.\nconst BASE = import.meta.env.VITE_API_BASE || 'http://localhost:8000'\n\nasync function request(path, options = {}) {\n  const res = await fetch(BASE + path, {\n    headers: { 'Content-Type': 'application/json' },\n    ...options,\n  })\n  if (!res.ok) {\n    const detail = await res.json().catch(() => null)\n    throw new Error(detail?.detail || `request failed (${res.status})`)\n  }\n  return res.status === 204 ? null : res.json()\n}\n\nexport const listTasks = () => request('/api/tasks')\nexport const createTask = (title, priority) =>\n  request('/api/tasks', { method: 'POST', body: JSON.stringify({ title, priority }) })\nexport const completeTask = (id) => request(`/api/tasks/${id}/done`, { method: 'POST' })\nexport const updateTask = (id, title) =>\n  request(`/api/tasks/${id}`, { method: 'PATCH', body: JSON.stringify({ title }) })\nexport const setPriority = (id, priority) =>\n  request(`/api/tasks/${id}/priority`, { method: 'PATCH', body: JSON.stringify({ priority }) })\nexport const deleteTask = (id) => request(`/api/tasks/${id}`, { method: 'DELETE' })\nexport const clearCompleted = () => request('/api/tasks/completed', { method: 'DELETE' })", "meta": {"native_type": "user", "tool_use_id": "toolu_01VSBy7ySzpz4Ko6wuExzZgN", "session_id": "883da05c-e4de-4dcb-87b6-541369cb42f9"}}
