{"ts": "2026-08-17T12:32:45Z", "agent": "claude", "seq": 28, "kind": "tool_result", "text": "1\timport { useState } from 'react'\n2\t\n3\tconst EMPTY_COPY = {\n4\t  all: 'Nothing to do yet.',\n5\t  open: 'Nothing open right now.',\n6\t  done: 'Nothing done yet.',\n7\t}\n8\t\n9\tconst PRIORITIES = [\n10\t  { value: 'low', label: 'Low' },\n11\t  { value: 'normal', label: 'Normal' },\n12\t  { value: 'high', label: 'High' },\n13\t]\n14\t\n15\texport default function TaskList({ tasks, filter, search, hasFilterResults, onComplete, onDelete, onUpdate, onPriorityChange }) {\n16\t  if (tasks.length === 0) {\n17\t    const trimmedSearch = search?.trim()\n18\t    const message = hasFilterResults && trimmedSearch\n19\t      ? `No tasks match \"${trimmedSearch}\".`\n20\t      : EMPTY_COPY[filter]\n21\t    return <p className=\"empty\" aria-live=\"polite\">{message}</p>\n22\t  }\n23\t  return (\n24\t    <ul className=\"task-list\">\n25\t      {tasks.map((task) => (\n26\t        <TaskRow\n27\t          key={task.id}\n28\t          task={task}\n29\t          onComplete={onComplete}\n30\t          onDelete={onDelete}\n31\t          onUpdate={onUpdate}\n32\t          onPriorityChange={onPriorityChange}\n33\t        />\n34\t      ))}\n35\t    </ul>\n36\t  )\n37\t}\n38\t\n39\tfunction TaskRow({ task, onComplete, onDelete, onUpdate, onPriorityChange }) {\n40\t  const [isEditing, setIsEditing] = useState(false)\n41\t  const [draft, setDraft] = useState(task.title)\n42\t  const [showError, setShowError] = useState(false)\n43\t\n44\t  function startEdit() {\n45\t    setDraft(task.title)\n46\t    setShowError(false)\n47\t    setIsEditing(true)\n48\t  }\n49\t\n50\t  function cancel() {\n51\t    setDraft(task.title)\n52\t    setShowError(false)\n53\t    setIsEditing(false)\n54\t  }\n55\t\n56\t  async function submit(e) {\n57\t    e.preventDefault()\n58\t    const trimmed = draft.trim()\n59\t    if (!trimmed) {\n60\t      setShowError(true)\n61\t      return\n62\t    }\n63\t    const ok = await onUpdate(task.id, trimmed)\n64\t    if (ok) setIsEditing(false)\n65\t  }\n66\t\n67\t  if (isEditing) {\n68\t    return (\n69\t      <li className={task.done ? 'task done' : 'task'}>\n70\t        <form\n71\t          className=\"task-edit\"\n72\t          onSubmit={submit}\n73\t          onKeyDown={(e) => {\n74\t            if (e.key === 'Escape') cancel()\n75\t            // A disabled Save button blocks the browser's native implicit\n76\t            // submit-on-Enter, so an empty draft would never reach submit()\n77\t            // to show the error. Handling Enter here bypasses that.\n78\t            if (e.key === 'Enter') { e.preventDefault(); submit(e) }\n79\t          }}\n80\t        >\n81\t          <input\n82\t            className=\"task-title-input\"\n83\t            value={draft}\n84\t            onChange={(e) => { setDraft(e.target.value); setShowError(false) }}\n85\t            aria-label={`Title for ${task.title}`}\n86\t            autoFocus\n87\t            onFocus={(e) => e.target.select()}\n88\t          />\n89\t          <button type=\"submit\" disabled={!draft.trim()}>Save</button>\n90\t          <button type=\"button\" onClick={cancel}>Cancel</button>\n91\t        </form>\n92\t        {showError && <p className=\"field-error\" role=\"alert\">Title can't be empty</p>}\n93\t      </li>\n94\t    )\n95\t  }\n96\t\n97\t  return (\n98\t    <li className={task.done ? 'task done' : 'task'}>\n99\t      <span className=\"task-title\">{task.title}</span>\n100\t      <select\n101\t        className={`priority-select priority-${task.priority}`}\n102\t        value={task.priority}\n103\t        onChange={(e) => onPriorityChange(task.id, e.target.value)}\n104\t        aria-label={`Priority for ${task.title}`}\n105\t      >\n106\t        {PRIORITIES.map((p) => <option key={p.value} value={p.value}>{p.label}</option>)}\n107\t      </select>\n108\t      <button onClick={startEdit} aria-label={`Edit ${task.title}`}>Edit</button>\n109\t      {!task.done && (\n110\t        <button onClick={() => onComplete(task.id)} aria-label={`Complete ${task.title}`}>\n111\t          Done\n112\t        </button>\n113\t      )}\n114\t      <button onClick={() => onDelete(task.id)} aria-label={`Delete ${task.title}`}>\n115\t        Delete\n116\t      </button>\n117\t    </li>\n118\t  )\n119\t}\n120\t", "meta": {"native_type": "user", "tool_use_id": "toolu_016szccUpMBHFhsLiDvEiY1t", "session_id": "c77f5f93-d701-4142-96c8-83d62048671a"}}
