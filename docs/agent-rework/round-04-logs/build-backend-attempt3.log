{"ts": "2026-08-17T11:22:12Z", "agent": "claude", "seq": 62, "kind": "tool_result", "text": "1\t\"\"\"In-memory task store, backed by a JSON snapshot on disk.\n2\t\n3\tDeliberately not a database: this project exists to exercise a development\n4\tpipeline, and a real datastore would add setup cost to every cycle without\n5\tadding anything to test. Adding one is a decision, not an implementation\n6\tdetail. Disk persistence here is just a full-snapshot write on every\n7\tmutation -- the simplest thing that survives a restart, not a WAL.\n8\t\"\"\"\n9\timport json\n10\timport logging\n11\timport os\n12\tfrom pathlib import Path\n13\tfrom typing import Optional\n14\t\n15\tfrom .models import Priority, Task\n16\t\n17\tlogger = logging.getLogger(__name__)\n18\t\n19\tDEFAULT_DATA_FILE = Path(__file__).resolve().parent.parent / \"data\" / \"tasks.json\"\n20\t\n21\t\n22\tclass TaskStore:\n23\t    def __init__(self):\n24\t        self._data_file = Path(os.environ.get(\"TASKS_DATA_FILE\", DEFAULT_DATA_FILE))\n25\t        self._tasks: dict[int, Task] = {}\n26\t        self._next_id = 1\n27\t        self._load()\n28\t\n29\t    def _load(self) -> None:\n30\t        try:\n31\t            raw = json.loads(self._data_file.read_text())\n32\t            tasks = [Task(**item) for item in raw]\n33\t        except Exception:\n34\t            return\n35\t        self._tasks = {task.id: task for task in tasks}\n36\t        self._next_id = max(self._tasks, default=0) + 1\n37\t\n38\t    def _save(self) -> None:\n39\t        self._data_file.parent.mkdir(parents=True, exist_ok=True)\n40\t        payload = json.dumps([task.model_dump() for task in self.list()])\n41\t        self._data_file.write_text(payload)\n42\t\n43\t    def list(self) -> list[Task]:\n44\t        return [self._tasks[k] for k in sorted(self._tasks)]\n45\t\n46\t    def add(self, title: str, priority: Priority = \"normal\") -> Task:\n47\t        task = Task(id=self._next_id, title=title, priority=priority)\n48\t        self._tasks[task.id] = task\n49\t        self._next_id += 1\n50\t        self._save()\n51\t        return task\n52\t\n53\t    def get(self, task_id: int) -> Optional[Task]:\n54\t        return self._tasks.get(task_id)\n55\t\n56\t    def set_done(self, task_id: int, done: bool) -> Optional[Task]:\n57\t        task = self._tasks.get(task_id)\n58\t        if task is None:\n59\t            return None\n60\t        task.done = done\n61\t        self._save()\n62\t        return task\n63\t\n64\t    def set_priority(self, task_id: int, priority: Priority) -> Optional[Task]:\n65\t        task = self._tasks.get(task_id)\n66\t        if task is None:\n67\t            return None\n68\t        task.priority = priority\n69\t        self._save()\n70\t        return task\n71\t\n72\t    def update_title(self, task_id: int, title: str) -> Optional[Task]:\n73\t        task = self._tasks.get(task_id)\n74\t        if task is None:\n75\t            return None\n76\t        task.title = title\n77\t        self._save()\n78\t        return task\n79\t\n80\t    def delete(self, task_id: int) -> bool:\n81\t        found = self._tasks.pop(task_id, None) is not None\n82\t        if found:\n83\t            self._save()\n84\t        return found\n85\t\n86\t    def reset(self) -> None:\n87\t        self._tasks.clear()\n88\t        self._next_id = 1\n89\t        self._save()\n90\t\n91\t\n92\tstore = TaskStore()\n93\t", "meta": {"native_type": "user", "tool_use_id": "toolu_014QwarQnhd6HYnrEhsSfGYw", "session_id": "718bfc68-6296-441c-bc68-506c47d9763c"}}
