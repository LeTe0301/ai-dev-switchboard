{"ts": "2026-08-17T11:21:39Z", "agent": "claude", "seq": 12, "kind": "tool_result", "text": "1\t\"\"\"In-memory task store, backed by a JSON snapshot on disk.\n2\t\n3\tDeliberately not a database: this project exists to exercise a development\n4\tpipeline, and a real datastore would add setup cost to every cycle without\n5\tadding anything to test. Adding one is a decision, not an implementation\n6\tdetail. Disk persistence here is just a full-snapshot write on every\n7\tmutation -- the simplest thing that survives a restart, not a WAL.\n8\t\"\"\"\n9\timport json\n10\timport os\n11\tfrom pathlib import Path\n12\tfrom typing import Optional\n13\t\n14\tfrom .models import Priority, Task\n15\t\n16\tDEFAULT_DATA_FILE = Path(__file__).resolve().parent.parent / \"data\" / \"tasks.json\"\n17\t\n18\t\n19\tclass TaskStore:\n20\t    def __init__(self):\n21\t        self._data_file = Path(os.environ.get(\"TASKS_DATA_FILE\", DEFAULT_DATA_FILE))\n22\t        self._tasks: dict[int, Task] = {}\n23\t        self._next_id = 1\n24\t        self._load()\n25\t\n26\t    def _load(self) -> None:\n27\t        try:\n28\t            raw = json.loads(self._data_file.read_text())\n29\t            tasks = [Task(**item) for item in raw]\n30\t        except Exception:\n31\t            return\n32\t        self._tasks = {task.id: task for task in tasks}\n33\t        self._next_id = max(self._tasks, default=0) + 1\n34\t\n35\t    def _save(self) -> None:\n36\t        self._data_file.parent.mkdir(parents=True, exist_ok=True)\n37\t        payload = json.dumps([task.model_dump() for task in self.list()])\n38\t        self._data_file.write_text(payload)\n39\t\n40\t    def list(self) -> list[Task]:\n41\t        return [self._tasks[k] for k in sorted(self._tasks)]\n42\t\n43\t    def add(self, title: str, priority: Priority = \"normal\") -> Task:\n44\t        task = Task(id=self._next_id, title=title, priority=priority)\n45\t        self._tasks[task.id] = task\n46\t        self._next_id += 1\n47\t        self._save()\n48\t        return task\n49\t\n50\t    def get(self, task_id: int) -> Optional[Task]:\n51\t        return self._tasks.get(task_id)\n52\t\n53\t    def set_done(self, task_id: int, done: bool) -> Optional[Task]:\n54\t        task = self._tasks.get(task_id)\n55\t        if task is None:\n56\t            return None\n57\t        task.done = done\n58\t        self._save()\n59\t        return task\n60\t\n61\t    def set_priority(self, task_id: int, priority: Priority) -> Optional[Task]:\n62\t        task = self._tasks.get(task_id)\n63\t        if task is None:\n64\t            return None\n65\t        task.priority = priority\n66\t        self._save()\n67\t        return task\n68\t\n69\t    def update_title(self, task_id: int, title: str) -> Optional[Task]:\n70\t        task = self._tasks.get(task_id)\n71\t        if task is None:\n72\t            return None\n73\t        task.title = title\n74\t        self._save()\n75\t        return task\n76\t\n77\t    def delete(self, task_id: int) -> bool:\n78\t        found = self._tasks.pop(task_id, None) is not None\n79\t        if found:\n80\t            self._save()\n81\t        return found\n82\t\n83\t    def reset(self) -> None:\n84\t        self._tasks.clear()\n85\t        self._next_id = 1\n86\t        self._save()\n87\t\n88\t\n89\tstore = TaskStore()\n90\t", "meta": {"native_type": "user", "tool_use_id": "toolu_01YLzzrFCiAW6oEm6zqaAsgY", "session_id": "718bfc68-6296-441c-bc68-506c47d9763c"}}
