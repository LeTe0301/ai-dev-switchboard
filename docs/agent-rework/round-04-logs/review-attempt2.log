{"ts": "2026-08-17T11:23:59Z", "agent": "claude", "seq": 37, "kind": "tool_result", "text": "1\t\"\"\"Route wiring only -- behaviour lives in store.py.\"\"\"\n2\tfrom fastapi import FastAPI, HTTPException\n3\tfrom fastapi.middleware.cors import CORSMiddleware\n4\t\n5\tfrom .models import PriorityIn, Task, TaskIn\n6\tfrom .store import store\n7\t\n8\tapp = FastAPI(title=\"test-project\")\n9\t\n10\t# A regex, not a fixed list: the dev server is reached as both localhost and\n11\t# 127.0.0.1, and the e2e harness binds it to a free port rather than 5173, so\n12\t# a hardcoded origin silently blocks every write from the browser while GETs\n13\t# keep working -- which reads as \"adding a task does nothing\".\n14\tapp.add_middleware(\n15\t    CORSMiddleware,\n16\t    allow_origin_regex=r\"http://(localhost|127\\.0\\.0\\.1):\\d+\",\n17\t    allow_methods=[\"*\"],\n18\t    allow_headers=[\"*\"],\n19\t)\n20\t\n21\t\n22\t@app.get(\"/api/tasks\", response_model=list[Task])\n23\tdef list_tasks() -> list[Task]:\n24\t    return store.list()\n25\t\n26\t\n27\t@app.post(\"/api/tasks\", response_model=Task, status_code=201)\n28\tdef create_task(payload: TaskIn) -> Task:\n29\t    return store.add(payload.title, payload.priority)\n30\t\n31\t\n32\t@app.post(\"/api/tasks/{task_id}/done\", response_model=Task)\n33\tdef complete_task(task_id: int) -> Task:\n34\t    task = store.set_done(task_id, True)\n35\t    if task is None:\n36\t        raise HTTPException(status_code=404, detail=\"no such task\")\n37\t    return task\n38\t\n39\t\n40\t@app.patch(\"/api/tasks/{task_id}/priority\", response_model=Task)\n41\tdef update_priority(task_id: int, payload: PriorityIn) -> Task:\n42\t    task = store.set_priority(task_id, payload.priority)\n43\t    if task is None:\n44\t        raise HTTPException(status_code=404, detail=\"no such task\")\n45\t    return task\n46\t\n47\t\n48\t@app.patch(\"/api/tasks/{task_id}\", response_model=Task)\n49\tdef update_task(task_id: int, payload: TaskIn) -> Task:\n50\t    task = store.update_title(task_id, payload.title)\n51\t    if task is None:\n52\t        raise HTTPException(status_code=404, detail=\"no such task\")\n53\t    return task\n54\t\n55\t\n56\t@app.delete(\"/api/tasks/{task_id}\", status_code=204)\n57\tdef delete_task(task_id: int) -> None:\n58\t    if not store.delete(task_id):\n59\t        raise HTTPException(status_code=404, detail=\"no such task\")\n60\t", "meta": {"native_type": "user", "tool_use_id": "toolu_01H33WrQJAWcLb5BzeTV5hgd", "session_id": "06a04b86-59b4-4030-b9ec-a0f1ea773699"}}
{"ts": "2026-08-17T11:23:59Z", "agent": "claude", "seq": 38, "kind": "tool_result", "text": "1\timport json\n2\t\n3\tfrom app.store import TaskStore\n4\t\n5\t\n6\tdef test_state_survives_a_simulated_restart(tmp_path, monkeypatch):\n7\t    data_file = tmp_path / \"tasks.json\"\n8\t    monkeypatch.setenv(\"TASKS_DATA_FILE\", str(data_file))\n9\t\n10\t    first = TaskStore()\n11\t    first.add(\"write the thing\", priority=\"high\")\n12\t    first.set_done(1, True)\n13\t\n14\t    second = TaskStore()\n15\t    tasks = second.list()\n16\t    assert len(tasks) == 1\n17\t    assert tasks[0].id == 1\n18\t    assert tasks[0].title == \"write the thing\"\n19\t    assert tasks[0].done is True\n20\t    assert tasks[0].priority == \"high\"\n21\t\n22\t\n23\tdef test_missing_file_starts_empty(tmp_path, monkeypatch):\n24\t    monkeypatch.setenv(\"TASKS_DATA_FILE\", str(tmp_path / \"does-not-exist.json\"))\n25\t\n26\t    store = TaskStore()\n27\t\n28\t    assert store.list() == []\n29\t\n30\t\n31\tdef test_corrupt_json_starts_empty(tmp_path, monkeypatch):\n32\t    data_file = tmp_path / \"tasks.json\"\n33\t    data_file.write_text(\"{not valid json\")\n34\t    monkeypatch.setenv(\"TASKS_DATA_FILE\", str(data_file))\n35\t\n36\t    store = TaskStore()\n37\t\n38\t    assert store.list() == []\n39\t\n40\t\n41\tdef test_wrong_top_level_shape_starts_empty(tmp_path, monkeypatch):\n42\t    data_file = tmp_path / \"tasks.json\"\n43\t    data_file.write_text(json.dumps({\"not\": \"a list\"}))\n44\t    monkeypatch.setenv(\"TASKS_DATA_FILE\", str(data_file))\n45\t\n46\t    store = TaskStore()\n47\t\n48\t    assert store.list() == []\n49\t\n50\t\n51\tdef test_wrong_item_shape_starts_empty(tmp_path, monkeypatch):\n52\t    data_file = tmp_path / \"tasks.json\"\n53\t    data_file.write_text(json.dumps([{\"foo\": \"bar\"}]))\n54\t    monkeypatch.setenv(\"TASKS_DATA_FILE\", str(data_file))\n55\t\n56\t    store = TaskStore()\n57\t\n58\t    assert store.list() == []\n59\t\n60\t\n61\tdef test_empty_file_starts_empty(tmp_path, monkeypatch):\n62\t    data_file = tmp_path / \"tasks.json\"\n63\t    data_file.write_text(\"\")\n64\t    monkeypatch.setenv(\"TASKS_DATA_FILE\", str(data_file))\n65\t\n66\t    store = TaskStore()\n67\t\n68\t    assert store.list() == []\n69\t\n70\t\n71\tdef test_id_counter_continues_after_reload(tmp_path, monkeypatch):\n72\t    data_file = tmp_path / \"tasks.json\"\n73\t    monkeypatch.setenv(\"TASKS_DATA_FILE\", str(data_file))\n74\t\n75\t    first = TaskStore()\n76\t    first.add(\"one\")\n77\t    first.add(\"two\")\n78\t    first.add(\"three\")\n79\t    first.delete(2)\n80\t\n81\t    second = TaskStore()\n82\t    new_task = second.add(\"four\")\n83\t\n84\t    assert new_task.id == 4\n85\t\n86\t\n87\tdef test_data_directory_is_created_on_first_write(tmp_path, monkeypatch):\n88\t    data_file = tmp_path / \"nested\" / \"dir\" / \"tasks.json\"\n89\t    monkeypatch.setenv(\"TASKS_DATA_FILE\", str(data_file))\n90\t\n91\t    store = TaskStore()\n92\t    store.add(\"x\")\n93\t\n94\t    assert data_file.exists()\n95\t    assert json.loads(data_file.read_text())[0][\"title\"] == \"x\"\n96\t", "meta": {"native_type": "user", "tool_use_id": "toolu_0168CszbW1nSuaCdTHYg612X", "session_id": "06a04b86-59b4-4030-b9ec-a0f1ea773699"}}
