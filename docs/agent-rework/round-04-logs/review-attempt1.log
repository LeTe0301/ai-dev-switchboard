{"ts": "2026-08-17T11:20:55Z", "agent": "claude", "seq": 98, "kind": "tool_result", "text": "     1\t\"\"\"In-memory task store, backed by a JSON snapshot on disk.\n     2\t\n     3\tDeliberately not a database: this project exists to exercise a development\n     4\tpipeline, and a real datastore would add setup cost to every cycle without\n     5\tadding anything to test. Adding one is a decision, not an implementation\n     6\tdetail. Disk persistence here is just a full-snapshot write on every\n     7\tmutation -- the simplest thing that survives a restart, not a WAL.\n     8\t\"\"\"\n     9\timport json\n    10\timport os\n    11\tfrom pathlib import Path\n    12\tfrom typing import Optional\n    13\t\n    14\tfrom .models import Priority, Task\n    15\t\n    16\tDEFAULT_DATA_FILE = Path(__file__).resolve().parent.parent / \"data\" / \"tasks.json\"\n    17\t\n    18\t\n    19\tclass TaskStore:\n    20\t    def __init__(self):\n    21\t        self._data_file = Path(os.environ.get(\"TASKS_DATA_FILE\", DEFAULT_DATA_FILE))\n    22\t        self._tasks: dict[int, Task] = {}\n    23\t        self._next_id = 1\n    24\t        self._load()\n    25\t\n    26\t    def _load(self) -> None:\n    27\t        try:\n    28\t            raw = json.loads(self._data_file.read_text())\n    29\t            tasks = [Task(**item) for item in raw]\n    30\t        except Exception:\n    31\t            return\n    32\t        self._tasks = {task.id: task for task in tasks}\n    33\t        self._next_id = max(self._tasks, default=0) + 1\n    34\t\n    35\t    def _save(self) -> None:\n    36\t        self._data_file.parent.mkdir(parents=True, exist_ok=True)\n    37\t        payload = json.dumps([task.model_dump() for task in self.list()])\n    38\t        self._data_file.write_text(payload)\n    39\t\n    40\t    def list(self) -> list[Task]:\n    41\t        return [self._tasks[k] for k in sorted(self._tasks)]\n    42\t\n    43\t    def add(self, title: str, priority: Priority = \"normal\") -> Task:\n    44\t        task = Task(id=self._next_id, title=title, priority=priority)\n    45\t        self._tasks[task.id] = task", "meta": {"native_type": "user", "tool_use_id": "toolu_011xRpNe7nSU7isig2KXLcfY", "session_id": "0f263f57-d158-4180-ae32-2d077689462b"}}
