{"ts": "2026-08-17T11:22:45Z", "agent": "claude", "seq": 92, "kind": "tool_result", "text": "import json\n\nfrom app.store import TaskStore\n\n\ndef test_state_survives_a_simulated_restart(tmp_path, monkeypatch):\n    data_file = tmp_path / \"tasks.json\"\n    monkeypatch.setenv(\"TASKS_DATA_FILE\", str(data_file))\n\n    first = TaskStore()\n    first.add(\"write the thing\", priority=\"high\")\n    first.set_done(1, True)\n\n    second = TaskStore()\n    tasks = second.list()\n    assert len(tasks) == 1\n    assert tasks[0].id == 1\n    assert tasks[0].title == \"write the thing\"\n    assert tasks[0].done is True\n    assert tasks[0].priority == \"high\"\n\n\ndef test_missing_file_starts_empty(tmp_path, monkeypatch):\n    monkeypatch.setenv(\"TASKS_DATA_FILE\", str(tmp_path / \"does-not-exist.json\"))\n\n    store = TaskStore()\n\n    assert store.list() == []\n\n\ndef test_corrupt_json_starts_empty(tmp_path, monkeypatch):\n    data_file = tmp_path / \"tasks.json\"\n    data_file.write_text(\"{not valid json\")\n    monkeypatch.setenv(\"TASKS_DATA_FILE\", str(data_file))\n\n    store = TaskStore()\n\n    assert store.list() == []\n\n\ndef test_wrong_top_level_shape_starts_empty(tmp_path, monkeypatch):\n    data_file = tmp_path / \"tasks.json\"\n    data_file.write_text(json.dumps({\"not\": \"a list\"}))\n    monkeypatch.setenv(\"TASKS_DATA_FILE\", str(data_file))\n\n    store = TaskStore()\n\n    assert store.list() == []\n\n\ndef test_wrong_item_shape_starts_empty(tmp_path, monkeypatch):\n    data_file = tmp_path / \"tasks.json\"\n    data_file.write_text(json.dumps([{\"foo\": \"bar\"}]))\n    monkeypatch.setenv(\"TASKS_DATA_FILE\", str(data_file))\n\n    store = TaskStore()\n\n    assert store.list() == []\n\n\ndef test_empty_file_starts_empty(tmp_path, monkeypatch):\n    data_file = tmp_path / \"tasks.json\"\n    data_file.write_text(\"\")\n    monkeypatch.setenv(\"TASKS_DATA_FILE\", str(data_file))\n\n    store = TaskStore()\n\n    assert store.list() == []\n\n\ndef test_id_counter_continues_after_reload(tmp_path, monkeypatch):\n    data_file = tmp_path / \"tasks.json\"\n    monkeypatch.setenv(\"TASKS_DATA_FILE\", str(data_file))\n\n    first = TaskStore()\n    first.add(\"one\")\n    first.add(\"two\")\n    first.add(\"three\")\n    first.delete(2)\n\n    second = TaskStore()\n    new_task = second.add(\"four\")\n\n    assert new_task.id == 4\n\n\ndef test_data_directory_is_created_on_first_write(tmp_path, monkeypatch):\n    data_file = tmp_path / \"nested\" / \"dir\" / \"tasks.json\"\n    monkeypatch.setenv(\"TASKS_DATA_FILE\", str(data_file))\n\n    store = TaskStore()\n    store.add(\"x\")\n\n    assert data_file.exists()\n    assert json.loads(data_file.read_text())[0][\"title\"] == \"x\"", "meta": {"native_type": "user", "tool_use_id": "toolu_01D62L4cqF3vYpVcQkXx6pha", "session_id": "e86ea192-3307-4635-a1ac-17336a1dfdd0"}}
