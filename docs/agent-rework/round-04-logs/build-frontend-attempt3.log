{"ts": "2026-08-17T11:21:39Z", "agent": "claude", "seq": 13, "kind": "tool_result", "text": "node_modules/\ndist/\n__pycache__/\n.pytest_cache/\n---\n\"\"\"In-memory task store, backed by a JSON snapshot on disk.\n\nDeliberately not a database: this project exists to exercise a development\npipeline, and a real datastore would add setup cost to every cycle without\nadding anything to test. Adding one is a decision, not an implementation\ndetail. Disk persistence here is just a full-snapshot write on every\nmutation -- the simplest thing that survives a restart, not a WAL.\n\"\"\"\nimport json\nimport os\nfrom pathlib import Path\nfrom typing import Optional\n\nfrom .models import Priority, Task\n\nDEFAULT_DATA_FILE = Path(__file__).resolve().parent.parent / \"data\" / \"tasks.json\"\n\n\nclass TaskStore:\n    def __init__(self):\n        self._data_file = Path(os.environ.get(\"TASKS_DATA_FILE\", DEFAULT_DATA_FILE))\n        self._tasks: dict[int, Task] = {}\n        self._next_id = 1\n        self._load()\n\n    def _load(self) -> None:\n        try:\n            raw = json.loads(self._data_file.read_text())\n            tasks = [Task(**item) for item in raw]\n        except Exception:\n            return\n        self._tasks = {task.id: task for task in tasks}\n        self._next_id = max(self._tasks, default=0) + 1\n\n    def _save(self) -> None:\n        self._data_file.parent.mkdir(parents=True, exist_ok=True)\n        payload = json.dumps([task.model_dump() for task in self.list()])\n        self._data_file.write_text(payload)\n\n    def list(self) -> list[Task]:\n        return [self._tasks[k] for k in sorted(self._tasks)]\n\n    def add(self, title: str, priority: Priority = \"normal\") -> Task:\n        task = Task(id=self._next_id, title=title, priority=priority)\n        self._tasks[task.id] = task\n        self._next_id += 1\n        self._save()\n        return task\n\n    def get(self, task_id: int) -> Optional[Task]:\n        return self._tasks.get(task_id)\n\n    def set_done(self, task_id: int, done: bool) -> Optional[Task]:\n        task = self._tasks.get(task_id)\n        if task is None:\n            return None\n        task.done = done\n        self._save()\n        return task\n\n    def set_priority(self, task_id: int, priority: Priority) -> Optional[Task]:\n        task = self._tasks.get(task_id)\n        if task is None:\n            return None\n        task.priority = priority\n        self._save()\n        return task\n\n    def update_title(self, task_id: int, title: str) -> Optional[Task]:\n        task = self._tasks.get(task_id)\n        if task is None:\n            return None\n        task.title = title\n        self._save()\n        return task\n\n    def delete(self, task_id: int) -> bool:\n        found = self._tasks.pop(task_id, None) is not None\n        if found:\n            self._save()\n        return found\n\n    def reset(self) -> None:\n        self._tasks.clear()\n        self._next_id = 1\n        self._save()\n\n\nstore = TaskStore()", "meta": {"native_type": "user", "tool_use_id": "toolu_01XDfjLU3tDJUJ75NXwXzWt1", "session_id": "e86ea192-3307-4635-a1ac-17336a1dfdd0"}}
