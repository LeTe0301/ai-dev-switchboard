{"ts": "2026-08-17T11:21:44Z", "agent": "claude", "seq": 23, "kind": "tool_result", "text": "---\n\"\"\"Route wiring only -- behaviour lives in store.py.\"\"\"\nfrom fastapi import FastAPI, HTTPException\nfrom fastapi.middleware.cors import CORSMiddleware\n\nfrom .models import PriorityIn, Task, TaskIn\nfrom .store import store\n\napp = FastAPI(title=\"test-project\")\n\n# A regex, not a fixed list: the dev server is reached as both localhost and\n# 127.0.0.1, and the e2e harness binds it to a free port rather than 5173, so\n# a hardcoded origin silently blocks every write from the browser while GETs\n# keep working -- which reads as \"adding a task does nothing\".\napp.add_middleware(\n    CORSMiddleware,\n    allow_origin_regex=r\"http://(localhost|127\\.0\\.0\\.1):\\d+\",\n    allow_methods=[\"*\"],\n    allow_headers=[\"*\"],\n)\n\n\n@app.get(\"/api/tasks\", response_model=list[Task])\ndef list_tasks() -> list[Task]:\n    return store.list()\n\n\n@app.post(\"/api/tasks\", response_model=Task, status_code=201)\ndef create_task(payload: TaskIn) -> Task:\n    return store.add(payload.title, payload.priority)", "meta": {"native_type": "user", "tool_use_id": "toolu_014VyMAmFTqnM76tGsmgo8KQ", "session_id": "e86ea192-3307-4635-a1ac-17336a1dfdd0"}}
