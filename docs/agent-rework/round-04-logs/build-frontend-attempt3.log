{"ts": "2026-08-17T11:21:58Z", "agent": "claude", "seq": 43, "kind": "tool_result", "text": "     1\t\"\"\"In-memory task store, backed by a JSON snapshot on disk.\n     2\t\n     3\tDeliberately not a database: this project exists to exercise a development\n     4\tpipeline, and a real datastore would add setup cost to every cycle without\n     5\tadding anything to test. Adding one is a decision, not an implementation\n     6\tdetail. Disk persistence here is just a full-snapshot write on every\n     7\tmutation -- the simplest thing that survives a restart, not a WAL.\n     8\t\"\"\"\n     9\timport json\n    10\timport logging\n    11\timport os\n    12\tfrom pathlib import Path\n    13\tfrom typing import Optional\n    14\t\n    15\tfrom .models import Priority, Task\n    16\t\n    17\tlogger = logging.getLogger(__name__)\n    18\t\n    19\tDEFAULT_DATA_FILE = Path(__file__).resolve().parent.parent / \"data\" / \"tasks.json\"\n    20\t\n    21\t\n    22\tclass TaskStore:\n    23\t    def __init__(self):\n    24\t        self._data_file = Path(os.environ.get(\"TASKS_DATA_FILE\", DEFAULT_DATA_FILE))\n    25\t        self._tasks: dict[int, Task] = {}\n    26\t        self._next_id = 1\n    27\t        self._load()\n    28\t\n    29\t    def _load(self) -> None:\n    30\t        try:\n    31\t            raw = json.loads(self._data_file.read_text())\n    32\t            tasks = [Task(**item) for item in raw]\n    33\t        except Exception:\n    34\t            return\n    35\t        self._tasks = {task.id: task for task in tasks}\n    36\t        self._next_id = max(self._tasks, default=0) + 1\n    37\t\n    38\t    def _save(self) -> None:\n    39\t        self._data_file.parent.mkdir(parents=True, exist_ok=True)\n    40\t        payload = json.dumps([task.model_dump() for task in self.list()])\n    41\t        self._data_file.write_text(payload)\n    42\t\n    43\t    def list(self) -> list[Task]:\n    44\t        return [self._tasks[k] for k in sorted(self._tasks)]\n    45\t\n    46\t    def add(self, title: str, priority: Priority = \"normal\") -> Task:\n    47\t        task = Task(id=self._next_id, title=title, priority=priority)\n    48\t        self._tasks[task.id] = task\n    49\t        self._next_id += 1\n    50\t        self._save()\n    51\t        return task\n    52\t\n    53\t    def get(self, task_id: int) -> Optional[Task]:\n    54\t        return self._tasks.get(task_id)\n    55\t\n    56\t    def set_done(self, task_id: int, done: bool) -> Optional[Task]:\n    57\t        task = self._tasks.get(task_id)\n    58\t        if task is None:\n    59\t            return None\n    60\t        task.done = done\n    61\t        self._save()\n    62\t        return task\n    63\t\n    64\t    def set_priority(self, task_id: int, priority: Priority) -> Optional[Task]:\n    65\t        task = self._tasks.get(task_id)\n    66\t        if task is None:\n    67\t            return None\n    68\t        task.priority = priority\n    69\t        self._save()\n    70\t        return task\n    71\t\n    72\t    def update_title(self, task_id: int, title: str) -> Optional[Task]:\n    73\t        task = self._tasks.get(task_id)\n    74\t        if task is None:\n    75\t            return None\n    76\t        task.title = title\n    77\t        self._save()\n    78\t        return task\n    79\t\n    80\t    def delete(self, task_id: int) -> bool:\n    81\t        found = self._tasks.pop(task_id, None) is not None\n    82\t        if found:\n    83\t            self._save()\n    84\t        return found\n    85\t\n    86\t    def reset(self) -> None:\n    87\t        self._tasks.clear()\n    88\t        self._next_id = 1\n    89\t        self._save()\n    90\t\n    91\t\n    92\tstore = TaskStore()", "meta": {"native_type": "user", "tool_use_id": "toolu_012Y4GhXQ8c2fdgbDav6vARn", "session_id": "e86ea192-3307-4635-a1ac-17336a1dfdd0"}}
