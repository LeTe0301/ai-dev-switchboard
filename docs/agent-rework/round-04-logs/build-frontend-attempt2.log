{"ts": "2026-08-17T11:18:21Z", "agent": "claude", "seq": 18, "kind": "tool_result", "text": "diff --git a/backend/app/store.py b/backend/app/store.py\nindex 64b65c7..caab608 100644\n--- a/backend/app/store.py\n+++ b/backend/app/store.py\n@@ -1,19 +1,41 @@\n-\"\"\"In-memory task store.\n+\"\"\"In-memory task store, backed by a JSON snapshot on disk.\n \n Deliberately not a database: this project exists to exercise a development\n pipeline, and a real datastore would add setup cost to every cycle without\n adding anything to test. Adding one is a decision, not an implementation\n-detail.\n+detail. Disk persistence here is just a full-snapshot write on every\n+mutation -- the simplest thing that survives a restart, not a WAL.\n \"\"\"\n+import json\n+import os\n+from pathlib import Path\n from typing import Optional\n \n from .models import Priority, Task\n \n+DEFAULT_DATA_FILE = Path(__file__).resolve().parent.parent / \"data\" / \"tasks.json\"\n+\n \n class TaskStore:\n     def __init__(self):\n+        self._data_file = Path(os.environ.get(\"TASKS_DATA_FILE\", DEFAULT_DATA_FILE))\n         self._tasks: dict[int, Task] = {}\n         self._next_id = 1\n+        self._load()\n+\n+    def _load(self) -> None:\n+        try:\n+            raw = json.loads(self._data_file.read_text())\n+            tasks = [Task(**item) for item in raw]\n+        except Exception:\n+            return\n+        self._tasks = {task.id: task for task in tasks}\n+        self._next_id = max(self._tasks, default=0) + 1\n+\n+    def _save(self) -> None:\n+        self._data_file.parent.mkdir(parents=True, exist_ok=True)\n+        payload = json.dumps([task.model_dump() for task in self.list()])\n+        self._data_file.write_text(payload)\n \n     def list(self) -> list[Task]:\n         return [self._tasks[k] for k in sorted(self._tasks)]\n@@ -22,6 +44,7 @@ class TaskStore:\n         task = Task(id=self._next_id, title=title, priority=priority)\n         self._tasks[task.id] = task\n         self._next_id += 1\n+        self._save()\n         return task\n \n     def get(self, task_id: int) -> Optional[Task]:\n@@ -32,6 +55,7 @@ class TaskStore:\n         if task is None:\n             return None\n         task.done = done\n+        self._save()\n         return task\n \n     def set_priority(self, task_id: int, priority: Priority) -> Optional[Task]:\n@@ -39,6 +63,7 @@ class TaskStore:\n         if task is None:\n             return None\n         task.priority = priority\n+        self._save()\n         return task\n \n     def update_title(self, task_id: int, title: str) -> Optional[Task]:\n@@ -46,14 +71,19 @@ class TaskStore:\n         if task is None:\n             return None\n         task.title = title\n+        self._save()\n         return task\n \n     def delete(self, task_id: int) -> bool:\n-        return self._tasks.pop(task_id, None) is not None\n+        found = self._tasks.pop(task_id, None) is not None\n+        if found:\n+            self._save()\n+        return found\n \n     def reset(self) -> None:\n         self._tasks.clear()\n         self._next_id = 1\n+        self._save()\n \n \n store = TaskStore()\ndiff --git a/backend/tests/conftest.py b/backend/tests/conftest.py\nindex f18a7b7..331dda2 100644\n--- a/backend/tests/conftest.py\n+++ b/backend/tests/conftest.py\n@@ -1,11 +1,18 @@\n import os\n import sys\n+import tempfile\n \n import pytest\n from fastapi.testclient import TestClient\n \n sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))\n \n+# Must happen before `app.main` is imported: that import constructs the\n+# module-level `store` singleton, and its data-file path is fixed at\n+# construction time. Without this, tests would load from and write to the\n+# real data file a locally-running server uses.\n+os.environ[\"TASKS_DATA_FILE\"] = os.path.join(tempfile.mkdtemp(), \"tasks.json\")\n+\n from app.main import app          # noqa: E402\n from app.store import store       # noqa: E402", "meta": {"native_type": "user", "tool_use_id": "toolu_017sg8ny6cdyjDneVPD1U5S2", "session_id": "fe73be77-94e3-47ae-8c3c-b0b404957ede"}}
