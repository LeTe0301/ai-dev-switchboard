# aider (https://aider.chat) — no hosted remote-control link of its own, so
# no URL_REGEX is set below. That's the signal the switchboard uses to fall
# back to its built-in ttyd web terminal automatically: any engine without
# a URL_REGEX gets one for free, no extra config needed.
LABEL=aider
CMD=aider

# To point aider at a local model instead of a hosted one (e.g. an
# OpenAI-API-compatible endpoint like Ollama or LM Studio), change CMD to
# something like:
#   CMD=aider --openai-api-base http://YOUR-LLM-HOST:11434/v1 --model openai/YOUR-MODEL --openai-api-key none
# or point it at a small wrapper script on RUN_USER's PATH that sets those
# flags, and use that script's name as CMD instead.

# HEADLESS_*: one bounded, non-interactive turn (backlog item 6a,
# docs/spec.md), used by app/teams.py's agent_run() -- unrelated to the
# interactive session above, never read by instance_start(). No
# HEADLESS_RESUME line: aider is process-per-turn with no session/resume
# concept at all (docs/story.md §2.1) -- agent_run() raises ValueError
# before spawning anything if a session_id is ever passed for this engine.
# --yes-always avoids interactive confirmation prompts; --message-file
# (HEADLESS_PROMPT=file) is used instead of --message (arg mode) because
# aider has no structured-output stream to bound a prompt-length risk
# against the way the other two engines do. UNVERIFIED -- aider was not
# installed in the environment this sub-spec was built/tested in; believed
# correct per aider's own documented CLI flags as of 2026-08-13, not yet run
# end-to-end. See docs/implementation.md.
HEADLESS_CMD=aider --message-file {prompt_file} --yes-always
HEADLESS_FORMAT=plain
HEADLESS_PROMPT=file
