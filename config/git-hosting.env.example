# Config for scripts/*.sh (git-hosting + project scaffolding). Copy to
# /etc/ai-dev-switchboard/git-hosting.env and edit. Separate from
# switchboard.env because these scripts are useful even on a box that isn't
# running the web UI at all (e.g. a dedicated git-hosting machine).

# Where bare repos live: $GIT_ROOT/repos/<name>.git
GIT_ROOT=/srv/git

# The restricted (git-shell-only) system user that serves them over SSH.
GIT_USER=git

# Must match switchboard.env's RUN_USER/PROJECTS_DIR if this machine also
# runs the web UI — that's what "shows up as a toggleable project" means.
RUN_USER=dev
PROJECTS_DIR=/home/dev/projects

# What to print in the "git remote add" instructions new-repo.sh outputs.
# Defaults to this machine's first detected IP if left unset.
#ADVERTISE_HOST=192.168.1.50

# Deploy key used by auto-deploy hooks (new-repo.sh's optional
# target-ip/target-path form). Generated once by git-hosting-setup.sh.
DEPLOY_KEY=/srv/git/.ssh/deploy_ed25519
