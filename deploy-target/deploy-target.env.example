# Config for deploy-target/*.sh — installed separately from the web UI's own
# switchboard.env because these scripts run ON the target machine, which
# isn't necessarily the same machine the web UI itself runs on (in fact,
# per docs/spec.md, it never is the switchboard box).
# Copy to /etc/ai-dev-switchboard/deploy-target.env on the target machine.

# Destination path this target receives deploys into. deploy-wrapper.sh
# refuses to run rrsync at all unless this is set and starts with "/" —
# never left to fall through to an unrestricted rrsync call.
DEPLOY_PATH=/opt/myapp

# Systemd service name restarted by the "deploy-restart" SSH command.
# Validated against ^[A-Za-z0-9@_.-]+$ by deploy-restart.sh before use.
DEPLOY_SERVICE_NAME=myapp.service
