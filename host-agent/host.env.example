# Config for host-agent/*.sh — installed separately from the web UI's own
# switchboard.env because these scripts run ON the controlled machine,
# which isn't necessarily the same machine the web UI itself runs on.
# Copy to /etc/ai-dev-switchboard/host.env on the controlled machine.

# Name of the persistent tmux session these scripts manage.
HOST_SESSION=ai-dev-switchboard-host

# Working directory the session starts in.
HOST_WORKDIR=/root

# Where status/URL state files are kept.
HOST_STATE_DIR=/var/lib/ai-dev-switchboard

# Same engines.d directory as the web UI's config (copy it here too, or
# point both at a shared path).
ENGINES_DIR=/etc/ai-dev-switchboard/engines.d

# Which engine (a filename stem under ENGINES_DIR, without .engine) this
# host session uses, and what name gets passed to its CMD's {name}
# placeholder (only matters for engines whose CMD uses it, e.g. Claude
# Code's --remote-control label).
HOST_ENGINE=claude
HOST_SESSION_NAME=host

# How long (seconds) to watch a freshly-started session for its startup
# script + hosted URL before giving up.
STARTUP_TIMEOUT_SECONDS=45
